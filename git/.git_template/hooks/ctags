#!/bin/sh
# Rewrites .git/tags from the tracked files. Plain sh: on Debian and Ubuntu
# /bin/sh is dash, which has no [[.
set -e

# Universal Ctags only: macOS ships a BSD ctags at /usr/bin/ctags that knows
# none of the options below.
ctags --version 2>/dev/null | grep -q 'Universal Ctags' || exit 0

dir="$(git rev-parse --git-dir)"
trap 'rm -f "$dir/$$.tags"' EXIT
git ls-files | \
  ctags --tag-relative -L - -f"$dir/$$.tags" --languages=-javascript,sql
mv "$dir/$$.tags" "$dir/tags"
