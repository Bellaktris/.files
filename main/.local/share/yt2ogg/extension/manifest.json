{
    "manifest_version": 3,
    "name": "yt2ogg",
    "version": "2",
    "description": "Saves the YouTube video in this tab to the music library with yt2ogg, after confirming its artist, title and tags.conf fields.",
    "icons": {
        "16": "images/icon16.png",
        "32": "images/icon32.png",
        "48": "images/icon48.png",
        "128": "images/icon128.png"
    },
    "key": "",
    "permissions": [
        "nativeMessaging",
        "activeTab",
        "notifications"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "Save to the music library",
        "default_icon": {
            "16": "images/icon16.png",
            "32": "images/icon32.png"
        },
        "default_popup": "popup.html"
    }
}
