#!/usr/bin/env bash
# yt2ogg — download YouTube audio as .ogg with no recompression.
#
# YouTube serves Opus (format 251) inside a WebM container. Opus is natively an
# Ogg codec, so we remux instead of re-encoding and the audio bitstream is
# copied byte-for-byte. If a video has no Opus stream we bail rather than
# silently transcode.
#
# Artist and title are guessed from the video title, then confirmed one track at
# a time; an edited value lands in both the tags and the filename. Each track
# also gets an R128_TRACK_GAIN so players can level it against the rest.
#
# Usage: ./yt2ogg [-y] <url> [url...]
#        -y                              take the guesses, don't prompt
#        BROWSER=safari ./yt2ogg <url>   # cookie source (default: chrome,
#                                        #   firefox on Linux)
#        OUTDIR=~/Music  ./yt2ogg <url>  # destination  (default: ~/Dropbox/Music)

set -euo pipefail

OUTDIR="${OUTDIR:-${HOME}/Dropbox/Music}"
# Ubuntu's default browser is Firefox, and Chrome's cookies there need the
# GNOME keyring plus secretstorage to decrypt.
if [ "$(uname)" = Darwin ]; then
  BROWSER="${BROWSER:-chrome}"
else
  BROWSER="${BROWSER:-firefox}"
fi

usage() { sed -n '2,17p' "$0" | cut -c3-; }

assume_yes=0
while [ $# -gt 0 ]; do
  case "$1" in
    -y|--yes) assume_yes=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    -*) echo "yt2ogg: unknown option: $1" >&2; exit 1 ;;
    *) break ;;
  esac
done

if [ $# -eq 0 ]; then
  usage
  exit 1
fi

# Prompting needs a controlling terminal; run as if -y when there isn't one.
# Tested in a subshell because a failed exec redirection kills a non-interactive
# shell outright.
if [ "$assume_yes" -eq 0 ] && ! (exec 3</dev/tty) 2>/dev/null; then
  assume_yes=1
fi

# Offer the guess as the default; empty input keeps it. Surrounding whitespace is
# trimmed so it can't leak into a filename.
ask() {
  local prompt="$1" default="$2" reply
  printf '%-6s [%s]: ' "$prompt" "$default" >/dev/tty
  IFS= read -r reply </dev/tty || reply=''
  reply="${reply#"${reply%%[![:space:]]*}"}"
  reply="${reply%"${reply##*[![:space:]]}"}"
  printf '%s' "${reply:-$default}"
}

# The Opus loudness tag, in the fixed-point form the spec actually asks for.
#
# R128_TRACK_GAIN must be an integer of dB x 256 (Q7.8). YouTube's streams
# instead carry a ReplayGain-style string ("-4.9 dB"), which mpd and friends
# cannot parse, and --map_metadata -1 below drops it anyway. So: reuse the
# source's number when there is one, otherwise measure the track; either way
# emit it in the form a player can read.
#
# Absent a source gain, the target is -23 LUFS, the EBU R128 reference the rest
# of the library is already normalised to.
r128_gain() {
  local f="$1" raw db
  raw="$(ffprobe -v error -select_streams a:0 \
    -show_entries stream_tags=R128_TRACK_GAIN -of default=nw=1:nk=1 "$f")"
  raw="${raw%$'\r'}"

  if [[ $raw =~ ^-?[0-9]+$ ]]; then
    printf '%s' "$raw"              # already conformant, keep it verbatim
    return 0
  elif [[ $raw =~ ^(-?[0-9]+(\.[0-9]+)?)[[:space:]]*[dD][bB]$ ]]; then
    db="${BASH_REMATCH[1]}"
  else
    # ebur128 prints its summary even with framelog=quiet.
    db="$(ffmpeg -nostats -hide_banner -i "$f" \
            -af ebur128=framelog=quiet -f null - 2>&1 |
          awk '$1 == "I:" { lufs = $2 } END { if (lufs != "") print -23 - lufs }')"
  fi

  [ -n "$db" ] || return 1
  awk -v d="$db" 'BEGIN { printf "%d", (d < 0 ? -int(-d * 256 + 0.5) : int(d * 256 + 0.5)) }'
}

for bin in yt-dlp ffmpeg ffprobe; do
  command -v "$bin" >/dev/null || { echo "yt2ogg: $bin not found" >&2; exit 1; }
done

mkdir -p "$OUTDIR"

LIST="$(mktemp)"
trap 'rm -f "$LIST"' EXIT

# Trailing "(Lyric Video)", "(Live)", "[HD]" and friends are dropped from the
# track name; a group naming a collaborator is kept. Applied repeatedly so
# stacked suffixes like "Song (To Fall In Love) (Lyric Video)" fully reduce.
STRIP='(?i)\s*[\(\[](?![^)\]]*\b(?:feat|ft|with)\b)[^)\]]*[\)\]]\s*$'

# Cookies are required: without them YouTube's bot check 403s the media URLs
# even though format listing succeeds.
if ! yt-dlp \
  --format 'bestaudio[acodec^=opus]' \
  --cookies-from-browser "$BROWSER" \
  --remux-video ogg \
  --parse-metadata 'title:(?P<artist>.+?) - (?P<track>.+)' \
  --replace-in-metadata track "$STRIP" '' \
  --replace-in-metadata track "$STRIP" '' \
  --replace-in-metadata track "$STRIP" '' \
  --parse-metadata '%(artist,uploader)s:%(meta_artist)s' \
  --parse-metadata '%(track,title)s:%(meta_title)s' \
  --embed-metadata \
  --no-embed-thumbnail \
  --paths "$OUTDIR" \
  --output '%(artist,uploader)s — %(track,title)s.%(ext)s' \
  --print-to-file 'after_move:filepath' "$LIST" \
  "$@"
then
  echo >&2
  echo "yt2ogg: download failed." >&2
  echo "  'Requested format is not available' means the video has no Opus" >&2
  echo "  stream, so a lossless .ogg is impossible — only AAC is offered." >&2
  echo "  HTTP 403 usually means stale cookies: open YouTube in $BROWSER." >&2
  exit 1
fi

# Confirm we really remuxed, then reduce the tags to artist and title.
echo
status=0
while IFS= read -r f; do
  [ -n "$f" ] || continue
  # csv's separator must be a single byte, and ffprobe 9 unescapes the option
  # string itself — so a literal space or an em dash can't be used as one.
  IFS=, read -r codec rate <<<"$(ffprobe -v error -select_streams a:0 \
    -show_entries stream=codec_name,sample_rate -of csv=p=0 "$f")"
  # Queried one at a time: csv emits tags in file order, not the order asked.
  artist=$(ffprobe -v error -select_streams a:0 \
    -show_entries stream_tags=artist -of default=nw=1:nk=1 "$f")
  title=$(ffprobe -v error -select_streams a:0 \
    -show_entries stream_tags=title -of default=nw=1:nk=1 "$f")
  if [ "$codec" = "opus" ]; then
    if [ "$assume_yes" -eq 0 ]; then
      printf '%s\n' "$(basename "$f")" >/dev/tty
      artist="$(ask Artist "$artist")"
      title="$(ask Title "$title")"
    fi
    tags="$artist — $title"
    # --embed-metadata also writes date, purl, genre, language, encoder and the
    # whole video description twice (as synopsis and comment). Drop every tag and
    # put back just these two. -c copy leaves the Opus bitstream byte-identical,
    # so this is a container rewrite, not a transcode; +bitexact suppresses the
    # encoder tag ffmpeg would otherwise add on the way out.
    # Read the gain before the rewrite, which is what discards it. It goes on
    # as stream metadata: ffmpeg overrides a format-level R128_TRACK_GAIN.
    gainopt=()
    if gain="$(r128_gain "$f")" && [ -n "$gain" ]; then
      gainopt=(-metadata:s:a:0 "R128_TRACK_GAIN=$gain")
    else
      printf 'WARN  %s  — no loudness gain could be determined\n' "$(basename "$f")"
      status=1
    fi
    tmp="$(dirname "$f")/.yt2ogg.$$.ogg"
    if ffmpeg -v error -y -i "$f" -map 0:a -c copy -map_metadata -1 \
         -fflags +bitexact -metadata artist="$artist" -metadata title="$title" \
         "${gainopt[@]}" "$tmp" && mv -f "$tmp" "$f"; then
      # Keep the name in step with the tags after an edit. A slash would read as
      # a path separator, so swap in the lookalike yt-dlp itself substitutes.
      base="${tags//\//⧸}.${f##*.}"
      if [ -n "$artist" ] && [ -n "$title" ] && [ "$base" != "$(basename "$f")" ]; then
        want="$(dirname "$f")/$base"
        if [ -e "$want" ]; then
          printf 'WARN  %s exists, left the file named %s\n' \
            "$base" "$(basename "$f")"
          status=1
        elif mv -f "$f" "$want"; then
          f="$want"
        fi
      fi
      printf 'ok    %s  [%s %sHz]  %s\n' "$(basename "$f")" "$codec" "$rate" "$tags"
    else
      rm -f "$tmp"
      printf 'WARN  %s  — tag strip failed, metadata left as-is\n' "$(basename "$f")"
      status=1
    fi
  else
    printf 'WARN  %s  [%s] — not opus, audio was re-encoded\n' "$(basename "$f")" "$codec"
    status=1
  fi
  # Fill in genre, mood and language from tags.conf, if it has anything to say
  # about this artist or song. Failure is not fatal: the download is fine, the
  # tags can be applied later with `mpcc-tag`.
  if command -v mpcc-tag >/dev/null 2>&1; then
    mpcc-tag "$f" | sed -n '/^ /s/^ */      /p' || true
  fi

  # Match the rest of the library, which is executable. Has to come after the
  # mv above, or it would be undone by the temp file's umask-derived mode.
  chmod 755 "$f"
done < "$LIST"

exit $status
