#!/bin/bash
# vpnchain - toggle a chained proxy setup on macOS.
#
#   browser, launched by 'vpnchain browser'
#     -> --proxy-server, pinned to that launch only
#        -> sing-box: userspace WireGuard endpoint (no tun, no root)
#           -> detour via an upstream SOCKS proxy
#              -> upstream transport
#                 -> WireGuard peer, which is the visible exit address
#
# Everything site-specific lives in $XDG_CONFIG_HOME/vpnchain/env, which is
# deliberately outside this repo. See the template printed by this script when
# that file is missing.
#
#   start [mode]    load the sing-box agent
#   stop            unload it
#   restart [mode]  reload it
#   status          show every link in the chain and what the outside sees
#
# The optional [mode] on start/restart is one of:
#
#   chained  the WireGuard endpoint dials through the upstream SOCKS proxy, so
#            only ordinary TLS leaves the machine and the tunnel survives
#            censorship. Carries UDP over TCP.
#   direct   the endpoint dials its peer itself. Fewer moving parts, but
#            plainly a VPN on the wire and dead where UDP or VPNs are filtered.
#
# Latency is identical between them - same peer, same ocean crossing, both
# measured ~1.8x the bare connection. Throughput was too noisy across repeated
# runs to call a winner; the medians favoured chained but the ranges overlap.
# Choose on concealment, not speed. Use 'bench' with a raised BENCH_RUNS if
# you want a defensible answer on your own link.
#
# Omit it to keep whatever the config already has. status reports the active
# mode, so there is no separate command to query it.
#
#   bench    measure throughput layer by layer: no proxy, upstream only, and
#            the full chain. Every listener involved is already running, so
#            nothing is switched or restarted and this is safe to run while
#            browsing. Override with BENCH_URL / BENCH_BYTES / BENCH_RUNS.
#   browser [incognito|with-webrtc]
#            quit and relaunch the browser from this shell with SPOOF_TZ and
#            the WebRTC policy applied. Both are read only at startup, which
#            is why this is a restart - closing windows is not enough.
#
#            incognito opens a SEPARATE incognito instance pointed at the
#            inbound that bypasses the WireGuard
#            endpoint - so it changes TWO things at once: nothing persists,
#            AND it exits at the upstream instead of the pinned address. It coexists with the main browser; a browser can only
#            hold one proxy, so a second exit means a second instance. That
#            exit is a shared datacenter address flagged as a proxy by IP
#            databases, so expect CAPTCHAs - the trade is that the session is
#            not linked to the pinned address.
#
#            A SOCKS proxy cannot carry UDP, so WebRTC would otherwise reach
#            the network directly and expose the real address regardless of
#            everything else here. The default launch prevents that.
#
#            Pass with-webrtc to relax the policy for the launch; block is
#            restored on disk immediately afterwards. The running browser
#            already read the relaxed value and keeps it until it quits, so
#            the exposure is scoped to that session and the next launch is
#            protected again - no timer, nothing to remember. Use it when a
#            call needs to connect.
#
#   config   write the sing-box config from the env file, which is the single
#            source of truth for it. start does this automatically when no
#            config exists, since writing a missing file cannot lose anything.
#            Regenerating an existing one can - hand-added routing rules are
#            not carried over - so that stays explicit. status compares the
#            live config against what the env file describes and says so when
#            they diverge, which is the case the split would otherwise hide.
#
# NOTE: the proxy is pinned per browser launch rather than set system-wide.
# The scope is therefore exactly the browsers this script starts - nothing
# else on the machine is touched, and stopping the agent cannot strand macOS
# pointing at a dead port.
#
# The trade is that this fails OPEN, not safe: a browser started from the Dock
# or Spotlight carries no proxy flag and browses on your real address. Nothing
# prevents that; status reports it, which is detection rather than prevention.

set -uo pipefail

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/vpnchain/env"

# What `vpnchain browser` launched the browser with. macOS hides other
# processes' environments, so the running browser's timezone cannot be read
# back - the alternative would be a remote-debugging port, which lets any
# local process drive the browser. Recording provenance instead keeps that
# attack surface closed, at the cost of only knowing about browsers this
# script started.
STATE="${CONFIG%/env}/browser.state"

if [ ! -r "$CONFIG" ]; then
    cat >&2 <<EOF
vpnchain: missing config at $CONFIG

Create it with your site-local values:

    PROXY_HOST=127.0.0.1
    PROXY_PORT=1080
    UPSTREAM_HOST=127.0.0.1
    UPSTREAM_PORT=<port of the upstream SOCKS proxy>
    UPSTREAM_PROCESS=<process name of the upstream proxy core>
    EXPECTED_EXIT_IP=<the address the chain should present>
    SINGBOX_AGENT=<launchd label of your sing-box agent>

Optional:

    SPOOF_TZ=<tz database zone the browser should report, e.g. America/Denver>
             match it to the exit address's geolocation; applied only by
             'vpnchain browser'
    INCOGNITO_PORT=<sing-box inbound that bypasses the WireGuard endpoint,
             default 1081; must exist in SINGBOX_CONFIG>
    INCOGNITO_TZ=<timezone for that instance, default UTC>
    INCOGNITO_PROFILE=<its throwaway profile dir>
    BROWSER_APP=<path to the browser bundle, defaults to Google Chrome>
    BROWSER_DOMAIN=<its preference domain, for the WebRTC policy>
EOF
    exit 1
fi

# shellcheck source=/dev/null
. "$CONFIG"

for var in PROXY_HOST PROXY_PORT UPSTREAM_HOST UPSTREAM_PORT UPSTREAM_PROCESS \
           EXPECTED_EXIT_IP SINGBOX_AGENT; do
    if [ -z "${!var:-}" ]; then
        echo "vpnchain: $var is not set in $CONFIG" >&2
        exit 1
    fi
done

PLIST="$HOME/Library/LaunchAgents/$SINGBOX_AGENT.plist"

# Chromium-family preference domain whose WebRTC policy we toggle.
# Override in the env file for Brave, Edge, Chromium, etc.
BROWSER_DOMAIN="${BROWSER_DOMAIN:-com.google.Chrome}"

# Chrome renamed this policy; write and read both so either vintage works.
WEBRTC_KEYS=(WebRtcIPHandlingPolicy WebRtcIPHandling)
WEBRTC_BLOCK_VALUE=disable_non_proxied_udp

BROWSER_APP="${BROWSER_APP:-/Applications/Google Chrome.app}"
BROWSER_BIN="$BROWSER_APP/Contents/MacOS/$(basename "${BROWSER_APP%.app}")"

# Timezone the browser should report. The browser has no timezone setting and
# delegates to the OS, but it honours TZ, which takes effect before ICU
# initialises - so main thread, iframes and Web Workers all agree. Only the
# zone interpretation changes; the clock itself stays correct, leaving TLS
# validity, JWT expiry and TOTP alone.
#
# This must be a launch from a shell. Wrapping it in a .app bundle was tried
# and produced a correct spoof but markedly slower page loads; the bundle
# launch context, not TZ, was responsible. `launchctl setenv` does not reach
# LaunchServices-launched apps at all. Both paths are disproven - do not
# reintroduce them.
SPOOF_TZ="${SPOOF_TZ:-}"

# Second sing-box inbound, routed straight to the upstream so it bypasses the
# WireGuard endpoint. Same daemon, no reconfiguration - picking an exit is just
# picking a port, and both can be in use at once.
INCOGNITO_PORT="${INCOGNITO_PORT:-1081}"

# That exit is a shared datacenter address, so UTC is the better timezone for
# it: it is what Tor Browser and Firefox resistFingerprinting report, which
# puts the instance in a large set rather than making it distinctive.
INCOGNITO_TZ="${INCOGNITO_TZ:-UTC}"

# Only needed to force a SEPARATE browser process, which is what lets this
# instance hold a different proxy. The session itself runs --incognito, so no
# browsing data lands here and the directory needs no maintenance.
INCOGNITO_PROFILE="${INCOGNITO_PROFILE:-$HOME/.cache/vpnchain-upstream-profile}"

SINGBOX_CONFIG="${SINGBOX_CONFIG:-$HOME/.config/sing-box/config.json}"

# Tag of the sing-box outbound pointing at the upstream proxy. This is what
# gets written back as the endpoint's "detour" when re-enabling chained mode,
# so it must match the tag actually used in SINGBOX_CONFIG. Override in the
# env file if yours differs.
UPSTREAM_TAG="${UPSTREAM_TAG:-upstream}"

# Range-request a prefix of a large file rather than downloading something
# whole, so the sample size is controlled. Keep it big enough that TCP slow
# start and tunnel ramp-up do not dominate - at 2 MB the ramp swamps the
# steady-state rate and every mode looks equally slow.
BENCH_URL="${BENCH_URL:-https://ash-speed.hetzner.com/100MB.bin}"
BENCH_BYTES="${BENCH_BYTES:-5000000}"
BENCH_RUNS="${BENCH_RUNS:-2}"

# The only difference between the modes in the config is whether the WireGuard
# endpoint carries a "detour" key.
singbox_mode() {
    python3 - "$SINGBOX_CONFIG" <<'PY' 2>/dev/null || echo unknown
import json, sys
try:
    c = json.load(open(sys.argv[1]))
except Exception:
    print("unknown"); raise SystemExit
eps = c.get("endpoints") or []
wg = next((e for e in eps if e.get("type") == "wireguard"), None)
if wg is None:
    print("unknown")
else:
    print("chained" if wg.get("detour") else "direct")
PY
}

bold() { printf '\033[1m%s\033[0m\n' "$1"; }
ok()   { printf '  \033[32m[ok]\033[0m   %s\n' "$1"; }
warn() { printf '  \033[33m[warn]\033[0m %s\n' "$1"; }
bad()  { printf '  \033[31m[bad]\033[0m  %s\n' "$1"; }


agent_running() { pgrep -f 'sing-box run' >/dev/null 2>&1; }

cmd_start() {
    # Bootstrap only. Writing a config that does not exist cannot discard
    # anything, so it is safe to do implicitly; regenerating one that does
    # exist can, which is why that stays behind an explicit verb.
    if [ ! -f "$SINGBOX_CONFIG" ]; then
        if have_wg_creds; then
            warn "no config at $SINGBOX_CONFIG - generating one"
            cmd_config
        else
            bad "no config at $SINGBOX_CONFIG, and the env file lacks the"
            bad "WireGuard values needed to generate one"
            exit 1
        fi
    fi

    if agent_running; then
        ok "sing-box already running"
        return
    fi
    launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null \
        || launchctl load -w "$PLIST" 2>/dev/null
    sleep 2
    if agent_running; then
        ok "sing-box started"
    else
        bad "sing-box failed to start - check its stderr log"
    fi
}

cmd_stop() {
    launchctl bootout "gui/$(id -u)/$SINGBOX_AGENT" 2>/dev/null \
        || launchctl unload -w "$PLIST" 2>/dev/null
    ok "sing-box stopped"
}

# "blocked" if either policy key pins non-proxied UDP off, else "allowed".
webrtc_state() {
    local k v
    for k in "${WEBRTC_KEYS[@]}"; do
        v=$(defaults read "$BROWSER_DOMAIN" "$k" 2>/dev/null)
        [ "$v" = "$WEBRTC_BLOCK_VALUE" ] && { echo blocked; return; }
    done
    echo allowed
}

set_webrtc() {
    local k
    if [ "$1" = block ]; then
        for k in "${WEBRTC_KEYS[@]}"; do
            defaults write "$BROWSER_DOMAIN" "$k" -string "$WEBRTC_BLOCK_VALUE"
        done
    else
        # Delete rather than writing "default": a mandatory policy also
        # overrides extension-set privacy settings, so leaving one in place
        # would silently defeat any extension-based control later.
        for k in "${WEBRTC_KEYS[@]}"; do
            defaults delete "$BROWSER_DOMAIN" "$k" 2>/dev/null
        done
    fi
}

# Match the binary path specifically. A looser pattern also matches the
# osascript quit command and this script's own arguments, which would make the
# quit-wait loop below never finish.
browser_running() { pgrep -f "$BROWSER_BIN" >/dev/null 2>&1; }

# The tunnel needs time to hand shake after the agent restarts, and until it
# does, everything through the proxy fails. A fixed sleep either wastes time or
# lies, so poll until traffic actually flows.
wait_for_chain() {
    local i=0
    while [ "$i" -lt 12 ]; do
        if curl -s -m 4 --socks5-hostname "$PROXY_HOST:$PROXY_PORT" \
                -o /dev/null https://api.ipify.org 2>/dev/null; then
            ok "tunnel is carrying traffic"
            return 0
        fi
        sleep 2
        i=$((i + 1))
    done
    bad "tunnel is up but not carrying traffic after ~25s"
    echo "         check: tail ~/.config/sing-box/sing-box.err.log"
    return 1
}

# Switch the config between chained and direct. Returns 0 if it changed.
# Does not restart on its own; callers that already restart handle that.
switch_mode() {
    local want="$1" cur
    cur=$(singbox_mode)

    case "$want" in
        chained|direct) ;;
        *) echo "vpnchain: unknown mode '$want' (expected chained or direct)" >&2
           exit 1 ;;
    esac
    if [ "$cur" = unknown ]; then
        bad "could not read a wireguard endpoint from $SINGBOX_CONFIG"
        exit 1
    fi
    if [ "$cur" = "$want" ]; then
        ok "already in $want mode"
        return 1
    fi

    # Edit in place rather than keeping two config files, so the keys and the
    # peer cannot drift apart between them.
    python3 - "$SINGBOX_CONFIG" "$want" "$UPSTREAM_TAG" <<'PY' || exit 1
import json, shutil, sys
path, want, tag = sys.argv[1], sys.argv[2], sys.argv[3]
c = json.load(open(path))
wg = next(e for e in c["endpoints"] if e.get("type") == "wireguard")
if want == "chained":
    wg["detour"] = tag
else:
    wg.pop("detour", None)
shutil.copy2(path, path + ".bak")
with open(path, "w") as f:
    json.dump(c, f, indent=2)
    f.write("\n")
PY

    if ! sing-box check -c "$SINGBOX_CONFIG" 2>/dev/null; then
        bad "edited config failed validation - restoring"
        mv "$SINGBOX_CONFIG.bak" "$SINGBOX_CONFIG"
        exit 1
    fi
    rm -f "$SINGBOX_CONFIG.bak"
    ok "config switched to $want mode"

    if [ "$want" = direct ]; then
        warn "the tunnel is now plainly a VPN on the wire: UDP straight to the"
        warn "peer address, with none of the upstream's cover traffic"
        warn "it will also fail outright on networks that block UDP or VPNs"
    fi
    return 0
}

# Optional [chained|direct] argument on the lifecycle verbs. A mode change
# needs the agent reloaded, so if it is already running, restart it here -
# otherwise cmd_start would see a live agent and leave the old config loaded.
maybe_switch_mode() {
    [ -z "${1:-}" ] && return 0
    if switch_mode "$1" && agent_running; then
        launchctl kickstart -k "gui/$(id -u)/$SINGBOX_AGENT" 2>/dev/null \
            || { cmd_stop >/dev/null 2>&1; cmd_start >/dev/null 2>&1; }
        ok "sing-box reloaded for the new mode"
    fi
}

# One timed transfer through a given layer. Every listener involved is already
# running, so nothing has to be reconfigured or restarted to measure them.
bench_one() {
    case "$1" in
        chain)    curl -s -m 120 --socks5-hostname "$PROXY_HOST:$PROXY_PORT" \
                       -o /dev/null -r "0-$BENCH_BYTES" -w '%{speed_download}' \
                       "$BENCH_URL" 2>/dev/null ;;
        upstream) curl -s -m 120 --socks5-hostname "$UPSTREAM_HOST:$UPSTREAM_PORT" \
                       -o /dev/null -r "0-$BENCH_BYTES" -w '%{speed_download}' \
                       "$BENCH_URL" 2>/dev/null ;;
        bare)     curl -s -m 120 -o /dev/null -r "0-$BENCH_BYTES" \
                       -w '%{speed_download}' "$BENCH_URL" 2>/dev/null ;;
    esac
}

bench_row() {
    local label="$1" kind="$2" i v
    printf '  %-12s' "$label"
    for ((i = 0; i < BENCH_RUNS; i++)); do
        v=$(bench_one "$kind")
        if [ -z "$v" ] || [ "${v%%.*}" -lt 1000 ] 2>/dev/null; then
            printf ' %12s' "failed"
        else
            printf ' %8s MB/s' "$(awk -v b="$v" 'BEGIN{printf "%.2f", b/1000000}')"
        fi
    done
    echo
}

# Measures the layers as they already exist. Nothing is switched, restarted or
# restored, so this is safe to run mid-session - including while browsing.
cmd_bench() {
    bold "throughput  ($((BENCH_BYTES / 1000000)) MB prefix, $BENCH_RUNS runs)"
    echo "  target: $BENCH_URL"
    echo "  the full chain is currently in $(singbox_mode) mode"
    echo
    bench_row "no proxy"   bare
    bench_row "upstream"   upstream
    bench_row "full chain" chain
    echo
    echo "  no proxy   your connection, for scale"
    echo "  upstream   through the upstream proxy only, no WireGuard - so the"
    echo "             gap to 'no proxy' is what the upstream hop costs"
    echo "  full chain upstream plus the WireGuard endpoint, which is what the"
    echo "             browser actually uses"
    echo
    echo "  runs vary a lot - a single slow one usually means the far end"
    echo "  throttled a repeated range request, not that the layer is slow."
    echo "  Compare the consistent runs, or raise BENCH_RUNS."
    echo
    echo "  to compare modes, switch explicitly and re-run:"
    echo "    vpnchain restart direct && vpnchain bench"
}

# Any failure after the backup is taken must put the old config back, or a
# half-written one is left in place for the next start to trip over.
restore_config_backup() {
    if [ -f "$SINGBOX_CONFIG.bak" ]; then
        mv "$SINGBOX_CONFIG.bak" "$SINGBOX_CONFIG"
        warn "previous config restored"
    fi
}

# Writes a known-good config from the env file. Deliberately a separate verb
# rather than something start does implicitly: regenerating wholesale discards
# any routing rules added by hand, which should be a decision rather than a
# surprise. Runtime toggles stay surgical for the same reason.
cmd_config() {
    local v missing=()
    for v in WG_PRIVATE_KEY WG_ADDRESS WG_PEER_PUBLIC_KEY WG_PEER_HOST WG_PEER_PORT; do
        [ -z "${!v:-}" ] && missing+=("$v")
    done
    if [ "${#missing[@]}" -gt 0 ]; then
        bad "cannot generate - missing in $CONFIG:"
        printf '         %s\n' "${missing[@]}"
        exit 1
    fi

    # Preserve whichever mode is already in effect; generating should not
    # silently move you between concealment postures.
    local mode
    mode=$(singbox_mode)
    [ "$mode" = unknown ] && mode=chained
    ok "generating a $mode config"

    mkdir -p "$(dirname "$SINGBOX_CONFIG")"
    if [ -f "$SINGBOX_CONFIG" ]; then
        cp -p "$SINGBOX_CONFIG" "$SINGBOX_CONFIG.bak"
        ok "previous config saved as $(basename "$SINGBOX_CONFIG").bak"
        warn "hand-added routing rules are NOT carried over; merge them back"
        warn "from the backup if you had any"
    fi

    generate_config "$SINGBOX_CONFIG" "$mode" || {
        restore_config_backup; bad "generation failed"; exit 1; }

    if ! sing-box check -c "$SINGBOX_CONFIG" 2>&1; then
        bad "generated config failed validation"
        restore_config_backup
        exit 1
    fi
    ok "config written and valid: $SINGBOX_CONFIG"
    # Only worth saying when something is already running the old one; during
    # bootstrap the caller starts the agent immediately after this.
    agent_running && echo "         apply it with: vpnchain restart"
}

# Renders the config implied by the env file to $1. Kept separate from
# cmd_config so status can render to a temp file and compare, which is how
# drift between the env file and the live config gets noticed.
generate_config() {
    local out="$1" mode="$2"
    MODE="$mode" P_HOST="$PROXY_HOST" P_PORT="$PROXY_PORT" \
    U_PORT="$INCOGNITO_PORT" UP_HOST="$UPSTREAM_HOST" \
    UP_PORT="$UPSTREAM_PORT" UP_TAG="$UPSTREAM_TAG" \
    WG_MTU="${WG_MTU:-1390}" WG_DNS="${WG_DNS:-8.8.8.8}" \
    WG_PRIVATE_KEY="$WG_PRIVATE_KEY" WG_ADDRESS="$WG_ADDRESS" \
    WG_PEER_PUBLIC_KEY="$WG_PEER_PUBLIC_KEY" \
    WG_PEER_HOST="$WG_PEER_HOST" WG_PEER_PORT="$WG_PEER_PORT" \
    OUT="$out" \
    python3 - <<'PY' || { restore_config_backup; bad "generation failed"; exit 1; }
import json, os
e = os.environ

wg = {
    "type": "wireguard", "tag": "tunnel", "system": False,
    "mtu": int(e["WG_MTU"]),
    "address": [e["WG_ADDRESS"]],
    "private_key": e["WG_PRIVATE_KEY"],
    "peers": [{
        "address": e["WG_PEER_HOST"],
        "port": int(e["WG_PEER_PORT"]),
        "public_key": e["WG_PEER_PUBLIC_KEY"],
        "allowed_ips": ["0.0.0.0/0"],
        "persistent_keepalive_interval": 25,
    }],
}
if e["MODE"] == "chained":
    wg["detour"] = e["UP_TAG"]

cfg = {
    "log": {"level": "info", "timestamp": True},
    # Names for the incognito inbound resolve through the upstream too.
    # Resolving them through the tunnel would have the site see one origin
    # while its authoritative DNS saw another.
    "dns": {
        "servers": [
            {"type": "udp", "tag": "tunnel-dns",
             "server": e["WG_DNS"], "detour": "tunnel"},
            {"type": "udp", "tag": "upstream-dns",
             "server": e["WG_DNS"], "detour": e["UP_TAG"]},
        ],
        "rules": [{"inbound": ["upstream-in"], "server": "upstream-dns"}],
        "final": "tunnel-dns",
        "strategy": "ipv4_only",
    },
    "inbounds": [
        {"type": "mixed", "tag": "pinned-in",
         "listen": e["P_HOST"], "listen_port": int(e["P_PORT"])},
        {"type": "mixed", "tag": "upstream-in",
         "listen": e["P_HOST"], "listen_port": int(e["U_PORT"])},
    ],
    "endpoints": [wg],
    "outbounds": [
        {"type": "socks", "tag": e["UP_TAG"], "server": e["UP_HOST"],
         "server_port": int(e["UP_PORT"]), "version": "5"},
    ],
    "route": {
        "rules": [{"inbound": ["upstream-in"], "action": "route",
                   "outbound": e["UP_TAG"]}],
        "final": "tunnel",
    },
}

out = e["OUT"]
with open(out, "w") as f:
    json.dump(cfg, f, indent=2)
    f.write("\n")
os.chmod(out, 0o600)   # it holds the private key
PY
}

# true when every value the generator needs is present
have_wg_creds() {
    local v
    for v in WG_PRIVATE_KEY WG_ADDRESS WG_PEER_PUBLIC_KEY WG_PEER_HOST WG_PEER_PORT; do
        [ -z "${!v:-}" ] && return 1
    done
    return 0
}

cmd_browser() {
    # Flags name what you opt INTO, so the bare command cannot accidentally
    # mean "expose my real address" or "use the unlinked exit".
    local want=block exit_kind=pinned already_up=0 a
    for a in "$@"; do
        case "$a" in
            "")             ;;
            with-webrtc)    want=allow ;;
            incognito)  exit_kind=upstream ;;
            *) echo "usage: vpnchain browser [incognito|with-webrtc]" >&2
               exit 1 ;;
        esac
    done

    # Refused rather than merely warned about: an unlinked session that is
    # allowed to use non-proxied UDP leaks the real address into exactly the
    # session whose whole purpose is not carrying it.
    if [ "$exit_kind" = upstream ] && [ "$want" = allow ]; then
        bad "incognito and with-webrtc are mutually exclusive"
        echo "         WebRTC would expose your real address inside the"
        echo "         session that exists specifically to avoid that"
        exit 1
    fi

    if [ ! -x "$BROWSER_BIN" ]; then
        bad "browser binary not found: $BROWSER_BIN"
        exit 1
    fi

    local port tz profile_args=()
    if [ "$exit_kind" = upstream ]; then
        # Bypasses the WireGuard endpoint entirely, so this exits at the
        # upstream rather than the pinned address. A browser can only hold one
        # proxy, so this has to be a SEPARATE instance with its own profile -
        # it coexists with the main one rather than replacing it.
        port="$INCOGNITO_PORT"
        tz="$INCOGNITO_TZ"
        # --incognito does the cleanup for us: nothing is persisted, so the
        # profile dir needs no wiping. --user-data-dir is still required -
        # without it --incognito just opens a window in the EXISTING browser,
        # which carries the main instance's proxy rather than this one.
        profile_args=(--user-data-dir="$INCOGNITO_PROFILE" --incognito
                      --no-first-run --no-default-browser-check)
        # Remember whether one was already up: a second launch hands off to
        # it and this invocation's flags are silently discarded.
        pgrep -f "$INCOGNITO_PROFILE" >/dev/null 2>&1 && already_up=1
        ok "separate incognito instance (nothing persisted)"
        warn "this exit is flagged as a proxy by IP databases - expect CAPTCHAs"
    else
        port="$PROXY_PORT"
        tz="$SPOOF_TZ"
        if browser_running; then
            ok "asking the browser to quit (it will restore your session)"
            osascript -e "quit app \"$(basename "${BROWSER_APP%.app}")\"" >/dev/null 2>&1
            local i=0
            while browser_running && [ "$i" -lt 60 ]; do
                sleep 0.25
                i=$((i + 1))
            done
            if browser_running; then
                bad "browser is still running - it may be holding an unsaved prompt"
                bad "launching now would just hand off to the existing process and"
                bad "change nothing, so stopping here. Quit it manually and retry."
                exit 1
            fi
            ok "browser quit"
        else
            ok "browser was not running"
        fi
    fi

    # The policy is read at startup, so it has to be in place before launching.
    # It is global to the preference domain, so it also governs the separate
    # instance - which is why it is set here either way.
    set_webrtc "$want"
    [ "$want" = block ] && ok "webrtc policy set to block" \
                        || warn "webrtc policy relaxed for this launch"

    # The proxy is pinned to this launch rather than set system-wide, so the
    # scope is exactly this browser and nothing else on the machine is touched.
    # Chrome still hands over hostnames rather than pre-resolving, so remote
    # DNS - and therefore no DNS leak - is preserved.
    local bpid
    local proxy_flag="--proxy-server=socks5://$PROXY_HOST:$port"
    ok "proxy pinned to this launch: $PROXY_HOST:$port"
    if [ -n "$tz" ]; then
        ok "launching with TZ=$tz"
        TZ="$tz" nohup "$BROWSER_BIN" "$proxy_flag" "${profile_args[@]}" >/dev/null 2>&1 &
    else
        warn "no timezone configured - launching with the system timezone"
        nohup "$BROWSER_BIN" "$proxy_flag" "${profile_args[@]}" >/dev/null 2>&1 &
    fi
    bpid=$!
    disown 2>/dev/null
    sleep 3

    if [ "$exit_kind" = upstream ]; then
        # Deliberately not recorded in STATE: that tracks the main browser, and
        # overwriting it would make status report the throwaway instance as if
        # it were your everyday one.
        # Not the launcher pid: if an instance with this profile is already
        # running, the launch hands off to it and the launcher exits at once,
        # which would read as a failure. Ask whether the instance exists.
        if ! pgrep -f "$INCOGNITO_PROFILE" >/dev/null 2>&1; then
            bad "incognito instance did not come up"
        elif [ "$already_up" = 1 ]; then
            warn "an instance was ALREADY running - this launch handed off to it"
            warn "and its flags were discarded. The proxy and timezone in effect"
            warn "are whatever that instance started with, not what is printed"
            warn "above. Quit it first if you changed INCOGNITO_PORT or _TZ."
        else
            ok "incognito instance running (pid $(pgrep -f "$INCOGNITO_PROFILE" | head -1))"
        fi
    elif browser_running; then
        ok "browser started (pid $bpid)"
        # Record what this launch applied, so status can tell a browser we
        # configured from one started some other way - and so the on-disk
        # policy being restored below does not make status lie about what
        # the running browser is actually doing.
        printf 'PID=%s
TZ=%s
WEBRTC=%s
' "$bpid" "$tz" \
            "$([ "$want" = block ] && echo blocked || echo allowed)" > "$STATE"
    else
        bad "browser did not come up"
        rm -f "$STATE"
    fi

    # Put the protective policy back immediately. The running browser already
    # read the relaxed one and keeps it for its lifetime, so the exposure is
    # scoped to this session and the next launch is protected by default -
    # no timer, nothing to remember.
    if [ "$want" = allow ]; then
        set_webrtc block
        echo
        warn "on-disk policy restored to block"
        warn "THIS browser keeps direct UDP until you quit it - any page in it"
        warn "can read your real address. The next launch is protected again."
        echo "         caveat: if the browser re-reads policy mid-session it"
        echo "         may pick up the restored block and drop WebRTC."
    fi

    echo
    bold "applied at this launch"
    [ "$exit_kind" = upstream ] && warn "exit: upstream only - NOT the pinned address" \
                                || ok "exit: the pinned address"
    if [ "$want" = block ]; then
        ok "webrtc: BLOCKED"
    else
        bad "webrtc: ALLOWED - real address exposed to any page in this browser"
    fi
    if [ -n "$tz" ]; then
        ok "timezone: $tz"
        echo "         verify in the console:"
        echo "         Intl.DateTimeFormat().resolvedOptions().timeZone"
    else
        warn "timezone: system default"
    fi
}


cmd_status() {
    local mode
    mode=$(singbox_mode)
    bold "chain components  [mode: $mode]"

    if [ "$mode" = direct ]; then
        warn "upstream hop DISABLED - WireGuard dials its peer directly"
        echo "         plainly a VPN on the wire - no concealment, and no"
        echo "         measured speed advantage over chained either"
        echo "         this persists across reboots until changed back"
        echo "         restore with: vpnchain restart chained"
    else
        if pgrep -f "$UPSTREAM_PROCESS" >/dev/null 2>&1; then
            local pid started
            pid=$(pgrep -f "$UPSTREAM_PROCESS" | head -1)
            started=$(ps -o lstart= -p "$pid" 2>/dev/null | sed 's/  */ /g')
            ok "upstream core running (pid $pid, up since$started)"
            echo "         a changed pid means it restarted - node switch or reboot"
        else
            bad "upstream core NOT running - nothing downstream can work"
        fi

        nc -z -G 2 "$UPSTREAM_HOST" "$UPSTREAM_PORT" >/dev/null 2>&1 \
            && ok "upstream SOCKS listening on $UPSTREAM_PORT" \
            || bad "upstream SOCKS $UPSTREAM_PORT not accepting connections"
    fi

    agent_running \
        && ok "sing-box running (pid $(pgrep -f 'sing-box run' | head -1))" \
        || bad "sing-box NOT running - run: vpnchain start"

    nc -z -G 2 "$PROXY_HOST" "$PROXY_PORT" >/dev/null 2>&1 \
        && ok "sing-box $PROXY_PORT listening (pinned exit)" \
        || bad "sing-box $PROXY_PORT not accepting connections"

    # Optional: a config predating 'vpnchain config' has only the one inbound,
    # so a missing second port is a gap to fill rather than a fault.
    if nc -z -G 2 "$PROXY_HOST" "$INCOGNITO_PORT" >/dev/null 2>&1; then
        ok "sing-box $INCOGNITO_PORT listening (incognito exit)"
    else
        warn "sing-box $INCOGNITO_PORT not listening"
        echo "         'browser incognito' needs it; add it with: vpnchain config"
    fi

    if have_wg_creds; then
        local tmpcfg
        tmpcfg=$(mktemp -t vpnchain-cfg)
        if generate_config "$tmpcfg" "$mode" 2>/dev/null \
           && ! diff -q "$tmpcfg" "$SINGBOX_CONFIG" >/dev/null 2>&1; then
            warn "live config differs from what the env file describes"
            echo "         either it was hand-edited, or the env file changed"
            echo "         since it was generated. Regenerate with:"
            echo "           vpnchain config   (backs the current one up first)"
        fi
        rm -f "$tmpcfg"
    fi

    echo
    bold "system proxy"
    local enabled
    enabled=$(scutil --proxy | awk '/SOCKSEnable/ {print $3}')
    if [ "${enabled:-0}" = "1" ]; then
        warn "SET -> $(scutil --proxy | awk '/SOCKSProxy/ {print $3}'):$(scutil --proxy | awk '/SOCKSPort/ {print $3}')"
        echo "         this script no longer manages it; the proxy is pinned"
        echo "         per browser launch. A leftover system setting silently"
        echo "         routes Safari, Mail and others through the chain too."
        echo "         clear it in System Settings > Network > Proxies"
    else
        ok "not set - only browsers launched by vpnchain are proxied"
    fi

    echo
    bold "browser - configured"
    local cur_webrtc
    cur_webrtc=$(webrtc_state)
    if [ "$cur_webrtc" = blocked ]; then
        ok "webrtc: BLOCKED from non-proxied UDP"
    else
        bad "webrtc: ALLOWED direct UDP - your real address is exposed"
        echo "         a SOCKS proxy cannot carry UDP, so this bypasses the"
        echo "         chain entirely. run: vpnchain browser"
    fi
    [ -n "$SPOOF_TZ" ] && ok "timezone: $SPOOF_TZ" \
                       || warn "timezone: no spoof configured (SPOOF_TZ unset)"

    echo
    bold "browser - running"
    local s_pid s_tz s_webrtc
    s_pid=""; s_tz=""; s_webrtc=""
    if [ -r "$STATE" ]; then
        s_pid=$(sed -n 's/^PID=//p'    "$STATE")
        s_tz=$(sed -n  's/^TZ=//p'     "$STATE")
        s_webrtc=$(sed -n 's/^WEBRTC=//p' "$STATE")
    fi

    # A recorded pid is only meaningful if it is still alive AND still the
    # browser - pids get recycled.
    if [ -n "$s_pid" ] && kill -0 "$s_pid" 2>/dev/null \
       && ps -p "$s_pid" -o command= 2>/dev/null | grep -qF "$BROWSER_BIN"; then
        ok "started by vpnchain (pid $s_pid)"

        if [ "$s_tz" = "$SPOOF_TZ" ]; then
            [ -n "$s_tz" ] && ok "timezone in effect: $s_tz" \
                           || warn "timezone in effect: system default"
        else
            bad "timezone in effect: ${s_tz:-system default}, config now ${SPOOF_TZ:-unset}"
            echo "         restart to apply: vpnchain browser"
        fi

        if [ "$s_webrtc" = "$cur_webrtc" ]; then
            ok "webrtc in effect: $s_webrtc"
        else
            bad "webrtc in effect: $s_webrtc, config now $cur_webrtc"
            echo "         policies are read at startup only"
            echo "         restart to apply: vpnchain browser"
        fi
    elif browser_running; then
        bad "browser is running but was NOT started by vpnchain"
        echo "         the timezone spoof is not applied, and the webrtc"
        echo "         policy may predate your last change"
        echo "         run: vpnchain browser"
    else
        warn "browser not running"
    fi

    echo
    bold "what the outside world sees"
    local direct chain
    direct=$(curl -s -m 10 https://api.ipify.org 2>/dev/null)
    chain=$(curl -s -m 25 --retry 2 --retry-delay 3 \
        --socks5-hostname "$PROXY_HOST:$PROXY_PORT" https://api.ipify.org 2>/dev/null)

    printf '  %-26s %s\n' "direct (your ISP):" "${direct:-unreachable}"
    printf '  %-26s %s\n' "pinned exit:" "${chain:-unreachable}"
    if nc -z -G 2 "$PROXY_HOST" "$INCOGNITO_PORT" >/dev/null 2>&1; then
        local incog
        incog=$(curl -s -m 25 --socks5-hostname "$PROXY_HOST:$INCOGNITO_PORT" \
                https://api.ipify.org 2>/dev/null)
        printf '  %-26s %s\n' "incognito exit:" "${incog:-unreachable}"
    fi

    echo
    if [ "$chain" = "$EXPECTED_EXIT_IP" ]; then
        ok "chain is intact - exiting at the expected address"
    elif [ -z "$chain" ]; then
        bad "chain is down - run: vpnchain off   to restore normal browsing"
    else
        bad "WRONG EXIT IP: $chain (expected $EXPECTED_EXIT_IP)"
        echo "         traffic reached the upstream proxy but skipped the"
        echo "         WireGuard layer - check sing-box's detour setting"
    fi
}

case "${1:-status}" in
    start)   maybe_switch_mode "${2:-}"; cmd_start; wait_for_chain ;;
    stop)    cmd_stop ;;
             # switch_mode, not maybe_switch_mode: this verb restarts the agent
             # itself, so reloading inside the switch would do it twice.
    restart) if [ -n "${2:-}" ]; then switch_mode "$2" || true; fi
             cmd_stop; cmd_start; echo; wait_for_chain ;;
    status)  cmd_status ;;
    browser) shift; cmd_browser "$@" ;;
    config)  cmd_config ;;
    bench)   cmd_bench ;;
    *)
        echo "usage: vpnchain {start|restart} [chained|direct]"
        echo "       vpnchain {stop|status|bench}"
        echo "       vpnchain browser [incognito|with-webrtc]"
        echo "       vpnchain config"
        exit 1
        ;;
esac
