#!/bin/bash
# vpnchain - toggle a chained proxy setup on macOS or Linux.
#
#   browser, launched by 'vpnchain browser'
#     -> proxy pinned to that launch alone: a command-line flag for the
#        pinned browser, a profile pref for the incognito one
#        -> sing-box: userspace WireGuard endpoint (no tun, no root)
#           -> detour via an upstream SOCKS proxy
#              -> upstream transport
#                 -> WireGuard peer, which is the visible exit address
#
# Names the ordinary network cannot reach go elsewhere entirely: with
# TOR_PORT set, .onion is handed to a local Tor rather than resolved, and
# with I2P_PORT set, .i2p is handed to a local i2pd. Both are route rules in
# the generated config, ahead of the per-inbound rule, so both browsers get
# them and neither suffix can ever reach a resolver. Onion traffic does not
# enter the WireGuard tunnel at all, so the exit address is not involved.
#
# Where those daemons dial from is their own business and not this script's:
# routing Tor through the upstream was tried and does not survive - see the
# record in the torrc - so it dials out directly, which its own ISP can see.
#
# BitTorrent is refused on the pinned inbound: the pinned address is the one
# that identifies you, so torrents belong on the upstream exits only. A client
# pointed at the wrong port is turned away rather than trusted to be right.
#
# Everything site-specific lives in $XDG_CONFIG_HOME/vpnchain/env, which is
# deliberately outside this repo. See the template printed by this script when
# that file is missing.
#
#   start [mode]    load the sing-box agent
#   stop            unload it
#   restart [mode]  unload and load it again, pilot and status server too
#   reload          regenerate the config and restart sing-box alone, for
#                   applying an edit; the pilot keeps running
#
# The optional [mode] on start/restart is one of:
#
#   chained  the WireGuard endpoint dials through the upstream SOCKS proxy, so
#            only ordinary TLS leaves the machine and the tunnel survives
#            censorship. Carries UDP over TCP. With a subscription, through
#            the provider's CDN nodes - those whose names ECH hides while any
#            of them answers, the others only when none does.
#   direct   the endpoint dials its peer itself. Fewer moving parts, but
#            plainly a VPN on the wire and dead where UDP or VPNs are filtered.
#   chained-reality
#            with a subscription only: chained, but through the Reality
#            node(s) only, for networks that block or throttle CDNs, DoH and
#            ECH - Russia, China, Iran. Reality's visible server name is a
#            real site's and the node is dialled by stored address, so
#            neither the name nor DNS gives it away. The shared port goes
#            through it too, but BitTorrent is refused: dozens of busy
#            connections to one server is how such networks find Reality
#            servers. The incognito browser uses the subscription's Reality
#            nodes only, never one of your own, whose address is yours alone.
#            The pilot moves between the Reality nodes every 20-60 minutes,
#            yours among them, so that no one address carries the whole day;
#            ROTATE_MINUTES sets the range, or turns it off.
#
# Neither chained mode falls back on the other's nodes: when every node of
# the mode fails, the pilot says so and leaves the choice of switching to
# you. What the mode says is what goes on the wire - and the Reality node,
# unused at home, is still unknown when it is needed.
#
# Latency is identical between them - same peer, same ocean crossing, both
# measured ~1.8x the bare connection. Throughput measurements were too noisy
# across repeated runs to call a winner, which is why the benchmark that
# produced them was removed rather than kept and distrusted. Choose on
# concealment, not speed.
#
# Omit it to keep whatever the config already has; the dashboard reports the
# active mode, so there is no separate command to query it.
#
#   browser [with-webrtc] [with-cookies]
#            quit and relaunch the PINNED browser from this shell with
#            SPOOF_TZ and the WebRTC policy applied. Both are read only at
#            startup, which is why this is a restart - closing windows is not
#            enough.
#
#            It applies a set of static hardening policies borrowed from
#            Safari and Firefox: WebUSB, Web Bluetooth, Web Serial and WebHID
#            denied (neither browser ever shipped them), HTTPS-only mode on,
#            and vendor telemetry reduced - URL-keyed collection and metrics
#            off, Safe Browsing at Standard rather than Enhanced so visited
#            URLs are not sent for real-time checking. Notification prompts
#            are blocked except for NOTIFY_ALLOW. Background mode is off so
#            closing the last window really quits - this one is load-bearing,
#            since every policy is read at startup and a browser that will
#            not reliably quit cannot be relaunched to apply them. Downloads
#            prompt for a location rather than landing silently.
#
#            These are never relaxed, so unlike the two below there is
#            nothing to restore.
#
#            It also disables incognito HERE. An incognito window in this
#            browser clears cookies and history but keeps the pinned exit
#            address - the one thing that actually identifies you - so it
#            looks anonymous while being nothing of the sort. The unlinked
#            exit is a separate browser, below, not a window in this one.
#
#            Third-party cookies are blocked by default too - they are the
#            cross-site join key, and the browser does not block them on its
#            own since that phase-out was reversed. with-cookies relaxes that
#            for one launch and restores blocking straight afterwards, for the
#            embedded sign-in and payment flows that need them.
#
#            Pass with-webrtc to relax the policy for the launch; block is
#            restored on disk immediately afterwards. The running browser
#            already read the relaxed value and keeps it until it quits, so
#            the exposure is scoped to that session and the next launch is
#            protected again - no timer, nothing to remember. Use it when a
#            call needs to connect.
#
#   browser incognito
#            launch Mullvad Browser against the inbound that bypasses the
#            WireGuard endpoint, so the session exits at the upstream instead
#            of the pinned address. It coexists with the pinned browser: a
#            browser holds one proxy, so a second exit means a second
#            browser. That exit is a shared datacenter address flagged as a
#            proxy by IP databases, so expect CAPTCHAs - the trade is that
#            the session is not linked to the pinned address.
#
#            'upstream' is accepted as a synonym, that being what the exit
#            is. The name 'incognito' belongs to this verb and to the
#            INCOGNITO_* settings, NOT to Chrome's mode of the same name -
#            that mode is disabled in the pinned browser and is no longer
#            used anywhere. What it used to provide here, a session that
#            persists nothing, is now the wiped profile below.
#
#            A different browser rather than a second Chrome profile, because
#            the two sessions want different things. The pinned one wants a
#            stable identity and working pages. This one wants to be
#            indistinguishable from other people's sessions, and no amount of
#            policy gives Chrome that: denying APIs one at a time lowers
#            entropy per row while RAISING joint uniqueness, since stock
#            Chrome answers those calls and this one does not - the denial is
#            itself the distinguishing bit. Mullvad Browser is Firefox with
#            the Tor uplift (resistFingerprinting, letterboxing, a font
#            allowlist, canvas readback behind a prompt) and without Tor,
#            built to sit behind someone else's VPN, which is what this chain
#            is. The goal is a shared fingerprint, not a rare one.
#
#            Tor Browser would be the wrong pick here: Tor over this chain is
#            slow, and the exit address stops being the chain's, which is the
#            address the dashboard's #expect= check is about.
#
#            Nothing global is touched for this launch. Firefox has no proxy
#            flag, so the proxy goes in prefs and the prefs go in a throwaway
#            profile. No preference domain is written, no policy is relaxed
#            and restored, nothing has to be put back, and the pinned
#            browser's settings are left exactly as they were.
#
#            Nothing survives the session. The browser is in permanent
#            private browsing - its own default, not something set here - so
#            little reaches the disk in the first place, and the profile is
#            wiped both before the launch and when the browser quits, so
#            between sessions there is nothing there to find. The fingerprint
#            is therefore the stock one every time, and nothing from the last
#            session can link to this one. Within a session it all persists
#            normally, which is what makes extensions and logins work.
#
#            WebRTC rides the proxy instead of being switched off.
#            media.peerconnection.ice.proxy_only gathers ICE candidates only
#            through the SOCKS inbound, so the real address is never offered
#            as one. SOCKS carries no UDP, so peer-to-peer media still cannot
#            work: calls connect where TURN over TCP is offered and fail
#            where it is not. There is nothing to relax, so with-webrtc does
#            not apply to this verb.
#
#            ONLY the proxy prefs are written. Every pref beyond them moves
#            this instance off the shared fingerprint and towards a unique
#            one, which is the opposite of the point - so the flags this
#            instance used to carry are deliberately not ported:
#
#              --disable-webgl and --disable-reading-from-canvas measured
#              9.29 and 8.87 bits on Cover Your Tracks, the two largest
#              removable rows in Chrome. resistFingerprinting covers the same
#              ground - canvas readback prompts, WebGL is normalised - as a
#              default shared with every other user of this browser rather
#              than as a deviation from one.
#
#            What those flags were measured against is worth keeping, since it
#            is the case for this browser and against any further flags:
#
#              Every combination tested in Chrome left the JOINT fingerprint
#              unique, or within a couple of browsers of it, in a corpus of
#              406,000. Per-row bits kept improving while the join stayed
#              solvable, so blending in was never actually on offer there.
#
#              The canvas hash measured IDENTICAL in the pinned and unlinked
#              instances - it is a property of the GPU and installed fonts,
#              not of the profile - so it linked the two personas straight
#              through a different exit, a different timezone, forced
#              incognito and blocked third-party cookies. It was the
#              strongest join key between them, which is why it was worth
#              denying even at the cost of looking stranger.
#
#              It was not the only one. Screen 1512x982x30, 10 cores, 16 GB,
#              MacIntel, the 27-font list, the AudioContext value
#              (124.0434748024636, 1 in 38.6) and the user agent were also
#              identical in both, and no Chrome flag touches any of them.
#              Breaking that needs an engine that standardises or randomises
#              per site, which is the whole reason this instance is no longer
#              Chrome.
#
#              And the rule the Chrome setup kept relearning: altering a
#              value only helps if the new value is commoner than the old
#              one, and for anything tied to this hardware it usually is not.
#              --disable-accelerated-2d-canvas took the canvas row from 9.49
#              bits to 11.34 - the rarest value in the report - because
#              almost nobody on macOS rasterises in software. Denials are
#              safe; substitutions are a bet. A browser whose defaults are
#              everyone else's is neither.
#
#              INCOGNITO_TZ and INCOGNITO_TZ_FOLLOW_EXIT are inert here:
#              resistFingerprinting reports a fixed zone whatever TZ the
#              process was launched with - measured as Atlantic/Reykjavik,
#              UTC+0 without the tell of literally saying UTC - in the main
#              thread, a Worker and an iframe alike. The zone is no longer
#              ours to choose, and the dashboard's clock-vs-exit row will
#              therefore always disagree with wherever the upstream landed:
#              that warning is expected here, not a fault. The
#              old logic derived it from the exit at launch because UTC
#              measured 6.78 bits - one browser in 110 - against a populous
#              real zone's 3.85. That was measured in Chrome, where UTC was
#              an outlier WITHIN the configuration; here it is the population
#              default, so the finding does not carry over. Do not
#              reintroduce TZ handling for this instance: it cannot work.
#
#   i2p [start|stop|status]
#            run i2pd for as long as you want .i2p names, and no longer. It
#            is a verb rather than an agent because an I2P router is not a
#            client: it joins the network, carries other people's traffic by
#            default and costs bandwidth around the clock. Against that, it
#            is useless for the first several minutes after starting, since
#            it has to find peers and build tunnels - so this cannot be made
#            on-demand in the way Tor can, and starting it is something you
#            do before you need it.
#
#            Its own config is $XDG_CONFIG_HOME/i2pd/i2pd.conf, outside this
#            repo with the rest of the site-local files. Transit, bandwidth
#            and which transport it dials over are set there, not here.
#
#            Refused in chained-reality mode, and stopped on switching to
#            it: a router keeps connections to dozens of others, which over
#            the shared port means dozens through the one Reality server -
#            the same pattern that has torrents refused there.
#
#   config gen|check
#            'config gen' writes the sing-box config from the env file, the single
#            source of truth for it. start does this automatically when no
#            config exists, since writing a missing file cannot lose anything.
#            Regenerating an existing one can - hand-added routing rules are
#            not carried over - so that stays explicit.
#
#            'config check' compares the live config against what the env file
#            describes without writing anything. It is the one check the status
#            server does not do, since a second copy of the generator there
#            would be two things to hold in sync.
#
#   get-blocklist
#            fetch the domain lists and address ranges of KEEP_OUT_COUNTRIES
#            into KEEP_OUT_DIR, each smoke-tested before it replaces the
#            installed copy - see KEEP_OUT_COUNTRIES on why the pinned browser
#            refuses those countries' sites. Then
#            fetch the tracker lists named by BLOCKLIST_URL, convert them to a
#            sing-box rule-set and install it at BLOCKLIST_PATH. Rejection then
#            happens INSIDE the chain rather than in the browser, which is the
#            whole point: it sits below the JS layer, so it covers Web Workers,
#            service workers, prefetches and beacons uniformly, applies to both
#            inbounds at once, and adds no extension for a page to detect.
#
#            An extension cannot match that. Content scripts cannot be injected
#            into worker scope at all, so anything they hide on the main thread
#            a worker still sees - which turns the measure into a signal. The
#            network layer has no such split.
#
#            Several URLs may be given, space-separated; AdGuard's DNS filter
#            format is line-based, so they are concatenated before conversion
#            and the result is the union. The default pairing was chosen by
#            measurement, not reputation - see the env file template.
#
#            The converted set is smoke-tested before it is installed: a few
#            known trackers must match and a few domains that must keep working
#            must not. A list that fails is discarded rather than installed,
#            since a rule-set that blocks sign-in would be discovered as
#            mysterious breakage long after the fetch that caused it.
#
#            Blocking is engaged only when the file exists AND BLOCKLIST_URL is
#            set; sing-box refuses to start on a missing local rule-set path, so
#            'vpnchain config gen' is safe to run before the first fetch.
#
#            Unlike an extension this has no per-site off switch - rejection is
#            all or nothing. Blocked ads do, however, leave their bait elements
#            visible, so the common anti-adblock test of measuring a decoy div's
#            height sees nothing amiss; what a page can observe is that a
#            request failed, which is indistinguishable from a firewall or a
#            dead ad server. Unattributable, not undetectable.
#
#   setup
#            one-time preparation. First the env file: setup asks for every
#            value it lacks that has no default right for anyone - the
#            subscription or upstream proxy, the WireGuard credentials (or a
#            .conf to import them from), the exit address - offers the
#            optional EXIT_REGION and SPOOF_TZ, and writes the agent names
#            and local proxy address without asking. Values already there are
#            never asked for or changed. On Linux, Chrome reads policies only from
#            /etc/opt/chrome/policies/managed, so this creates vpnchain.json
#            there with sudo and makes it yours; no other verb ever needs
#            root. It also writes the sing-box user unit if there is none.
#            On macOS there is nothing to do.
#
#   ssh-reality [own-node] [ssh arguments]
#            a shell on one of your own nodes (the first, unless one is named
#            by tag), carried inside its Reality inbound to the node's own
#            sshd on loopback - so port 22 can stay closed to the world, and
#            administering the node looks like using it. ssh_user (default
#            root) and ssh_key in OWN_NODES_FILE say how to log in.
#            Restarting sing-box on the node ends the session carrying it;
#            reconnect, or give the restart to systemd-run to finish alone.
#            With sing-box down for good, the provider's console is the way in.
#
# There is no 'status' verb. The dashboard is the status view - it reports the
# chain AND what the browser actually does, which no shell command can see. In
# a terminal, curl the server directly:
#
#     curl -s http://127.0.0.1:$STATUS_PORT/status.json
#
# NOTE: the proxy is pinned per browser launch rather than set system-wide.
# The scope is therefore exactly the browsers this script starts - nothing
# else on the machine is touched, and stopping the agent cannot strand macOS
# pointing at a dead port.
#
# The trade is that this fails OPEN, not safe: a browser started from the Dock
# or Spotlight carries no proxy flag and browses on your real address. Nothing
# prevents that.
#
# Browser-side facts are NOT reported here. The shell cannot see them: macOS
# hides other processes' environments, so the timezone a running browser was
# launched with is unreadable, and no process inspection reveals whether
# WebRTC is actually leaking. vpnchain-dashboard.html, alongside this script,
# measures all of it from inside the browser - open it as a plain file in the
# browser you want to inspect:
#
#     file://<this directory>/vpnchain-dashboard.html#expect=<exit address>
#
# The incognito instance exits elsewhere by design, and that address rotates
# with the upstream node, so it is not something a fragment could pin: the
# status server measures it and the page labels the exit rather than calling
# it wrong. Which means that instance wants the SERVED page, not the file -
# 'browser incognito' sets it as the startup page for exactly that reason.
#
# What that instance is checked against is REAL_ADDRESS: not the pinned
# address and not the real one is the whole requirement, and which node of
# the upstream it came out at does not matter. Without it the page falls back
# to comparing networks, which is wrong as soon as the exits span more than
# one. The file:// form takes it as &real=<address>.
#
# Worth setting as the browser's startup page. Then any launch, including one
# from the Dock that carries no proxy flag, shows you immediately whether you
# are on the expected address - which restores passive detection in the only
# place that can actually observe it.

set -uo pipefail

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/vpnchain/env"

# 'vpnchain setup' fills in what the env file lacks, before anything reads it,
# so it also works where there is no env file yet. It asks only for what has
# no value that would be right for anyone - the way out, the WireGuard
# credentials, the address the chain should present - and writes the names
# that do have one (the agents, the local proxy) without asking, saying so.
# Everything else stays optional and is described in the template below.
env_put() {     # VAR VALUE: appended to the env file, and set for this run
    printf '%s=%q\n' "$1" "$2" >> "$CONFIG"
    printf -v "$1" '%s' "$2"
    env_added=$((env_added + 1))
}
env_default() { # VAR VALUE: written without asking, if missing
    [ -n "${!1:-}" ] && return 0
    env_put "$1" "$2"
    printf '  %s=%s (default)\n' "$1" "$2" >&2
}
env_ask() {     # VAR PROMPT [hidden] [suggestion]: asked for, if missing
    local val
    [ -n "${!1:-}" ] && return 0
    if [ ! -t 0 ]; then
        echo "vpnchain setup: $1 is missing - run setup in a terminal to be asked" >&2
        env_missing=1
        return 1
    fi
    printf '%s%s: ' "$2" "${4:+ [$4]}" >&2
    if [ "${3:-}" = hidden ]; then read -rs val; echo >&2; else read -r val; fi
    val=${val:-${4:-}}
    [ -n "$val" ] || return 1
    env_put "$1" "$val"
}

env_optional() { # VAR PROMPT: env_ask, remembering a skip
    [ -n "${!1:-}" ] && return 0
    grep -q "^#$1=" "$CONFIG" 2>/dev/null && return 0
    # Without a terminal there is no one to skip it.
    [ -t 0 ] || return 0
    env_ask "$1" "$2" || printf '#%s=\n' "$1" >> "$CONFIG"
}

# A WireGuard .conf, as the provider hands it out, into the WG_* values.
wg_import() {
    local f=$1 addr ep
    [ -r "$f" ] || { echo "  cannot read $f" >&2; return 1; }
    # Everything after the first '=': keys are base64 and end in one.
    wg_field() { awk -v k="$1" '{
        key = substr($0, 1, index($0, "=") - 1); gsub(/[ \t]/, "", key)
        if (index($0, "=") && tolower(key) == tolower(k)) {
            v = substr($0, index($0, "=") + 1); gsub(/^[ \t]+|[ \t\r]+$/, "", v)
            print v; exit
        } }' "$f"; }
    addr=$(wg_field Address | tr ',' '\n' | tr -d ' ' | grep -m1 '\.')
    [ -n "$addr" ] && [ "${addr#*/}" = "$addr" ] && addr="$addr/32"
    ep=$(wg_field Endpoint)
    [ -n "$(wg_field PrivateKey)" ] && [ -n "$addr" ] && [ -n "$(wg_field PublicKey)" ] && [ -n "$ep" ] || {
        echo "  $f lacks PrivateKey, Address, PublicKey or Endpoint" >&2; return 1; }
    [ -n "${WG_PRIVATE_KEY:-}" ] || env_put WG_PRIVATE_KEY "$(wg_field PrivateKey)"
    [ -n "${WG_ADDRESS:-}" ] || env_put WG_ADDRESS "$addr"
    [ -n "${WG_PEER_PUBLIC_KEY:-}" ] || env_put WG_PEER_PUBLIC_KEY "$(wg_field PublicKey)"
    [ -n "${WG_PEER_HOST:-}" ] || env_put WG_PEER_HOST "${ep%:*}"
    [ -n "${WG_PEER_PORT:-}" ] || env_put WG_PEER_PORT "${ep##*:}"
    [ -n "$(wg_field MTU)" ] && [ -z "${WG_MTU:-}" ] && env_put WG_MTU "$(wg_field MTU)"
    echo "  imported the WireGuard values from $f" >&2
}

setup_env() {
    mkdir -p "$(dirname "$CONFIG")" && ( umask 077 && touch "$CONFIG" ) || return 1
    # shellcheck source=/dev/null
    . "$CONFIG"
    env_added=0 env_missing=0
    local me prefix wg_missing=0 v conf
    me=$(id -un)
    case "$(uname -s)" in (Darwin) prefix="com.$me." ;; (*) prefix="vpnchain-" ;; esac

    # The way out: the provider's subscription, or a proxy run by something else.
    if [ -z "${SUBSCRIPTION_URL:-}" ] && [ -z "${UPSTREAM_PORT:-}" ]; then
        if ! env_ask SUBSCRIPTION_URL "Subscription URL (hidden; Enter if an upstream proxy is used instead)" hidden \
                && [ -t 0 ]; then
            env_default UPSTREAM_HOST 127.0.0.1
            env_ask UPSTREAM_PORT "Port of the upstream SOCKS proxy"
            env_ask UPSTREAM_PROCESS "Process name of the upstream proxy core"
        fi
    fi

    # The WireGuard exit: from the provider's .conf when there is one.
    for v in WG_PRIVATE_KEY WG_ADDRESS WG_PEER_PUBLIC_KEY WG_PEER_HOST WG_PEER_PORT; do
        [ -z "${!v:-}" ] && wg_missing=1
    done
    if [ $wg_missing = 1 ]; then
        if [ -t 0 ]; then
            printf 'WireGuard config file to import (Enter to type the values): ' >&2
            read -r conf
            [ -n "$conf" ] && wg_import "${conf/#\~/$HOME}"
        fi
        env_ask WG_PRIVATE_KEY "WireGuard private key (hidden)" hidden
        env_ask WG_ADDRESS "WireGuard address, e.g. 10.0.0.2/32"
        env_ask WG_PEER_PUBLIC_KEY "WireGuard peer public key"
        env_ask WG_PEER_HOST "WireGuard peer host"
        env_ask WG_PEER_PORT "WireGuard peer port"
    fi

    # The peer's address is usually the exit's own, for a dedicated address.
    case "${WG_PEER_HOST:-}" in
        (*[!0-9.]*|"") env_ask EXPECTED_EXIT_IP "Address the chain should present" ;;
        (*) env_ask EXPECTED_EXIT_IP "Address the chain should present" "" "$WG_PEER_HOST" ;;
    esac

    # Optional, and worth having. Enter skips, and a skip is written down as a
    # commented-out line - asked once, not at every setup, and the place to
    # fill it in later.
    env_optional EXIT_REGION "City of the WireGuard peer, for the pilot's choice of nodes (Enter skips)"
    env_optional SPOOF_TZ "Time zone the browser should report, e.g. America/Denver (Enter skips)"

    env_default PROXY_HOST 127.0.0.1
    env_default PROXY_PORT 1080
    env_default SINGBOX_AGENT "${prefix}singbox"
    env_default STATUSD_AGENT "${prefix}vpnchain-statusd"
    [ -n "${SUBSCRIPTION_URL:-}" ] && env_default PILOT_AGENT "${prefix}vpnchain-pilot"

    if [ "$env_added" -gt 0 ]; then
        echo "  $env_added value(s) written to $CONFIG" >&2
    elif [ "$env_missing" = 0 ]; then
        echo "  $CONFIG has every value setup asks for" >&2
    fi
    [ "$env_missing" = 0 ]
}
[ "${1:-}" = setup ] && { setup_env || exit 1; }

if [ ! -r "$CONFIG" ]; then
    cat >&2 <<EOF
vpnchain: missing config at $CONFIG

Run 'vpnchain setup' to be asked for the values below, or create it with
your site-local values:

    PROXY_HOST=127.0.0.1
    PROXY_PORT=1080
    EXPECTED_EXIT_IP=<the address the chain should present>
    SINGBOX_AGENT=<launchd label (macOS) or systemd user unit name (Linux)
             of the sing-box agent; written for you if it does not exist>

the WireGuard exit (setup imports them from the provider's .conf file):

    WG_PRIVATE_KEY=<the interface's private key>
    WG_ADDRESS=<the interface's address, with its prefix, e.g. 10.0.0.2/32>
    WG_PEER_PUBLIC_KEY=<the peer's public key>
    WG_PEER_HOST=<the peer's address>
    WG_PEER_PORT=<the peer's port>

and either the provider's subscription, which sing-box then dials itself:

    SUBSCRIPTION_URL='<v2ray-style subscription link; holds a token>'

or, without one, an upstream SOCKS proxy run by something else:

    UPSTREAM_HOST=127.0.0.1
    UPSTREAM_PORT=<port of the upstream SOCKS proxy>
    UPSTREAM_PROCESS=<process name of the upstream proxy core>

Optional:

    SHARED_PORT=<with a subscription: SOCKS/HTTP port onto the provider's
             nodes for other programs (torrent client, i2pd), default 20170>
    PILOT_AGENT=<launchd label or unit name of vpnchain-pilot, which picks
             the node; unset leaves the selection to you>
    EXIT_REGION=<city of the WireGuard peer, e.g. Frankfurt; the pilot prefers
             nodes near it>
    NODE_DNS=<DoH servers, by IP, that resolve node names, in order of
             preference; default "1.1.1.1 8.8.8.8 9.9.9.9". The system
             resolver is the last resort after them>

    SPOOF_TZ=<tz database zone the browser should report, e.g. America/Denver>
             match it to the exit address's geolocation; applied only by
             'vpnchain browser'
    INCOGNITO_PORT=<sing-box inbound that bypasses the WireGuard endpoint,
             default 1081; must exist in SINGBOX_CONFIG>
    REAL_ADDRESS=auto (the default), a fixed address, or "off"
             The address this machine presents with no proxy, which is how
             the dashboard names the one failure it otherwise cannot see: a
             browser with no proxy in effect. Measured at each launch unless
             pinned here, since a written-down one goes stale; "off" skips
             the measurement and the check with it.
    TOR_PORT=<Tor's SOCKS port, usually 9050. Set it and .onion names are
             routed there instead of resolving. Tor itself dials out
             directly, so your ISP can see that you use it; Socks5Proxy
             through the upstream does not survive, and a bridge (obfs4,
             snowflake) is the route if that matters - see the header>
    I2P_PORT=<i2pd's SOCKS port, usually 4447, for .i2p names. Note that an
             I2P router carries other people's traffic by default; see
             notransit and share in i2pd.conf>
    INCOGNITO_SEARCH=<default search engine for it: google, duckduckgo,
             startpage, brave or mojeek. Unset leaves the browser's own
             choice. Needs App Management permission, since the policy that
             sets it lives inside the application bundle>
    INCOGNITO_PROFILE=<throwaway profile dir for the incognito browser>
    INCOGNITO_APP=<bundle of the incognito browser, defaults to
             Mullvad Browser>
    INCOGNITO_BIN=<Linux: its executable, defaults to mullvad-browser>
    BROWSER_APP=<bundle of the pinned browser, defaults to Google Chrome>
    BROWSER_BIN=<Linux: its executable, defaults to google-chrome>
    BROWSER_PROC=<pgrep -f pattern for its main process>
    BROWSER_DOMAIN=<macOS: its preference domain, for the policies>
    BROWSER_POLICY_FILE=<Linux: the policy file, defaults to
             /etc/opt/chrome/policies/managed/vpnchain.json; create it with
             'vpnchain setup'>
    KEEP_OUT_COUNTRIES=<countries whose sites the pinned browser refuses,
             so they get a separate unproxied browser; default "ru cn ir",
             empty turns it off. Lists come with 'vpnchain get-blocklist'>
    ROTATE_MINUTES=<chained-reality only: minutes on one Reality node before
             the pilot moves to another, as a range drawn from afresh each
             time; default "20-60", "off" to stay put>
    NOTIFY_ALLOW=<space-separated origins allowed to show notifications,
             e.g. "https://mail.example.com https://chat.example.com";
             everything else is blocked>
EOF
    exit 1
fi

# shellcheck source=/dev/null
. "$CONFIG"

# Native mode: sing-box speaks to the provider's nodes itself, from a
# subscription, instead of detouring through a separate proxy core on
# UPSTREAM_PORT. Setting SUBSCRIPTION_URL is what selects it, so going back is
# a matter of commenting one line out and regenerating.
SUBSCRIPTION_URL="${SUBSCRIPTION_URL:-}"
native() { [ -n "$SUBSCRIPTION_URL" ]; }

required=(PROXY_HOST PROXY_PORT EXPECTED_EXIT_IP SINGBOX_AGENT)
native || required+=(UPSTREAM_HOST UPSTREAM_PORT UPSTREAM_PROCESS)
for var in "${required[@]}"; do
    if [ -z "${!var:-}" ]; then
        echo "vpnchain: $var is not set in $CONFIG" >&2
        exit 1
    fi
done

# --- platform ----------------------------------------------------------------
#
# Everything that differs between macOS and Linux sits behind the functions in
# this block, so the verbs below read the same on both:
#
#   agents    launchd agents in ~/Library/LaunchAgents, or systemd user units
#             in ~/.config/systemd/user, both logging to plain files so the
#             trimming and the status server's log reading work unchanged
#   policies  the pinned browser's per-user preference domain (defaults), or
#             on Linux one JSON file in Chrome's managed policy directory.
#             That directory is root-owned and read only from there, so
#             'vpnchain setup' creates the file once with sudo and hands it to
#             you - after which every launch rewrites it without sudo, exactly
#             as defaults does on macOS. It does apply to every user's Chrome
#             on the machine, which on a one-person laptop is the same thing.
#   browsers  .app bundles, or executables on PATH
case "$(uname -s)" in
    (Darwin) OS=mac ;;
    (Linux)  OS=linux ;;
    (*) echo "vpnchain: unsupported platform $(uname -s)" >&2; exit 1 ;;
esac

if [ "$OS" = mac ]; then
    agent_file() { printf '%s\n' "$HOME/Library/LaunchAgents/$1.plist"; }
else
    agent_file() { printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$1.service"; }
fi

# agent_start LABEL FILE / agent_stop LABEL FILE / agent_restart LABEL FILE
agent_start() {
    if [ "$OS" = mac ]; then
        launchctl bootstrap "gui/$(id -u)" "$2" 2>/dev/null \
            || launchctl load -w "$2" 2>/dev/null
    else
        systemctl --user daemon-reload 2>/dev/null
        systemctl --user start "$1" 2>/dev/null
    fi
}
agent_stop() {
    if [ "$OS" = mac ]; then
        launchctl bootout "gui/$(id -u)/$1" 2>/dev/null \
            || launchctl unload -w "$2" 2>/dev/null
    else
        systemctl --user stop "$1" 2>/dev/null
    fi
}
agent_restart() {
    if [ "$OS" = mac ]; then
        launchctl kickstart -k "gui/$(id -u)/$1" 2>/dev/null
    else
        systemctl --user restart "$1" 2>/dev/null
    fi
}

# The log files an agent writes, one per line. Read from the agent's own file
# rather than guessed, so this follows the agents if their logs ever move.
agent_logs() {
    [ -f "$1" ] || return 0
    if [ "$OS" = mac ]; then
        local key
        for key in StandardOutPath StandardErrorPath; do
            /usr/libexec/PlistBuddy -c "Print :$key" "$1" 2>/dev/null
        done
    else
        sed -n -e 's/^StandardOutput=append://p' \
               -e 's/^StandardError=append://p' "$1"
    fi
}

# write_agent LABEL FILE OUT_LOG ERR_LOG COMMAND...
# Written only when missing: it carries absolute paths for this machine, and
# writing a file that does not exist cannot lose anything - the same reasoning
# as generating a missing config.
write_agent() {
    local label="$1" file="$2" out="$3" err="$4" a
    shift 4
    [ -f "$file" ] && return 0
    mkdir -p "$(dirname "$file")" "$(dirname "$out")" "$(dirname "$err")"
    if [ "$OS" = mac ]; then
        {
            cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>$label</string>
    <key>ProgramArguments</key>
    <array>
PLIST
            for a in "$@"; do printf '        <string>%s</string>\n' "$a"; done
            cat <<PLIST
    </array>
    <key>EnvironmentVariables</key>
    <dict><key>STATUS_PORT</key><string>$STATUS_PORT</string></dict>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>$out</string>
    <key>StandardErrorPath</key><string>$err</string>
    <key>ProcessType</key><string>Background</string>
</dict>
</plist>
PLIST
        } > "$file"
    else
        # systemd splits ExecStart on spaces, so each argument is quoted.
        local cmd=
        for a in "$@"; do cmd="$cmd \"$a\""; done
        cat > "$file" <<UNIT
[Unit]
Description=$label (vpnchain)

[Service]
ExecStart=${cmd# }
Environment=STATUS_PORT=$STATUS_PORT
Restart=always
RestartSec=2
StandardOutput=append:$out
StandardError=append:$err

[Install]
WantedBy=default.target
UNIT
    fi
    ok "wrote $file"
}

# BSD and GNU stat disagree on every flag; wc does not.
file_size() { wc -c < "$1" 2>/dev/null | tr -d ' '; }
# GNU mktemp wants the X's that BSD's -t supplies itself.
temp_file() { mktemp "${TMPDIR:-/tmp}/$1.XXXXXX"; }
temp_dir()  { mktemp -d "${TMPDIR:-/tmp}/$1.XXXXXX"; }

# Policies. pol_set KEY int|bool|string|array VALUE...; pol_del KEY;
# pol_get KEY prints the value as defaults would (bools as 1/0).
if [ "$OS" = mac ]; then
    pol_set() {
        local k="$1" t="$2"
        shift 2
        defaults write "$BROWSER_DOMAIN" "$k" "-$t" "$@"
    }
    pol_del() { defaults delete "$BROWSER_DOMAIN" "$1" 2>/dev/null; }
    pol_get() { defaults read "$BROWSER_DOMAIN" "$1" 2>/dev/null; }
    policy_ready() { return 0; }
else
    # Written in place rather than replaced: the directory is root's, so a
    # temporary file beside it cannot be created - only this one is ours.
    pol_json() {
        python3 - "$BROWSER_POLICY_FILE" "$@" <<'PY'
import json, sys
path, op, key, *rest = sys.argv[1:]
try:
    with open(path) as f:
        data = json.load(f)
except (OSError, ValueError):
    data = {}
if op == "get":
    v = data.get(key)
    if v is None:
        sys.exit(1)
    print(int(v) if isinstance(v, bool) else v if not isinstance(v, list)
          else "\n".join(map(str, v)))
    sys.exit(0)
if op == "del":
    data.pop(key, None)
else:
    kind, vals = rest[0], rest[1:]
    conv = {"int": int, "string": str,
            "bool": lambda v: v.lower() in ("1", "true", "yes")}
    data[key] = list(vals) if kind == "array" else conv[kind](vals[0])
with open(path, "w") as f:
    json.dump(data, f, indent=2, sort_keys=True)
    f.write("\n")
PY
    }
    pol_set() { pol_json set "$@"; }
    pol_del() { pol_json del "$1" 2>/dev/null; }
    pol_get() { pol_json get "$1" 2>/dev/null; }
    policy_ready() { [ -w "$BROWSER_POLICY_FILE" ]; }
fi

PLIST=$(agent_file "$SINGBOX_AGENT")

# Optional status server, started and stopped with the chain. It serves the
# dashboard together with the host-side facts a page cannot see for itself.
# Leave STATUSD_AGENT unset in the env file to do without it.
STATUSD_AGENT="${STATUSD_AGENT:-}"
STATUSD_PLIST=$(agent_file "$STATUSD_AGENT")
STATUS_PORT="${STATUS_PORT:-8787}"
STATUSD_BIN="$(cd "$(dirname "$0")" && pwd)/vpnchain-statusd"
DASHBOARD_PAGE="$(cd "$(dirname "$0")" && pwd)/vpnchain-dashboard.html"

# Chromium-family preference domain whose WebRTC policy we toggle.
# Override in the env file for Brave, Edge, Chromium, etc.
BROWSER_DOMAIN="${BROWSER_DOMAIN:-com.google.Chrome}"

# The Linux counterpart: Chrome reads every *.json in this directory as
# mandatory policy. Chromium uses /etc/chromium/policies/managed, Brave
# /etc/brave/policies/managed.
BROWSER_POLICY_FILE="${BROWSER_POLICY_FILE:-/etc/opt/chrome/policies/managed/vpnchain.json}"

# Chrome renamed this policy; write and read both so either vintage works.
WEBRTC_KEYS=(WebRtcIPHandlingPolicy WebRtcIPHandling)
WEBRTC_BLOCK_VALUE=disable_non_proxied_udp

# Incognito in the pinned browser clears cookies and history while leaving
# the exit address untouched - so it looks anonymous while still presenting
# the one address that identifies you. Disabled for that reason, and never
# re-enabled: the unlinked exit is 'browser incognito', a different browser
# altogether, so nothing needs this mode any more.
#   0 available   1 disabled   2 forced
INCOGNITO_KEY=IncognitoModeAvailability
INCOGNITO_OFF=1

# Third-party cookies are the cross-site join key: the same embedded domain
# appears on thousands of sites and recognises its own cookie each time. The
# browser does not block them by default - that phase-out was reversed - so we
# do it per launch. Breaks some embedded sign-in and payment flows, which is
# what 'with-cookies' is for.
COOKIE_KEY=BlockThirdPartyCookies

# Defaults borrowed from Safari and Firefox. The device APIs are the clearest
# case: neither browser ever shipped WebUSB, Web Bluetooth, Web Serial or
# WebHID, having declined on security and privacy grounds, so denying them
# here just matches their behaviour. They also enumerate hardware, which is
# fingerprinting surface.
#
# The second group is enumeration surface specifically. Every one of them hands
# a page a LIST rather than a single value, which is what makes them worth more
# to a fingerprinter than the hardware facts they sit next to:
#
#   LocalFonts       queryLocalFonts() returns every installed font. The set of
#                    fonts on a machine is close to unique, and it is the single
#                    highest-entropy thing a browser will volunteer in one call.
#   WindowManagement getScreenDetails() returns monitor count, sizes and
#                    arrangement - strictly more identifying than the single
#                    screen size it is usually lumped in with.
#   Sensors          motion and orientation, meaningless on a desktop and free
#                    to refuse there.
#   DirectSockets    raw TCP/UDP from a page; nothing here should want it.
#
# All four are denials, never substitutions. That distinction is the whole
# reason this is worth doing while spoofing is not: a refused API looks exactly
# like a browser that never implemented it, whereas a faked value can be caught
# disagreeing with itself - most cheaply by asking a Web Worker, which no
# extension can reach.
#
# What this does NOT buy: fonts stay detectable by measurement. Rendering text
# in a candidate font and comparing measureText() against the fallback needs no
# API and no permission, and document.fonts.check() is the same story. Firefox's
# resistFingerprinting answers that with a standard font allowlist; Chrome has
# no equivalent and no policy that approximates one. So the gain is that a
# script can no longer ask once and get everything - it has to probe candidates
# it already knows to guess. Lower entropy and far more effort, not zero.
#
# Measured, that residue is small: Cover Your Tracks scored the recovered font
# list at 3.49 bits, one browser in 11, near the BOTTOM of its table - while
# the WebGL rows it sat next to scored 9.29 and 8.87. So this group is worth
# far less than its length suggests, and the honest reading is that fonts were
# the wrong thing to spend a pass on.
#
# Fonts are the only entry here with a fallback channel at all. The other seven
# have no alternative route: refuse getScreenDetails and the monitor layout is
# simply gone, since screen.width only ever describes the current display.
#
# That fallback is weaker than it looks, though, and the 3.49 bits above
# understate what the denial is worth. Measurement RECALL IS BOUNDED BY THE
# PROBE LIST - a script can only detect faces whose names it already thought to
# try, while queryLocalFonts() has perfect recall and returns names nobody
# would guess. Measured on this machine: Cover Your Tracks reported 27 fonts
# while vpnchain-dashboard.html found 37 of its 53 candidates, same machine,
# the whole difference being that one list includes developer faces and the
# other does not.
#
# So the value of this denial scales with how unusual the installed set is. A
# font that is uncommon but POPULAR - Adobe's library, Office fonts, the
# well-known monospace families - appears in somebody's probe list and gets
# measured regardless. A genuinely obscure or licensed face does not, and
# enumeration is the only thing that would ever surface it. Keep this denied,
# and keep it denied harder the more such fonts get installed.
#   2 = deny, 3 = ask
DEVICE_API_KEYS=(DefaultWebUsbGuardSetting DefaultWebBluetoothGuardSetting
                 DefaultSerialGuardSetting DefaultWebHidGuardSetting
                 DefaultLocalFontsSetting DefaultWindowManagementSetting
                 DefaultSensorsSetting DefaultDirectSocketsSetting)

# Plaintext over a shared exit is readable by whoever runs it, which makes
# this worth more here than on an ordinary connection.
HTTPS_ONLY_KEY=HttpsOnlyMode

# What the browser reports back to its vendor. Safe Browsing stays on, just at
# Standard: Enhanced sends visited URLs and downloads for real-time checking,
# Standard matches against lists held locally.
# Notification prompts are blocked by default, as Safari and Firefox both
# heavily restrict them, with an allowlist for the handful of sites where
# notifications are the point. The list is personal, so it lives in the env
# file; empty means block everything.
# Chrome can keep running after its last window closes, which makes "quit"
# non-deterministic - and every policy here is read at startup, so a launch
# that cannot reliably restart the browser cannot apply anything. Neither
# Safari nor Firefox persists this way.
BACKGROUND_MODE_KEY=BackgroundModeEnabled

# Chrome saves to Downloads without asking. Being asked means a drive-by
# download cannot land unnoticed.
DOWNLOAD_PROMPT_KEY=PromptForDownloadLocation

NOTIFY_DEFAULT_KEY=DefaultNotificationsSetting
NOTIFY_ALLOW_KEY=NotificationsAllowedForUrls
NOTIFY_ALLOW="${NOTIFY_ALLOW:-}"

TELEMETRY_OFF_KEYS=(UrlKeyedAnonymizedDataCollectionEnabled MetricsReportingEnabled)
SAFE_BROWSING_KEY=SafeBrowsingProtectionLevel
SAFE_BROWSING_STANDARD=1

# Topics, Protected Audience and Attribution Reporting: the in-browser ad
# targeting and measurement APIs that were meant to replace third-party
# cookies. Blocking the cookies without these would close the old cross-site
# join key and leave its intended replacement wide open.
#
# The Privacy Sandbox programme was retired in October 2025 and third-party
# cookies were kept instead, so this is now the worst of both arrangements -
# the old mechanism survived AND the new one shipped. The policies outlived the
# programme, which is what makes turning them off still possible.
#
# The prompt key is included so disabling the APIs does not leave a consent
# dialog asking about features that are already off.
AD_PRIVACY_OFF_KEYS=(PrivacySandboxAdTopicsEnabled
                     PrivacySandboxSiteEnabledAdsEnabled
                     PrivacySandboxAdMeasurementEnabled
                     PrivacySandboxPromptEnabled)

# BROWSER_PROC is a pgrep -f pattern for the browser's MAIN process, which is
# what the quit-and-wait below has to watch. On Linux the command on PATH is a
# wrapper script around /opt/google/chrome/chrome, and the anchored pattern
# keeps chrome_crashpad_handler and the helpers from matching too.
if [ "$OS" = mac ]; then
    BROWSER_APP="${BROWSER_APP:-/Applications/Google Chrome.app}"
    BROWSER_BIN="$BROWSER_APP/Contents/MacOS/$(basename "${BROWSER_APP%.app}")"
    BROWSER_PROC="${BROWSER_PROC:-$BROWSER_BIN}"
else
    BROWSER_BIN="${BROWSER_BIN:-$(command -v google-chrome-stable || command -v google-chrome)}"
    BROWSER_PROC="${BROWSER_PROC:-^/opt/google/chrome/chrome( |\$)}"
fi

# Timezone the browser should report. The browser has no timezone setting and
# delegates to the OS, but it honours TZ, which takes effect before ICU
# initialises - so main thread, iframes and Web Workers all agree. Only the
# zone interpretation changes; the clock itself stays correct, leaving TLS
# validity, JWT expiry and TOTP alone.
#
# This must be a launch from a shell. Wrapping it in a .app bundle was tried
# and produced a correct spoof but markedly slower page loads; the bundle
# launch context, not TZ, was responsible. `launchctl setenv` does not reach
# LaunchServices-launched apps at all. Both paths are disproven - do not
# reintroduce them.
SPOOF_TZ="${SPOOF_TZ:-}"

# Second sing-box inbound, routed straight to the upstream so it bypasses the
# WireGuard endpoint. Same daemon, no reconfiguration - picking an exit is just
# picking a port, and both can be in use at once.
INCOGNITO_PORT="${INCOGNITO_PORT:-1081}"

# The address this machine presents with nothing in the way, which is what
# lets the dashboard tell an upstream node it has not seen before from a
# browser running with no proxy at all - the one failure the page cannot
# otherwise name.
#
# MEASURED at every launch by default, because an ISP hands out a different
# one often enough that a written-down value is wrong exactly when it
# matters. That costs one direct request per launch, which is the request
# everything else here is arranged to avoid making, so it is announced on
# screen rather than done quietly. Pin an address to skip it, or set "off" if
# you would rather the page went without.
REAL_ADDRESS="${REAL_ADDRESS:-auto}"

real_address() {
    case "$REAL_ADDRESS" in
        (off|none|no) return 0 ;;
        (auto)        ;;
        (*)           printf '%s\n' "$REAL_ADDRESS"; return 0 ;;
    esac
    local ip
    # --noproxy so a proxy in the environment cannot answer for the question
    # being asked, which is what this machine looks like with none.
    ip=$(curl -s -m 10 --noproxy '*' https://api.ipify.org 2>/dev/null)
    case "$ip" in
        (*[!0-9.:a-fA-F]*|"") return 0 ;;
        (*)                   printf '%s\n' "$ip" ;;
    esac
}

# The browser for that inbound. A Firefox-family bundle, so none of the
# Chromium machinery above applies to it: no preference domain, no
# --proxy-server, no --incognito. See the header on why it is a different
# browser rather than a second profile of the pinned one.
# Bundles in this family disagree on the executable name - Tor Browser ships
# Contents/MacOS/firefox - so ask the bundle rather than guessing: that is
# exactly what CFBundleExecutable is for. The name list is the fallback for a
# bundle with no readable Info.plist, and INCOGNITO_BIN overrides both.
#
# On Linux there is no bundle: INCOGNITO_BIN is the executable, by default the
# mullvad-browser launcher from Mullvad's apt repository, and INCOGNITO_APP is
# the directory it lives in, which is where distribution/ goes.
INCOGNITO_BIN="${INCOGNITO_BIN:-}"
if [ "$OS" = linux ]; then
    [ -z "$INCOGNITO_BIN" ] && INCOGNITO_BIN=$(command -v mullvad-browser 2>/dev/null)
    INCOGNITO_APP="${INCOGNITO_APP:-$([ -n "$INCOGNITO_BIN" ] && dirname "$(readlink -f "$INCOGNITO_BIN")")}"
else
    INCOGNITO_APP="${INCOGNITO_APP:-/Applications/Mullvad Browser.app}"
fi
if [ -z "$INCOGNITO_BIN" ] && [ -r "$INCOGNITO_APP/Contents/Info.plist" ]; then
    cand=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' \
           "$INCOGNITO_APP/Contents/Info.plist" 2>/dev/null)
    [ -n "$cand" ] && [ -x "$INCOGNITO_APP/Contents/MacOS/$cand" ] &&
        INCOGNITO_BIN="$INCOGNITO_APP/Contents/MacOS/$cand"
fi
if [ -z "$INCOGNITO_BIN" ]; then
    for cand in mullvadbrowser firefox; do
        if [ -x "$INCOGNITO_APP/Contents/MacOS/$cand" ]; then
            INCOGNITO_BIN="$INCOGNITO_APP/Contents/MacOS/$cand"
            break
        fi
    done
fi
unset cand

# Default search engine for the incognito browser. Empty leaves the browser's
# own choice alone, which is what an untouched install should get.
#
# This is the one setting that cannot live in the profile: the engine list is
# not a pref, and the policy that sets it is read from inside the application
# bundle. browser.policies.alternatePath, the per-profile escape hatch, is
# honoured only in automation and Nightly builds; macOS policy preferences
# have to be FORCED ones from a configuration profile, which a defaults write
# is not. Both were tried and both left the policy engine inactive.
#
# So this writes into the bundle, which needs App Management permission for
# whatever runs this script, and which a Mullvad auto-update will undo -
# hence rewriting it at every launch rather than once.
INCOGNITO_SEARCH="${INCOGNITO_SEARCH:-}"

# Engines the policy can name. A search engine is a URL template and little
# else; add one here rather than letting arbitrary templates in from the env
# file, where a typo becomes a browser that quietly searches somewhere else.
search_template() {
    # bash 3.2 is /bin/bash here, so no ${1,,}.
    case "$(printf '%s' "$1" | tr 'A-Z' 'a-z')" in
        (google)     printf 'https://www.google.com/search?q={searchTerms}\n' ;;
        (duckduckgo) printf 'https://duckduckgo.com/?q={searchTerms}\n' ;;
        (startpage)  printf 'https://www.startpage.com/sp/search?query={searchTerms}\n' ;;
        (brave)      printf 'https://search.brave.com/search?q={searchTerms}\n' ;;
        (mojeek)     printf 'https://www.mojeek.com/search?q={searchTerms}\n' ;;
    esac
}

# Put the search policy in place, or report why it is not. Never fatal: a
# browser with the wrong default search engine is a nuisance, and refusing to
# launch over it would be worse than the nuisance.
set_search_policy() {
    local name="$1" dist file template current
    if [ "$OS" = mac ]; then
        dist="$INCOGNITO_APP/Contents/Resources/distribution"
    else
        dist="$INCOGNITO_APP/distribution"
    fi
    file="$dist/policies.json"

    template=$(search_template "$name")
    if [ -z "$template" ]; then
        warn "INCOGNITO_SEARCH=$name is not one this script knows - ignoring"
        return 0
    fi

    # "_vpnchain" marks the file as ours. Firefox reads the "policies" key and
    # ignores the rest, so this costs nothing and keeps us from overwriting a
    # policies.json that someone else put there deliberately.
    local want
    want=$(cat <<EOF
{
  "_vpnchain": "default search engine, rewritten at every launch",
  "policies": {
    "SearchEngines": {
      "Add": [
        {
          "Name": "$name",
          "URLTemplate": "$template",
          "Method": "GET",
          "Description": "$name"
        }
      ],
      "Default": "$name"
    }
  }
}
EOF
)
    if [ -f "$file" ] && ! grep -q '"_vpnchain"' "$file"; then
        warn "$file exists and is not ours - leaving the search engine alone"
        return 0
    fi
    current=$(cat "$file" 2>/dev/null)
    if [ "$current" = "$want" ]; then
        ok "default search engine: $name"
        return 0
    fi
    if ! mkdir -p "$dist" 2>/dev/null || ! printf '%s\n' "$want" > "$file" 2>/dev/null; then
        warn "could not write $file"
        if [ "$OS" = mac ]; then
            warn "grant App Management to whatever runs this, or unset INCOGNITO_SEARCH"
        else
            warn "make $dist writable by you once (sudo), or unset INCOGNITO_SEARCH"
        fi
        return 0
    fi
    ok "default search engine: $name (policy written into the bundle)"
}

# Firefox keeps the proxy in prefs rather than on the command line, so this
# directory is where the proxy for that instance lives - which is why it has
# to be ours alone. It is wiped before each launch and again when the browser
# quits; the marker file is what makes doing that with rm -rf safe, since a
# mistyped path will not have one. It also carries the launch id, so a
# watcher from a previous session cannot wipe a newer one's profile.
# Not the vpnchain-upstream-profile the Chrome instance used: that one may
# still exist, holds no marker, and would be refused rather than wiped.
INCOGNITO_PROFILE="${INCOGNITO_PROFILE:-$HOME/.cache/vpnchain-incognito-profile}"
INCOGNITO_MARKER=.vpnchain-profile

# Set by env files written for the Chrome instance this replaced. Warned
# about rather than silently ignored - each one used to change the session's
# fingerprint, so a reader is entitled to know it no longer does.
RETIRED_VARS=(INCOGNITO_TZ INCOGNITO_TZ_FOLLOW_EXIT INCOGNITO_FLAGS)

# Local daemons that can reach names the ordinary network cannot: Tor for
# .onion, i2pd for .i2p. Unset leaves those names unroutable, which is the
# honest state when there is nothing to route them to - better than a request
# that falls through to a resolver and announces what was being visited.
#
# Both are reached as plain SOCKS outbounds, so nothing about the chain
# changes: the browser still holds one proxy and sing-box still decides where
# each name goes.
TOR_PORT="${TOR_PORT:-}"
I2P_PORT="${I2P_PORT:-}"

port_listening() { nc -z "$1" "$2" >/dev/null 2>&1; }

# install_hint BREW_FORMULA APT_PACKAGE
install_hint() {
    if [ "$OS" = mac ]; then printf 'brew install %s\n' "$1"
    else printf 'sudo apt install %s\n' "$2"; fi
}

# Nothing rotates a launchd redirect, and sing-box logs every connection at
# info - which is deliberate, since that log is what answers "where did this
# name actually go", but it had reached 59 MB. Trimmed to its tail rather
# than emptied: the recent lines are the useful ones.
#
# Only ever while the agent is down, which is the one moment truncating
# cannot race the process appending to it.
LOG_MAX_BYTES="${LOG_MAX_BYTES:-10485760}"
LOG_KEEP_LINES="${LOG_KEEP_LINES:-2000}"

trim_log() {
    local f="$1" size tmp
    [ -f "$f" ] || return 0
    size=$(file_size "$f") || return 0
    [ "${size:-0}" -gt "$LOG_MAX_BYTES" ] || return 0
    tmp=$(temp_file vpnchain-log) || return 0
    if tail -n "$LOG_KEEP_LINES" "$f" > "$tmp" 2>/dev/null; then
        cat "$tmp" > "$f"
        ok "trimmed $(basename "$f"): $((size / 1048576)) MB -> last $LOG_KEEP_LINES lines"
    fi
    rm -f "$tmp"
}

trim_agent_logs() {
    local file path
    for file in "$PLIST" "$STATUSD_PLIST"; do
        while IFS= read -r path; do
            [ -n "$path" ] && trim_log "$path"
        done < <(agent_logs "$file")
    done
}

# i2pd is started on demand rather than kept running, which is the whole
# reason this verb exists. An I2P router is not a client that dials out when
# asked: it joins the network, carries other people's traffic and costs
# bandwidth around the clock, and it is useless for the first several minutes
# after starting because it has to find peers and build tunnels. Tor has
# neither property, which is why Tor is an agent and this is a verb.
I2PD_BIN="${I2PD_BIN:-$(command -v i2pd 2>/dev/null)}"
I2PD_CONF="${I2PD_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/i2pd/i2pd.conf}"

# Matched on the config path, so this never picks up an i2pd someone else
# started with different settings - its routing and transit limits would not
# be the ones described here.
i2p_running() { pgrep -f "i2pd --conf $I2PD_CONF" >/dev/null 2>&1; }

i2p_pid() { pgrep -f "i2pd --conf $I2PD_CONF" | head -1; }

# Counted off disk, because i2pd's web console - which would also report
# tunnel counts and build success - is turned off. It is unauthenticated by
# default, and the browsers here bypass the proxy for loopback, so any page
# they load could reach it and stop the router.
#
# Not the datadir from the config either: i2pd ignores that key and uses this
# path regardless, which is why counting the configured one found nothing.
if [ "$OS" = mac ]; then
    I2PD_DATA="${I2PD_DATA:-$HOME/Library/Application Support/i2pd}"
else
    I2PD_DATA="${I2PD_DATA:-$HOME/.i2pd}"
fi

i2p_routers() {
    [ -d "$I2PD_DATA/netDb" ] || { echo 0; return; }
    find "$I2PD_DATA/netDb" -type f -name 'routerInfo-*' 2>/dev/null |
        wc -l | tr -d ' '
}

cmd_i2p() {
    case "${1:-status}" in
        (start)
            if [ "$(singbox_mode)" = chained-reality ]; then
                bad "not in chained-reality mode: an I2P router keeps dozens of"
                bad "connections open, all of which would go through the one"
                bad "Reality server - the pattern that gets such servers found"
                echo "           switch first with: vpnchain restart chained"
                exit 1
            fi
            [ -x "${I2PD_BIN:-}" ] || { bad "i2pd not found - $(install_hint i2pd i2pd)"; exit 1; }
            [ -r "$I2PD_CONF" ] || { bad "no config at $I2PD_CONF"; exit 1; }
            if i2p_running; then
                ok "already running (pid $(i2p_pid))"
                return 0
            fi
            nohup "$I2PD_BIN" --conf "$I2PD_CONF" >/dev/null 2>&1 &
            disown 2>/dev/null
            local i=0
            while [ "$i" -lt 30 ] && ! i2p_running; do sleep 0.5; i=$((i + 1)); done
            if ! i2p_running; then
                bad "i2pd did not stay up - run it in the foreground to see why:"
                echo "           $I2PD_BIN --conf $I2PD_CONF"
                exit 1
            fi
            ok "i2pd running (pid $(i2p_pid))"
            if [ -n "$I2P_PORT" ]; then
                i=0
                while [ "$i" -lt 40 ] && ! port_listening 127.0.0.1 "$I2P_PORT"; do
                    sleep 0.5; i=$((i + 1))
                done
                port_listening 127.0.0.1 "$I2P_PORT" \
                    && ok "socks proxy on $I2P_PORT, .i2p names routed to it" \
                    || warn "socks proxy on $I2P_PORT has not come up"
            else
                warn "I2P_PORT is not set, so .i2p names are not routed anywhere"
                warn "set it in $CONFIG and run: vpnchain config gen && vpnchain restart"
            fi
            warn "give it several minutes - it cannot reach anything until it has"
            warn "found peers and built tunnels, however healthy it looks here"
            ;;
        (stop)
            if ! i2p_running; then
                ok "not running"
                return 0
            fi
            local pid
            pid=$(i2p_pid)
            kill "$pid" 2>/dev/null
            local i=0
            while [ "$i" -lt 40 ] && i2p_running; do sleep 0.25; i=$((i + 1)); done
            i2p_running && { bad "i2pd ignored the signal (pid $pid)"; exit 1; }
            ok "i2pd stopped"
            ;;
        (status|"")
            if i2p_running; then
                ok "i2pd running (pid $(i2p_pid))"
            else
                warn "i2pd not running - start it with: vpnchain i2p start"
            fi
            [ -n "$I2P_PORT" ] && {
                port_listening 127.0.0.1 "$I2P_PORT" \
                    && ok "socks proxy listening on $I2P_PORT" \
                    || warn "nothing listening on $I2P_PORT"
            } || warn "I2P_PORT unset - .i2p names are not routed"
            local n
            n=$(i2p_routers)
            if [ "${n:-0}" -gt 0 ]; then
                ok "knows $n routers"
            else
                warn "knows no routers - reseeding, or reseed is failing"
            fi
            ;;
        (*)
            echo "usage: vpnchain i2p [start|stop|status]" >&2
            exit 1 ;;
    esac
}

SINGBOX_CONFIG="${SINGBOX_CONFIG:-$HOME/.config/sing-box/config.json}"

# Tag of the sing-box outbound pointing at the upstream proxy. This is what
# gets written back as the endpoint's "detour" when re-enabling chained mode,
# so it must match the tag actually used in SINGBOX_CONFIG. Override in the
# env file if yours differs.
UPSTREAM_TAG="${UPSTREAM_TAG:-upstream}"

# Native mode. The upstream becomes a selector over every node in the
# subscription, and the tag is fixed because nothing outside this script
# names it.
#
# Every node is an outbound, but sing-box dials none of them until the
# selector points there - an outbound costs nothing on the wire until used.
# So the whole list can be loaded while only one or two names are ever seen,
# and switching nodes needs no restart: the pilot moves the selector through
# the Clash API, on loopback and behind a secret.
NODES_FILE="${NODES_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/vpnchain/nodes.json}"
# Reality nodes you run yourself, in the node list's own format ({"nodes":
# [...]}, each with tag, server, ip, port, secret, security "reality", sni,
# pbk, sid, flow, fp, family, region). Merged into the node list, so
# chained-reality uses them beside the subscription's - and the pilot prefers
# them, since their setup is yours to get right. Kept apart from the list
# because the subscription rewrites that.
OWN_NODES_FILE="${OWN_NODES_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/vpnchain/own-nodes.json}"

# Bring the node list up to date with OWN_NODES_FILE: its nodes in, any own
# node no longer in it out. Run before every config generation, so an edit
# to that file takes effect with 'vpnchain reload'.
merge_own_nodes() {
    [ -s "$NODES_FILE" ] || return 0
    python3 - "$NODES_FILE" "$OWN_NODES_FILE" <<'PY'
import json, os, sys
path, own_path = sys.argv[1:3]
doc = json.load(open(path))
try:
    own = json.load(open(own_path))["nodes"]
except (OSError, ValueError, KeyError):
    own = []
own_tags = {n["tag"] for n in own}
nodes = [n for n in doc["nodes"] if not str(n.get("family", "")).startswith("own:")
         and n["tag"] not in own_tags] + own
if nodes != doc["nodes"]:
    doc["nodes"] = nodes
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(doc, f, indent=1)
    os.replace(tmp, path)
PY
}
SHARED_PORT="${SHARED_PORT:-20170}"
# Resolvers for node names, by address so that none needs a lookup of its
# own: DoH to each in turn, then the system's resolver as the last resort.
# Only one is in use at a time - sing-box has no failover between DNS
# servers - and NODE_DNS_STATE records which; the pilot moves it when the
# one in use stops answering, and back when a better one answers again.
NODE_DNS="${NODE_DNS:-1.1.1.1 8.8.8.8 9.9.9.9}"
NODE_DNS_STATE="${XDG_CONFIG_HOME:-$HOME/.config}/vpnchain/node-dns"
CLASH_PORT="${CLASH_PORT:-9090}"
CLASH_SECRET_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/vpnchain/clash-secret"
PILOT_AGENT="${PILOT_AGENT:-}"
PILOT_PLIST=$(agent_file "$PILOT_AGENT")
PILOT_BIN="$(cd "$(dirname "$0")" && pwd)/vpnchain-pilot"
native && UPSTREAM_TAG=shared

# Generated once and kept: the pilot reads it from the same file, and
# regenerating the config must not change it under a running pilot.
clash_secret() {
    if [ ! -s "$CLASH_SECRET_FILE" ]; then
        mkdir -p "$(dirname "$CLASH_SECRET_FILE")"
        ( umask 077
          python3 -c 'import secrets; print(secrets.token_hex(24))' \
              > "$CLASH_SECRET_FILE" ) || return 1
    fi
    cat "$CLASH_SECRET_FILE"
}

# Tracker rejection, done in the chain rather than the browser. Space-separated
# AdGuard-format DNS filter URLs; empty disables the feature entirely.
BLOCKLIST_URL="${BLOCKLIST_URL:-}"
BLOCKLIST_PATH="${BLOCKLIST_PATH:-$HOME/.config/sing-box/blocklist.srs}"

# Countries whose sites the pinned browser refuses, so that they are visited
# from a separate, unproxied browser instead. A local site loaded through the
# chain sees a foreign visitor, and one sent around it - the split routing
# v2rayA calls bypassing the mainland - lets the page compare the address
# its own server sees with the one a foreign address-check sees, and learn
# the browser uses a proxy. Its identity is also the exit's: timezone,
# language, cookies shared with everything else. Neither belongs at a bank
# that knows you by national ID. Refusing them makes the split visible.
#
# Set explicitly empty to turn it off. Matched on the pinned port only; the
# incognito browser is left alone.
KEEP_OUT_COUNTRIES="${KEEP_OUT_COUNTRIES-ru cn ir}"
KEEP_OUT_DIR="${KEEP_OUT_DIR:-$HOME/.config/sing-box/keep-out}"

# Installed only if the converted set still blocks what it should and still
# lets through what it must. A bad list is not a cosmetic problem: it presents
# as sign-in or payment pages mysteriously failing, days after the fetch that
# caused it, with nothing pointing back here. Cheaper to refuse up front.
BLOCKLIST_MUST_BLOCK=(www.google-analytics.com doubleclick.net
                      b.scorecardresearch.com)
BLOCKLIST_MUST_PASS=(github.com accounts.google.com fonts.gstatic.com
                     mail.google.com cdn.jsdelivr.net)


# The modes differ in the config only in the WireGuard endpoint's "detour":
# none for direct, the selector for chained - which in chained-reality mode
# is named "reality".
singbox_mode() {
    python3 - "$SINGBOX_CONFIG" <<'PY' 2>/dev/null || echo unknown
import json, sys
try:
    c = json.load(open(sys.argv[1]))
except Exception:
    print("unknown"); raise SystemExit
eps = c.get("endpoints") or []
wg = next((e for e in eps if e.get("type") == "wireguard"), None)
if wg is None:
    print("unknown")
elif wg.get("detour") == "reality":
    print("chained-reality")
else:
    print("chained" if wg.get("detour") else "direct")
PY
}

bold() { printf '\033[1m%s\033[0m\n' "$1"; }
ok()   { printf '  \033[32m[ok]\033[0m   %s\n' "$1"; }
warn() { printf '  \033[33m[warn]\033[0m %s\n' "$1"; }
bad()  { printf '  \033[31m[bad]\033[0m  %s\n' "$1"; }


agent_running() { pgrep -f 'sing-box run' >/dev/null 2>&1; }

cmd_start() {
    # Bootstrap only. Writing a config that does not exist cannot discard
    # anything, so it is safe to do implicitly; regenerating one that does
    # exist can, which is why that stays behind an explicit verb.
    #
    # Native mode needs the node list before any config can exist. With no
    # chain yet, the fetch goes by Tor or directly.
    if native && [ ! -s "$NODES_FILE" ]; then
        warn "no node list yet - fetching the subscription"
        cmd_subscribe
    fi
    if [ ! -f "$SINGBOX_CONFIG" ]; then
        if have_wg_creds; then
            warn "no config at $SINGBOX_CONFIG - generating one"
            cmd_config
        else
            bad "no config at $SINGBOX_CONFIG, and the env file lacks the"
            bad "WireGuard values needed to generate one"
            exit 1
        fi
    fi

    if agent_running; then
        ok "sing-box already running"
        start_statusd
        start_pilot
        return
    fi

    refuse_if_port_blocked

    # Down right now, so this is the safe moment.
    trim_agent_logs

    ensure_singbox_agent || exit 1
    agent_start "$SINGBOX_AGENT" "$PLIST"
    sleep 2
    if agent_running; then
        ok "sing-box started"
    else
        bad "sing-box failed to start - check its stderr log"
    fi
    start_statusd
    start_pilot
}

pilot_running() { pgrep -f 'vpnchain-pilot' >/dev/null 2>&1; }

# The pilot steers the selector, so it only means anything in native mode and
# only while sing-box runs - started and stopped with it, like the status
# server. Unset PILOT_AGENT leaves the selector wherever it was put.
start_pilot() {
    native && [ -n "$PILOT_AGENT" ] || return 0
    if [ ! -x "$PILOT_BIN" ]; then
        warn "pilot not found at $PILOT_BIN - skipping"
        return 0
    fi
    write_agent "$PILOT_AGENT" "$PILOT_PLIST" \
        "$HOME/.config/vpnchain/pilot.log" \
        "$HOME/.config/vpnchain/pilot.err.log" \
        /usr/bin/env python3 "$PILOT_BIN"
    if pilot_running; then
        ok "pilot already running"
    else
        agent_start "$PILOT_AGENT" "$PILOT_PLIST"
        sleep 1
        pilot_running && ok "pilot steering the node selection" \
                      || bad "pilot did not start - see pilot.err.log"
    fi
}

stop_pilot() {
    [ -n "$PILOT_AGENT" ] || return 0
    agent_stop "$PILOT_AGENT" "$PILOT_PLIST"
    wait_gone 'vpnchain-pilot'
    ok "pilot stopped"
}

statusd_running() { pgrep -f 'vpnchain-statusd' >/dev/null 2>&1; }

# Both written on first use rather than shipped, since they carry absolute
# paths for this machine. The binary is resolved now, because neither launchd
# nor a systemd user manager has Homebrew or ~/.local/bin on its PATH.
ensure_singbox_agent() {
    [ -f "$PLIST" ] && return 0
    local bin
    bin=$(command -v sing-box) || {
        bad "sing-box not found - $(install_hint sing-box sing-box)"
        return 1
    }
    write_agent "$SINGBOX_AGENT" "$PLIST" \
        "$(dirname "$SINGBOX_CONFIG")/sing-box.log" \
        "$(dirname "$SINGBOX_CONFIG")/sing-box.err.log" \
        "$bin" run -c "$SINGBOX_CONFIG"
}

ensure_statusd_plist() {
    write_agent "$STATUSD_AGENT" "$STATUSD_PLIST" \
        "$HOME/.config/vpnchain/statusd.log" \
        "$HOME/.config/vpnchain/statusd.err.log" \
        /usr/bin/env python3 "$STATUSD_BIN"
}

start_statusd() {
    [ -z "$STATUSD_AGENT" ] && return 0
    if [ ! -x "$STATUSD_BIN" ]; then
        warn "status server not found at $STATUSD_BIN - skipping"
        return 0
    fi
    ensure_statusd_plist
    if statusd_running; then
        ok "status server already running"
    else
        agent_start "$STATUSD_AGENT" "$STATUSD_PLIST"
        sleep 1
        statusd_running && ok "status server on http://127.0.0.1:$STATUS_PORT/" \
                        || bad "status server did not start - see statusd.err.log"
    fi
}

stop_statusd() {
    [ -z "$STATUSD_AGENT" ] && return 0
    agent_stop "$STATUSD_AGENT" "$STATUSD_PLIST"
    wait_gone 'vpnchain-statusd'
    ok "status server stopped"
}

# launchctl and systemctl return once the stop is requested, not once the
# process is gone. A start straight after - which is what restart is - would
# then find the old process still exiting, call it "already running", load
# nothing, and leave the browser with no tunnel once it finished exiting.
wait_gone() {
    local i=0
    while [ "$i" -lt 60 ] && pgrep -f "$1" >/dev/null 2>&1; do
        sleep 0.25; i=$((i + 1))
    done
    ! pgrep -f "$1" >/dev/null 2>&1
}

cmd_stop() {
    stop_pilot
    stop_statusd
    agent_stop "$SINGBOX_AGENT" "$PLIST"
    if wait_gone 'sing-box run'; then
        ok "sing-box stopped"
    else
        bad "sing-box is still running after 15s"
    fi
}

# "blocked" if either policy key pins non-proxied UDP off, else "allowed".
webrtc_state() {
    local k v
    for k in "${WEBRTC_KEYS[@]}"; do
        v=$(pol_get "$k")
        [ "$v" = "$WEBRTC_BLOCK_VALUE" ] && { echo blocked; return; }
    done
    echo allowed
}

set_incognito_policy() {
    pol_set "$INCOGNITO_KEY" int "$1"
}

set_cookie_policy() {
    pol_set "$COOKIE_KEY" bool "$1"
}

# Static - never relaxed, so unlike the cookie and WebRTC policies there is
# nothing to restore afterwards. Applied before the quit attempt so an aborted
# launch still leaves them in place.
set_hardening_policies() {
    local k
    for k in "${DEVICE_API_KEYS[@]}"; do
        pol_set "$k" int 2
    done
    pol_set "$HTTPS_ONLY_KEY" string force_enabled
    for k in "${TELEMETRY_OFF_KEYS[@]}"; do
        pol_set "$k" bool false
    done
    pol_set "$SAFE_BROWSING_KEY" int "$SAFE_BROWSING_STANDARD"
    for k in "${AD_PRIVACY_OFF_KEYS[@]}"; do
        pol_set "$k" bool false
    done

    # 2 = block. The allowlist is rewritten wholesale each launch so removing
    # an entry from the env file actually removes it, rather than leaving a
    # stale permission behind.
    pol_set "$BACKGROUND_MODE_KEY" bool false
    pol_set "$DOWNLOAD_PROMPT_KEY" bool true

    pol_set "$NOTIFY_DEFAULT_KEY" int 2
    pol_del "$NOTIFY_ALLOW_KEY"
    if [ -n "$NOTIFY_ALLOW" ]; then
        # shellcheck disable=SC2086
        pol_set "$NOTIFY_ALLOW_KEY" array $NOTIFY_ALLOW
    fi
}

# The resting state both policies should be left in. Called on the normal path
# and from a trap, so an interrupted launch cannot strand the browser with
# incognito forced or WebRTC allowed.
restore_policies() {
    set_webrtc block
    set_incognito_policy "$INCOGNITO_OFF"
    set_cookie_policy true
}

set_webrtc() {
    local k
    if [ "$1" = block ]; then
        for k in "${WEBRTC_KEYS[@]}"; do
            pol_set "$k" string "$WEBRTC_BLOCK_VALUE"
        done
    else
        # Delete rather than writing "default": a mandatory policy also
        # overrides extension-set privacy settings, so leaving one in place
        # would silently defeat any extension-based control later.
        for k in "${WEBRTC_KEYS[@]}"; do
            pol_del "$k"
        done
    fi
}

# Match the binary path specifically. A looser pattern also matches the
# osascript quit command and this script's own arguments, which would make the
# quit-wait loop below never finish.
browser_running() { pgrep -f "$BROWSER_PROC" >/dev/null 2>&1; }

# A polite quit, so the browser saves its session. Chrome on Linux treats
# SIGTERM to the main process as exactly that.
browser_quit() {
    if [ "$OS" = mac ]; then
        osascript -e "quit app \"$(basename "${BROWSER_APP%.app}")\"" >/dev/null 2>&1
    else
        kill -TERM "$(pgrep -o -f "$BROWSER_PROC")" 2>/dev/null
    fi
}

# The tunnel needs time to hand shake after the agent restarts, and until it
# does, everything through the proxy fails. A fixed sleep either wastes time or
# lies, so poll until traffic actually flows.
wait_for_chain() {
    local i=0
    while [ "$i" -lt 12 ]; do
        if curl -s -m 4 --socks5-hostname "$PROXY_HOST:$PROXY_PORT" \
                -o /dev/null https://api.ipify.org 2>/dev/null; then
            ok "tunnel is carrying traffic"
            return 0
        fi
        sleep 2
        i=$((i + 1))
    done
    bad "tunnel is up but not carrying traffic after ~25s"
    echo "         check: tail ~/.config/sing-box/sing-box.err.log"
    return 1
}

# Switch the config between chained, chained-reality and direct. Returns 0
# if it changed. Does not restart on its own; callers that already restart
# handle that.
switch_mode() {
    local want="$1" cur
    cur=$(singbox_mode)

    case "$want" in
        chained|direct|chained-reality) ;;
        *) echo "vpnchain: unknown mode '$want' (expected chained, chained-reality or direct)" >&2
           exit 1 ;;
    esac
    if [ "$want" = chained-reality ] && ! native; then
        bad "chained-reality mode dials the subscription's Reality node itself, which"
        bad "needs SUBSCRIPTION_URL - an upstream proxy has no Reality to choose"
        exit 1
    fi
    if [ "$cur" = unknown ]; then
        bad "could not read a wireguard endpoint from $SINGBOX_CONFIG"
        exit 1
    fi
    if [ "$cur" = "$want" ]; then
        ok "already in $want mode"
        return 1
    fi

    # Native configs are regenerated in the new mode: chained-reality renames
    # the selector and every route through it, which is the generator's
    # business rather than an edit's. The old one is kept for the failure
    # path below.
    if native; then
        cp -p "$SINGBOX_CONFIG" "$SINGBOX_CONFIG.bak"
        generate_config "$SINGBOX_CONFIG" "$want" || exit 1
    else
    # Edit in place rather than keeping two config files, so the keys and the
    # peer cannot drift apart between them.
    python3 - "$SINGBOX_CONFIG" "$want" "$UPSTREAM_TAG" <<'PY' || exit 1
import json, shutil, sys
path, want, tag = sys.argv[1], sys.argv[2], sys.argv[3]
c = json.load(open(path))
wg = next(e for e in c["endpoints"] if e.get("type") == "wireguard")
if want == "chained":
    wg["detour"] = tag
else:
    wg.pop("detour", None)
shutil.copy2(path, path + ".bak")
with open(path, "w") as f:
    json.dump(c, f, indent=2)
    f.write("\n")
PY
    fi

    if ! sing-box check -c "$SINGBOX_CONFIG" 2>/dev/null; then
        bad "edited config failed validation - restoring"
        mv "$SINGBOX_CONFIG.bak" "$SINGBOX_CONFIG"
        exit 1
    fi
    rm -f "$SINGBOX_CONFIG.bak"
    ok "config switched to $want mode"

    if [ "$want" = direct ]; then
        warn "the tunnel is now plainly a VPN on the wire: UDP straight to the"
        warn "peer address, with none of the upstream's cover traffic"
        warn "it will also fail outright on networks that block UDP or VPNs"
    elif [ "$want" = chained-reality ]; then
        ok "the tunnel and the shared port now go through Reality nodes only,"
        ok "your own first; the incognito browser through the subscription's"
        ok "Reality nodes only, never your own"
        ok "BitTorrent is refused on the shared port while in this mode"
        # i2pd dials out through the shared port, so a running router would
        # move its dozens of connections onto the Reality server with the
        # switch. Stopped here rather than left to be noticed.
        if i2p_running; then
            cmd_i2p stop
            ok "i2pd stopped - it is refused in this mode"
        fi
        warn "if it stops answering, nothing falls back on its own - switch"
        warn "with: vpnchain restart chained"
    fi
    return 0
}

# Optional [chained|chained-reality|direct] argument on the lifecycle verbs.
# A mode change needs the agent reloaded, so if it is already running, restart
# it here - otherwise cmd_start would see a live agent and leave the old
# config loaded.
maybe_switch_mode() {
    [ -z "${1:-}" ] && return 0
    if switch_mode "$1" && agent_running; then
        agent_restart "$SINGBOX_AGENT" "$PLIST" \
            || { cmd_stop >/dev/null 2>&1; cmd_start >/dev/null 2>&1; }
        ok "sing-box reloaded for the new mode"
    fi
}




# Blocking is engaged only when a list is configured AND the converted set is
# actually on disk. sing-box refuses to start if a local rule-set path is
# missing, so conditioning on the file is what keeps 'vpnchain config gen' safe to
# run before the first fetch - and what makes deleting the file a complete
# off switch after the next regenerate.
blocklist_active() { [ -n "$BLOCKLIST_URL" ] && [ -s "$BLOCKLIST_PATH" ]; }

# sing-box prints the matching rule on STDERR and exits 0 whether or not
# anything matched, so neither the exit status nor stdout distinguishes a hit
# from a miss. The log line is the only signal.
blocklist_blocks() {
    case "$(sing-box rule-set match -f binary "$1" "$2" 2>&1)" in
        *"match rules"*) return 0 ;;
        *)               return 1 ;;
    esac
}

# Fetch, convert, verify, install - in that order, and nothing is installed
# until the verify passes.
cmd_blocklist() {
    if [ -z "$BLOCKLIST_URL" ]; then
        bad "BLOCKLIST_URL is not set in $CONFIG - nothing to fetch"
        echo "         set it to one or more space-separated AdGuard-format DNS"
        echo "         filter URLs. That format is line-based, so several are"
        echo "         concatenated and the rule-set is their union."
        exit 1
    fi
    if ! command -v sing-box >/dev/null 2>&1; then
        bad "sing-box not found - it does the conversion"
        exit 1
    fi

    local tmp src srs u parsed d n=0 fail=0
    tmp=$(temp_dir vpnchain-blocklist) || exit 1
    src="$tmp/source.txt"
    srs="$tmp/blocklist.srs"
    : > "$src"

    # Deliberately unquoted: the value is a list of URLs, not one URL.
    # shellcheck disable=SC2086
    for u in $BLOCKLIST_URL; do
        if ! curl -fsSL -m 180 "$u" >> "$src"; then
            bad "could not fetch $u"
            bad "the installed list is untouched"
            rm -rf "$tmp"
            exit 1
        fi
        # Lists do not reliably end in a newline. Without this the last rule of
        # one would be glued to the first rule of the next and both would be
        # silently lost - a failure that would only show as two missing entries
        # out of two hundred thousand.
        printf '\n' >> "$src"
        n=$((n + 1))
        ok "fetched $u"
    done
    ok "$(wc -l <"$src" | tr -d ' ') lines from $n list(s)"

    parsed=$(sing-box rule-set convert -t adguard -o "$srs" "$src" 2>&1 \
             | sed -n 's/.*parsed rules: \([0-9]*\).*/\1/p' | tail -1)
    if [ ! -s "$srs" ]; then
        bad "conversion produced no rule-set"
        rm -rf "$tmp"
        exit 1
    fi
    ok "converted ${parsed:-?} rules"

    for d in "${BLOCKLIST_MUST_BLOCK[@]}"; do
        blocklist_blocks "$srs" "$d" || { bad "smoke test: $d is NOT blocked"; fail=1; }
    done
    for d in "${BLOCKLIST_MUST_PASS[@]}"; do
        if blocklist_blocks "$srs" "$d"; then
            bad "smoke test: $d WOULD be blocked"
            fail=1
        fi
    done
    if [ "$fail" = 1 ]; then
        bad "discarding this rule-set; the installed one is untouched"
        rm -rf "$tmp"
        exit 1
    fi
    ok "smoke test passed: ${#BLOCKLIST_MUST_BLOCK[@]} blocked, ${#BLOCKLIST_MUST_PASS[@]} reachable"

    mkdir -p "$(dirname "$BLOCKLIST_PATH")"
    if ! mv "$srs" "$BLOCKLIST_PATH"; then
        bad "could not install $BLOCKLIST_PATH"
        rm -rf "$tmp"
        exit 1
    fi
    rm -rf "$tmp"
    ok "installed $BLOCKLIST_PATH ($(wc -c <"$BLOCKLIST_PATH" | tr -d ' ') bytes)"

    if ! grep -q 'blocklist' "$SINGBOX_CONFIG" 2>/dev/null; then
        warn "the live config does not reference it yet - regenerate and reload:"
        echo "           vpnchain config gen && vpnchain restart"
    elif agent_running; then
        echo "         load the updated list with: vpnchain restart"
    fi
}

# Per-country data for KEEP_OUT_COUNTRIES. Three layers, because none is
# complete alone: the country's TLDs (needs no fetch, so it holds even before
# the first one), a list of its services' names - which mostly live under
# .com - and its address ranges, which catch whatever is hosted there under
# any name at all.
keep_out_tlds() {
    case "$1" in
        (ru) echo ru su xn--p1ai ;;                     # .рф
        (cn) echo cn xn--fiqs8s xn--fiqz9s ;;           # .中国 .中國
        (ir) echo ir xn--mgba3a4f16a ;;                 # .ایران
        (*)  echo "$1" ;;
    esac
}

# SagerNet's lists track v2fly's community list. Its Iran entry is a few
# dozen names, so Iran comes from the list Iranian clients themselves use.
keep_out_geosite_url() {
    local r=https://raw.githubusercontent.com
    case "$1" in
        (cn) echo "$r/SagerNet/sing-geosite/rule-set/geosite-cn.srs" ;;
        (ir) echo "$r/Chocolate4U/Iran-sing-box-rules/rule-set/geosite-ir.srs" ;;
        (*)  echo "$r/SagerNet/sing-geosite/rule-set/geosite-category-$1.srs" ;;
    esac
}
keep_out_geoip_url() {
    echo "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-$1.srs"
}

# A name and an address each list must hold. The addresses are resolvers
# rather than websites, since a resolver's address is what stays put.
keep_out_probe() {
    case "$1" in
        (ru) echo yandex.com 77.88.8.8 ;;
        (cn) echo baidu.com 114.114.114.114 ;;
        (ir) echo digikala.com 2.144.0.1 ;;
    esac
}
KEEP_OUT_MUST_PASS=(google.com wikipedia.org github.com 8.8.8.8 1.1.1.1)

# Fetch, verify, install, one file at a time: a list that fails keeps the
# installed copy, and a country without one is still refused by its TLDs.
cmd_keep_out() {
    [ -n "$KEEP_OUT_COUNTRIES" ] || return 0
    command -v sing-box >/dev/null 2>&1 || { bad "sing-box not found"; return 1; }
    local tmp cc kind url f probe want p bad_one rc=0
    tmp=$(temp_dir vpnchain-keep-out) || return 1
    mkdir -p "$KEEP_OUT_DIR"
    for cc in $KEEP_OUT_COUNTRIES; do
        probe=$(keep_out_probe "$cc")
        for kind in geosite geoip; do
            url=$("keep_out_${kind}_url" "$cc")
            f="$tmp/$kind-$cc.srs"
            if ! curl -fsSL -m 120 -o "$f" "$url" || [ ! -s "$f" ]; then
                bad "could not fetch $kind for $cc - $url"; rc=1; continue
            fi
            bad_one=
            # The probe pair is "name address"; each list must hold its half.
            if [ -n "$probe" ]; then
                if [ "$kind" = geosite ]; then want=${probe% *}; else want=${probe#* }; fi
                blocklist_blocks "$f" "$want" || bad_one="$want is missing"
            fi
            for p in "${KEEP_OUT_MUST_PASS[@]}"; do
                blocklist_blocks "$f" "$p" && bad_one="$p would be refused"
            done
            if [ -n "$bad_one" ]; then
                bad "$kind-$cc failed its smoke test ($bad_one); keeping the installed one"
                rc=1; continue
            fi
            mv -f "$f" "$KEEP_OUT_DIR/$kind-$cc.srs"
            ok "installed $kind-$cc ($(file_size "$KEEP_OUT_DIR/$kind-$cc.srs") bytes)"
        done
    done
    rm -rf "$tmp"
    return $rc
}

# A desktop notification, for the few events worth interrupting for. Fixed
# strings only - nothing from the network ever reaches the osascript line.
notify() {
    if [ "$OS" = mac ]; then
        osascript -e "display notification \"$1\" with title \"vpnchain\"" \
            >/dev/null 2>&1
    else
        notify-send vpnchain "$1" >/dev/null 2>&1
    fi
}

# The DNS tunnel route for 'subscribe'. Servers and resolvers come from a
# site-local list, since both are the provider's and change with it:
#
#   server <region> <tunnel-domain> <pubkey-hex> socks
#   resolver doh <url> <note>
#
# Only servers that end in a SOCKS proxy are used, and only DoH resolvers:
# over plain UDP the tunnel's long random-looking query names are there for
# any DPI box to read, while over DoH they are inside the resolver's TLS.
#
# Resolvers are tried by the tier in their note (T<n>, as the provider grades
# them): large global ones first, whose traffic a tunnel can hide in and
# which do not throttle it; small independent ones next, which a censor may
# not have got to; regional ones (China, Russia) last, since they are what
# answers inside those countries when nothing foreign does, but their
# operators read every query and answer to the censor.
DNSTT_LIST="${DNSTT_LIST:-${XDG_CONFIG_HOME:-$HOME/.config}/vpnchain/dnstt.list}"
DNSTT_TIERS="${DNSTT_TIERS:-T6,T7 T6,T7 T4,T5 T2,T3}"   # one attempt per entry

# launchd's PATH has neither Homebrew nor ~/.local/bin, and the pilot runs
# subscribe from there.
dnstt_bin() {
    command -v dnstt-client 2>/dev/null ||
        { [ -x "$HOME/.local/bin/dnstt-client" ] && echo "$HOME/.local/bin/dnstt-client"; }
}

dnstt_available() {
    grep -q '^server .* socks' "$DNSTT_LIST" 2>/dev/null && [ -n "$(dnstt_bin)" ]
}

# dnstt_fetch OUT - one attempt per DNSTT_TIERS entry, each with a different
# server key where the list allows (two domains with one key are one server
# under two names) and a resolver drawn at random from that entry's tiers, so
# no two fetches look alike to a resolver.
dnstt_fetch() {
    local out="$1" bin region domain key doh port pid i
    bin=$(dnstt_bin)
    while read -r region domain key doh; do
        port=$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1])')
        "$bin" -doh "$doh" -pubkey "$key" "$domain" "127.0.0.1:$port" >/dev/null 2>&1 &
        pid=$!
        i=0
        while [ "$i" -lt 20 ] && ! port_listening 127.0.0.1 "$port"; do
            sleep 0.25; i=$((i + 1))
        done
        ok "dnstt: trying the $region server (DoH, slow - up to two minutes)"
        if curl -fsS -m 120 --socks5-hostname "127.0.0.1:$port" \
                -o "$out" "$SUBSCRIPTION_URL" 2>/dev/null && [ -s "$out" ]; then
            kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null
            return 0
        fi
        kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null
    done < <(python3 - "$DNSTT_LIST" $DNSTT_TIERS <<'PY'
import random, re, sys
servers, resolvers = [], []
for line in open(sys.argv[1]):
    f = line.split()
    if len(f) >= 5 and f[0] == "server" and f[4] == "socks":
        servers.append(f[1:4])
    elif len(f) >= 3 and f[0] == "resolver" and f[1] == "doh":
        tier = re.search(r"/(T\d+)\b", f[3] if len(f) > 3 else "")
        resolvers.append((f[2], tier.group(1) if tier else "T?"))
if not servers or not resolvers:
    sys.exit()
random.shuffle(servers)
# Distinct keys first: a second name for a server that just failed is the
# same server failing again.
seen, first, rest = set(), [], []
for s in servers:
    (rest if s[2] in seen else first).append(s)
    seen.add(s[2])
order = first + rest
for i, tiers in enumerate(sys.argv[2:]):
    pool = [url for url, t in resolvers if t in tiers.split(",")]
    if not pool:
        continue
    region, domain, key = order[i % len(order)]
    print(region, domain, key, random.choice(pool))
PY
)
    return 1
}

# Fetch the provider's node list, parse it, and install it if it is sound.
#
# Routes are tried best first, and each is a different trade:
#
#   chain   the shared port, i.e. through a node that already works. The
#           ordinary case - the fetch is one more TLS connection to a node
#           the network already sees. Never the pinned exit: the token
#           would then be tied to the address that identifies you.
#   dnstt   a DNS tunnel to the provider, carried over DoH to a large public
#           resolver. On the wire it is HTTPS to that resolver and nothing
#           else - the tunnel's name is inside it - so it shows the network
#           less than Tor does. Slow, which a 30 KB list does not notice.
#   tor     for when no node works, which is also when a fresh list matters
#           most. Hides the provider's name from the network at the cost of
#           Tor's own visibility, which it has anyway.
#   direct  the last resort: the provider's name in plain sight. Taken
#           automatically, because a chain that cannot repair itself without
#           someone noticing is worse than one that shows the network once
#           what it would see at every update anyway - and announced, so it
#           is never silent.
#
# The list is installed only if it parses to at least one usable node, so a
# provider outage or an error page cannot replace a good list with nothing.
# If the set of nodes changed, the config is regenerated and sing-box
# reloaded, since the selector's members are fixed at load time.
cmd_subscribe() {
    if ! native; then
        bad "SUBSCRIPTION_URL is not set in $CONFIG"
        exit 1
    fi
    local tmp raw route via= args
    tmp=$(temp_dir vpnchain-sub) || exit 1
    raw="$tmp/raw"
    for route in chain dnstt tor direct; do
        case "$route" in
            (chain)  port_listening 127.0.0.1 "$SHARED_PORT" || continue
                     args=(--socks5-hostname "127.0.0.1:$SHARED_PORT") ;;
            (dnstt)  dnstt_available || continue
                     if dnstt_fetch "$raw"; then via=dnstt; break; fi
                     warn "fetch via dnstt failed"
                     continue ;;
            (tor)    [ -n "$TOR_PORT" ] && port_listening 127.0.0.1 "$TOR_PORT" || continue
                     args=(--socks5-hostname "127.0.0.1:$TOR_PORT") ;;
            (direct) warn "no proxied route worked - fetching directly"
                     args=(--noproxy '*') ;;
        esac
        if curl -fsS -m 90 "${args[@]}" -o "$raw" "$SUBSCRIPTION_URL" 2>/dev/null \
                && [ -s "$raw" ]; then
            via=$route
            break
        fi
        warn "fetch via $route failed"
    done
    if [ -z "$via" ]; then
        bad "could not fetch the subscription by any route"
        bad "the installed node list is untouched"
        rm -rf "$tmp"
        exit 1
    fi
    ok "fetched via $via"
    [ "$via" = direct ] && notify "Node list fetched directly - no proxied route worked"

    local summary rc
    summary=$(NODE_DNS="$NODE_DNS" OWN_NODES="$OWN_NODES_FILE" \
              python3 - "$raw" "$tmp/nodes.json" "$NODES_FILE" "$via" <<'PY'
import base64, json, os, re, sys, time, urllib.parse as up
raw_path, out_path, old_path, via = sys.argv[1:5]
raw = open(raw_path, "rb").read().strip()
try:
    text = base64.b64decode(raw + b"=" * (-len(raw) % 4)).decode()
except Exception:
    text = raw.decode("utf-8", "replace")

def family(host):
    # What one blocking rule takes out together: the registrable domain, or
    # for Workers the account's subdomain, under which every worker sits.
    labels = host.lower().split(".")
    return ".".join(labels[-3:] if host.endswith(".workers.dev") else labels[-2:])

def region(name):
    # <PREFIX>-<Region>-CDN<n>-Vless, <PREFIX>-<Region>-Reality, the prefix
    # being the provider's short name. Only a hint for the pilot's geography,
    # so an unrecognised name just goes unplaced.
    r = re.sub(r"^[A-Z]{2,4}-", "", name)
    return re.sub(r"-(CDN\d*-)?(Vless|Trojan|Reality)$", "", r, flags=re.I)

nodes, skipped, seen = [], 0, set()
for line in text.splitlines():
    u = up.urlsplit(line.strip())
    if u.scheme not in ("vless", "trojan"):
        skipped += line.strip() != ""
        continue
    q = {k: v[0] for k, v in up.parse_qs(u.query).items()}
    name = up.unquote(u.fragment) or u.hostname
    security, transport = q.get("security", "tls"), q.get("type", "tcp")
    if (not u.username or not u.hostname or security not in ("tls", "reality")
            or transport not in ("ws", "tcp")
            or (security == "reality" and not q.get("pbk"))):
        skipped += 1
        continue
    tag = name
    while tag in seen:
        tag += "'"
    seen.add(tag)
    n = {"tag": tag, "protocol": u.scheme, "server": u.hostname,
         "port": u.port or 443, "secret": up.unquote(u.username),
         "security": security, "transport": transport,
         "sni": q.get("sni") or u.hostname, "host": q.get("host", ""),
         "path": q.get("path", "/"), "family": family(u.hostname),
         "region": region(name)}
    if q.get("alpn"):
        n["alpn"] = q["alpn"].split(",")
    for k in ("flow", "fp", "pbk", "sid"):
        if q.get(k):
            n[k] = q[k]
    nodes.append(n)

if not any(n["security"] != "reality" for n in nodes):
    print("no usable nodes (%d lines skipped)" % skipped)
    sys.exit(2)

try:
    old = json.load(open(old_path))["nodes"]
except Exception:
    old = None

# Which nodes publish ECH keys - an "ech" parameter in their HTTPS record.
# For those, sing-box encrypts the node's name inside the handshake and the
# wire shows only the CDN's shared ECH name, which a censor cannot block
# without blocking ECH for every site behind that CDN.
#
# Asked over DoH, of the same resolvers that look node names up. A name
# whose lookup fails keeps what the previous list said, so a resolver hiccup
# during a fetch cannot quietly switch ECH off.
import concurrent.futures, urllib.request
JSON_DOH = {"1.1.1.1": "https://1.1.1.1/dns-query", "1.0.0.1": "https://1.0.0.1/dns-query",
            "8.8.8.8": "https://8.8.8.8/resolve", "8.8.4.4": "https://8.8.4.4/resolve"}
doh = [JSON_DOH[ip] for ip in os.environ.get("NODE_DNS", "").split() if ip in JSON_DOH] \
      or list(JSON_DOH.values())[:3:2]
opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))

def publishes_ech(host):
    for url in doh:
        try:
            req = urllib.request.Request("%s?name=%s&type=HTTPS" % (url, host),
                                         headers={"accept": "application/dns-json"})
            with opener.open(req, timeout=8) as r:
                ans = json.load(r)
            if ans.get("Status") not in (0, 3):
                continue
            return any(a.get("type") == 65 and "ech=" in a.get("data", "")
                       for a in ans.get("Answer", []))
        except Exception:
            continue
    return None

was = {n["server"]: n.get("ech") for n in old or []}
hosts = sorted({n["server"] for n in nodes if n["security"] == "tls"})
with concurrent.futures.ThreadPoolExecutor(8) as pool:
    found = dict(zip(hosts, pool.map(publishes_ech, hosts)))

# Reality nodes are dialled by address (see the generator), so their address
# is recorded here, over the same DoH. A failed lookup keeps the old one:
# this is exactly what has to survive a network where lookups do not.
def address_of(host):
    for url in doh:
        try:
            req = urllib.request.Request("%s?name=%s&type=A" % (url, host),
                                         headers={"accept": "application/dns-json"})
            with opener.open(req, timeout=8) as r:
                ans = json.load(r)
            ips = [a["data"] for a in ans.get("Answer", []) if a.get("type") == 1]
            if ips:
                return ips[0]
        except Exception:
            continue
    return None

was_ip = {n["server"]: n.get("ip") for n in old or []}
for n in nodes:
    if n["security"] == "reality":
        ip = address_of(n["server"]) or was_ip.get(n["server"])
        if ip:
            n["ip"] = ip
for n in nodes:
    if n["security"] != "tls":
        continue
    ech = found.get(n["server"])
    if ech is None:
        ech = was.get(n["server"])
    if ech:
        n["ech"] = True

# Nodes of your own, run outside the subscription, kept in the same list so
# that everything reading it - the generator, the pilot, the status server -
# treats them like any other. Merged here as well as at config time, so a
# fetch that changed nothing compares as unchanged.
try:
    nodes += json.load(open(os.environ["OWN_NODES"]))["nodes"]
except (KeyError, OSError, ValueError):
    pass
fd = os.open(out_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as f:
    json.dump({"fetched_at": int(time.time()), "via": via, "nodes": nodes}, f, indent=1)
fams = len({n["family"] for n in nodes})
print("%d nodes in %d families, %d with ECH%s; %s" % (
    len(nodes), fams, sum(1 for n in nodes if n.get("ech")),
    ", %d skipped" % skipped if skipped else "",
    "unchanged" if old == nodes else "changed"))
PY
)
    rc=$?
    if [ "$rc" != 0 ]; then
        bad "subscription did not parse: $summary"
        bad "the installed node list is untouched"
        rm -rf "$tmp"
        exit 1
    fi
    ok "$summary"

    mkdir -p "$(dirname "$NODES_FILE")"
    # Installed even when unchanged, so fetched_at records the last success.
    mv "$tmp/nodes.json" "$NODES_FILE" || { rm -rf "$tmp"; exit 1; }
    rm -rf "$tmp"
    case "$summary" in
        (*unchanged) return 0 ;;
    esac
    # Only a config that is already native is refreshed here. Moving from an
    # upstream proxy to native mode is a cutover - the other core has to let
    # go of the shared port first - so it stays an explicit 'vpnchain config gen'.
    if live_config_native; then
        cmd_config
        if agent_running; then
            agent_restart "$SINGBOX_AGENT" "$PLIST"
            ok "sing-box reloaded with the new node list"
        fi
    elif [ -f "$SINGBOX_CONFIG" ]; then
        warn "the live config still uses an upstream proxy; switch with:"
        echo "           vpnchain config gen && vpnchain restart"
        echo "         once nothing else holds port $SHARED_PORT"
    fi
}

live_config_native() {
    grep -q '"shared-in"' "$SINGBOX_CONFIG" 2>/dev/null
}

# In native mode sing-box takes the shared port, which is the port a separate
# proxy core used to hold. If something still holds it, sing-box would exit
# at once and launchd would restart it forever, with the browser on no
# tunnel - so refuse up front, and say why.
shared_port_blocked() {
    native && live_config_native || return 1
    port_listening 127.0.0.1 "$SHARED_PORT" || return 1
    # Held - by sing-box itself, which is fine, or by anything else.
    local pid
    for pid in $(pgrep -f 'sing-box run'); do
        lsof -nP -a -p "$pid" -iTCP:"$SHARED_PORT" -sTCP:LISTEN >/dev/null 2>&1 \
            && return 1
    done
    return 0
}

refuse_if_port_blocked() {
    shared_port_blocked || return 0
    bad "port $SHARED_PORT is held by another program - stop it first"
    bad "(the proxy core this config replaces, if it is still running)"
    exit 1
}

# Any failure after the backup is taken must put the old config back, or a
# half-written one is left in place for the next start to trip over.
restore_config_backup() {
    if [ -f "$SINGBOX_CONFIG.bak" ]; then
        mv "$SINGBOX_CONFIG.bak" "$SINGBOX_CONFIG"
        warn "previous config restored"
    fi
}

# Writes a known-good config from the env file. Deliberately a separate verb
# rather than something start does implicitly: regenerating wholesale discards
# any routing rules added by hand, which should be a decision rather than a
# surprise. Runtime toggles stay surgical for the same reason.
cmd_config() {
    local v missing=()
    for v in WG_PRIVATE_KEY WG_ADDRESS WG_PEER_PUBLIC_KEY WG_PEER_HOST WG_PEER_PORT; do
        [ -z "${!v:-}" ] && missing+=("$v")
    done
    if [ "${#missing[@]}" -gt 0 ]; then
        bad "cannot generate - missing in $CONFIG:"
        printf '         %s\n' "${missing[@]}"
        exit 1
    fi

    # Preserve whichever mode is already in effect; generating should not
    # silently move you between concealment postures.
    local mode
    mode=$(singbox_mode)
    [ "$mode" = unknown ] && mode=chained
    ok "generating a $mode config"

    mkdir -p "$(dirname "$SINGBOX_CONFIG")"
    if [ -f "$SINGBOX_CONFIG" ]; then
        cp -p "$SINGBOX_CONFIG" "$SINGBOX_CONFIG.bak"
        ok "previous config saved as $(basename "$SINGBOX_CONFIG").bak"
        warn "hand-added routing rules are NOT carried over; merge them back"
        warn "from the backup if you had any"
    fi

    generate_config "$SINGBOX_CONFIG" "$mode" || {
        restore_config_backup; bad "generation failed"; exit 1; }

    if ! sing-box check -c "$SINGBOX_CONFIG" 2>&1; then
        bad "generated config failed validation"
        restore_config_backup
        exit 1
    fi
    ok "config written and valid: $SINGBOX_CONFIG"
    # Only worth saying when something is already running the old one; during
    # bootstrap the caller starts the agent immediately after this.
    agent_running && echo "         apply it with: vpnchain reload"
}

# Renders the config implied by the env file to $1. Kept separate from
# cmd_config so status can render to a temp file and compare, which is how
# drift between the env file and the live config gets noticed.
generate_config() {
    local out="$1" mode="$2" native_nodes=
    if native; then
        if [ ! -s "$NODES_FILE" ]; then
            bad "no node list at $NODES_FILE - fetch it with: vpnchain subscribe"
            return 1
        fi
        merge_own_nodes || return 1
        native_nodes="$NODES_FILE"
        clash_secret >/dev/null || return 1
    fi
    NODES="$native_nodes" SHARED_PORT="$SHARED_PORT" NODE_DNS="$NODE_DNS" \
    NODE_DNS_CHOICE="$(cat "$NODE_DNS_STATE" 2>/dev/null)" \
    CLASH_PORT="$CLASH_PORT" CLASH_SECRET="$(native && clash_secret)" \
    CACHE_PATH="$(dirname "$SINGBOX_CONFIG")/cache.db" \
    MODE="$mode" P_HOST="$PROXY_HOST" P_PORT="$PROXY_PORT" \
    U_PORT="$INCOGNITO_PORT" UP_HOST="$UPSTREAM_HOST" \
    UP_PORT="$UPSTREAM_PORT" UP_TAG="$UPSTREAM_TAG" \
    WG_MTU="${WG_MTU:-1390}" WG_DNS="${WG_DNS:-8.8.8.8}" \
    WG_PRIVATE_KEY="$WG_PRIVATE_KEY" WG_ADDRESS="$WG_ADDRESS" \
    WG_PEER_PUBLIC_KEY="$WG_PEER_PUBLIC_KEY" \
    WG_PEER_HOST="$WG_PEER_HOST" WG_PEER_PORT="$WG_PEER_PORT" \
    BL="$(blocklist_active && echo "$BLOCKLIST_PATH")" \
    KEEP_OUT="$KEEP_OUT_COUNTRIES" KEEP_OUT_DIR="$KEEP_OUT_DIR" \
    KEEP_OUT_TLDS="$(for cc in $KEEP_OUT_COUNTRIES; do keep_out_tlds "$cc"; done)" \
    TOR_PORT="$TOR_PORT" I2P_PORT="$I2P_PORT" \
    OUT="$out" \
    python3 - <<'PY' || { restore_config_backup; bad "generation failed"; exit 1; }
import json, os
e = os.environ

def node_outbound(n):
    """One subscription node as a sing-box outbound.

    The TLS fingerprint is chosen here rather than taken from the link: the
    provider ships none for its CDN nodes, which leaves the Go library's own
    ClientHello on the wire - a known tell. Reality links carry their own,
    and for Reality it has to match what the server expects, so it is kept."""
    o = {"type": n["protocol"], "tag": n["tag"],
         "server": n["server"], "server_port": n["port"]}
    # A Reality node is dialled by its stored address when there is one:
    # nothing about it has to be looked up, so poisoned or blocked DNS cannot
    # misdirect it and no plain query names it to the network. Its visible
    # server name is the cover site's, set below, never this one.
    if n["security"] == "reality" and n.get("ip"):
        o["server"] = n["ip"]
    if n["protocol"] == "vless":
        o["uuid"] = n["secret"]
        # XUDP is what carries the WireGuard UDP through the node; measured
        # working through every node family, Workers included.
        o["packet_encoding"] = "xudp"
        if n.get("flow"):
            o["flow"] = n["flow"]
    else:
        o["password"] = n["secret"]
    tls = {"enabled": True, "server_name": n["sni"]}
    if n["security"] == "reality":
        tls["utls"] = {"enabled": True, "fingerprint": n.get("fp") or "chrome"}
        tls["reality"] = {"enabled": True, "public_key": n["pbk"],
                          "short_id": n.get("sid", "")}
    else:
        tls["alpn"] = n.get("alpn") or ["http/1.1"]
        tls["utls"] = {"enabled": True, "fingerprint": "chrome"}
        # The node's name goes inside the handshake, encrypted, and the
        # wire shows the CDN's shared ECH name instead. sing-box fetches the
        # key from the node's HTTPS record when it dials, so it follows the
        # CDN's key rotation without a regenerate.
        if n.get("ech"):
            tls["ech"] = {"enabled": True}
    o["tls"] = tls
    if n["transport"] == "ws":
        o["transport"] = {"type": "ws", "path": n.get("path") or "/",
                          "headers": {"Host": n.get("host") or n["sni"]}}
    # A node marked "multiplex" - one of your own, where both ends run
    # sing-box - carries everything in one padded multiplexed connection
    # instead of Vision. Vision pads TLS carried inside the tunnel; this one
    # carries WireGuard, whose handshake and keepalive sizes would otherwise
    # show through, and padding the whole stream is what hides them. It also
    # reuses the one connection, which measured faster than Vision here.
    if n.get("multiplex"):
        o.pop("flow", None)
        o.pop("packet_encoding", None)
        o["multiplex"] = {"enabled": True, "protocol": "h2mux",
                          "max_connections": 1, "padding": True}
    return o

nodes = []
if e.get("NODES"):
    nodes = json.load(open(e["NODES"]))["nodes"]

# The upstream everything detours through. In chained-reality mode the
# selector is named "reality", which is how the mode reads back out of the
# config - and how the pilot knows to put the Reality node first.
up = "reality" if e["MODE"] == "chained-reality" else e["UP_TAG"]

wg = {
    "type": "wireguard", "tag": "tunnel", "system": False,
    "mtu": int(e["WG_MTU"]),
    "address": [e["WG_ADDRESS"]],
    "private_key": e["WG_PRIVATE_KEY"],
    "peers": [{
        "address": e["WG_PEER_HOST"],
        "port": int(e["WG_PEER_PORT"]),
        "public_key": e["WG_PEER_PUBLIC_KEY"],
        "allowed_ips": ["0.0.0.0/0"],
        "persistent_keepalive_interval": 25,
    }],
}
if e["MODE"] in ("chained", "chained-reality"):
    wg["detour"] = up

cfg = {
    "log": {"level": "info", "timestamp": True},
    # Names for the incognito inbound resolve through the upstream too.
    # Resolving them through the tunnel would have the site see one origin
    # while its authoritative DNS saw another.
    "dns": {
        "servers": [
            {"type": "udp", "tag": "tunnel-dns",
             "server": e["WG_DNS"], "detour": "tunnel"},
            {"type": "udp", "tag": "upstream-dns",
             "server": e["WG_DNS"], "detour": up},
        ],
        "rules": [{"inbound": ["upstream-in"], "server": "upstream-dns"}],
        "final": "tunnel-dns",
        "strategy": "ipv4_only",
    },
    "inbounds": [
        {"type": "mixed", "tag": "pinned-in",
         "listen": e["P_HOST"], "listen_port": int(e["P_PORT"])},
        {"type": "mixed", "tag": "upstream-in",
         "listen": e["P_HOST"], "listen_port": int(e["U_PORT"])},
    ],
    "endpoints": [wg],
    # Replaced below by the nodes and their selector in native mode, where
    # there is no upstream port to point at.
    "outbounds": [] if nodes else [
        {"type": "socks", "tag": up, "server": e["UP_HOST"],
         "server_port": int(e["UP_PORT"]), "version": "5"},
    ],
    # Only web traffic leaves by the pinned address - TLS and plain HTTP,
    # which is all the browser it is pinned to ever speaks. That address is
    # the one that identifies you, and a client mistakenly pointed at the
    # pinned inbound is refused instead of quietly using it. Matching
    # BitTorrent by name was not enough: a client that requires encryption
    # sends nothing a sniffer can recognise, and walked straight past.
    # Anything not recognisably web is refused instead.
    #
    # Sniffing waits for the client's first bytes, so server-first protocols
    # pay its timeout once per connection; browsers speak first and do not.
    "route": {
        "rules": [
            {"inbound": ["pinned-in"], "action": "sniff"},
            {"type": "logical", "mode": "and", "action": "reject",
             "rules": [{"inbound": ["pinned-in"]},
                       {"protocol": ["tls", "http"], "invert": True}]},
            {"inbound": ["upstream-in"], "action": "route",
             "outbound": up},
        ],
        "final": "tunnel",
    },
}

# Native mode: the SOCKS hop to a separate core is replaced by the nodes
# themselves, behind one selector under the same tag, so everything that
# detoured through the upstream - the WireGuard endpoint, the incognito
# inbound, its DNS - now goes through whichever node the selector holds.
if nodes:
    # Each mode holds its own kind of node and no other: chained the CDN
    # nodes - ECH on those whose CDN publishes keys, and the pilot keeps to
    # those while any answers - chained-reality the Reality ones. Neither
    # falls back on the other: moving between them is a decision, made with
    # 'vpnchain restart <mode>'. So the Reality node is never seen until it is
    # the one in use. Direct mode's other ports use the chained set.
    want_reality = e["MODE"] == "chained-reality"
    nodes = [n for n in nodes if (n["security"] == "reality") == want_reality]
    if not nodes:
        raise SystemExit("the subscription has no %s node for %s mode" % (
            "Reality" if want_reality else "CDN", e["MODE"]))
    tags = [n["tag"] for n in nodes]
    # A switch closes what the old node carried. Without that the WireGuard
    # flow - one UDP association that its keepalive never lets end - would
    # stay on a dead node forever. Connections INSIDE the tunnel survive,
    # since WireGuard simply follows its peer onto the new path; only direct
    # users of the shared and incognito ports see a reset, and switches are
    # rare by design.
    cfg["outbounds"] = [node_outbound(n) for n in nodes] + [
        {"type": "selector", "tag": up, "outbounds": tags,
         "default": tags[0], "interrupt_exist_connections": True}]
    # Node names are resolved over DoH to a server named by address, so the
    # lookup needs no lookup of its own and the names never cross the wire as
    # plain DNS. They still appear in each node's TLS server name - nothing
    # here can hide that - but no longer in a resolver's log as well.
    #
    # Every candidate is defined, so the pilot's choice needs only this one
    # line to change. "local" is the system resolver: plain DNS, and the last
    # resort for a network that blocks every DoH server listed.
    choices = e["NODE_DNS"].split() + ["local"]
    for ip in e["NODE_DNS"].split():
        cfg["dns"]["servers"].append(
            {"type": "https", "tag": "node-dns-" + ip, "server": ip})
    cfg["dns"]["servers"].append({"type": "local", "tag": "node-dns-local"})
    chosen = e.get("NODE_DNS_CHOICE", "").strip()
    cfg["route"]["default_domain_resolver"] = "node-dns-" + (
        chosen if chosen in choices else choices[0])
    # The port other programs used to give the separate core. Torrents are
    # welcome here: this is the shared exit, not the pinned address.
    cfg["inbounds"].append(
        {"type": "mixed", "tag": "shared-in", "listen": e["P_HOST"],
         "listen_port": int(e["SHARED_PORT"])})
    # Except in chained-reality mode, where everything rides one Reality
    # server: torrents there would be dozens of busy parallel connections to
    # a single address presenting itself as the cover site - the pattern the
    # networks that mode is for look for when hunting Reality servers, and
    # the way to lose the one node that works there.
    #
    # Refused outright, not filtered: nothing of yours needs the shared port
    # in that mode, and filtering by protocol failed - a torrent client that
    # requires encryption is unrecognisable and got through. i2pd, which
    # would also fan out through it, is stopped on the switch as well.
    if want_reality:
        cfg["route"]["rules"].append({"inbound": ["shared-in"], "action": "reject"})
    cfg["route"]["rules"].append(
        {"inbound": ["shared-in"], "action": "route", "outbound": up})
    # The incognito browser exists to be unlinked from you, so in
    # chained-reality mode it never goes through a node of your own - that
    # address is yours alone, and its host knows who rents it. It uses the
    # subscription's Reality nodes, in a group of their own that picks a
    # working one by itself; with none, it is refused rather than allowed
    # onto your node.
    if want_reality:
        public = [n["tag"] for n in nodes
                  if not str(n.get("family", "")).startswith("own:")]
        rule = next(r for r in cfg["route"]["rules"]
                    if r.get("inbound") == ["upstream-in"])
        dns_rule = next(r for r in cfg["dns"]["rules"]
                        if r.get("inbound") == ["upstream-in"])
        if public:
            cfg["outbounds"].append(
                {"type": "urltest", "tag": "reality-public", "outbounds": public,
                 "url": "https://www.gstatic.com/generate_204",
                 "interval": "10m", "idle_timeout": "30m"})
            rule["outbound"] = "reality-public"
            next(s for s in cfg["dns"]["servers"]
                 if s["tag"] == "upstream-dns")["detour"] = "reality-public"
        else:
            rule.pop("outbound", None)
            rule["action"] = "reject"
            dns_rule.pop("server", None)
            dns_rule["action"] = "reject"
    cfg["experimental"] = {
        # What the pilot steers through. Loopback only, and the secret is what
        # keeps a web page - which can reach loopback - from steering it.
        "clash_api": {"external_controller": "127.0.0.1:%s" % e["CLASH_PORT"],
                      "secret": e["CLASH_SECRET"]},
        # Remembers the selector's choice across restarts.
        "cache_file": {"enabled": True, "path": e["CACHE_PATH"]},
    }

# Names the ordinary network cannot reach, handed to the daemon that can.
#
# Ahead of the per-inbound rule, because that one sends everything from the
# incognito inbound to the upstream and would claim these first. Behind the
# blocklist reject, which inserts itself at the front afterwards.
#
# The DNS reject is not belt-and-braces for its own sake. There is nothing to
# resolve for either suffix, so a lookup can only ever fail - but it fails at
# a resolver that now knows which hidden service was being asked for. This
# makes the attempt impossible rather than merely useless.
for _tag, _port, _suffix in (("tor", e.get("TOR_PORT"), ".onion"),
                             ("i2p", e.get("I2P_PORT"), ".i2p")):
    if not _port:
        continue
    cfg["outbounds"].append({
        "type": "socks", "tag": _tag, "server": "127.0.0.1",
        "server_port": int(_port), "version": "5",
    })
    cfg["route"]["rules"].insert(
        0, {"domain_suffix": [_suffix], "action": "route", "outbound": _tag})
    cfg["dns"]["rules"].insert(
        0, {"domain_suffix": [_suffix], "action": "reject"})

# Tracker rejection, when a converted list is installed. Both rules go FIRST:
# the DNS rules that follow pick a server per inbound, and the route rules that
# follow pick an outbound per inbound, so a reject placed after either would
# only cover one of the two exits. Placed first, it covers both.
#
# Rejecting in DNS alone would be enough almost always, since a name that does
# not resolve is never dialled. The route rule covers what DNS cannot: a
# cached answer, a literal address, or an HTTP/3 alt-svc target the browser
# already holds. Two cheap rules, no ordering subtlety between them.
bl = e.get("BL") or ""
if bl:
    cfg["dns"]["rules"].insert(0, {"rule_set": "blocklist", "action": "reject"})
    cfg["route"]["rule_set"] = [{"type": "local", "tag": "blocklist",
                                 "format": "binary", "path": bl}]
    cfg["route"]["rules"].insert(0, {"rule_set": "blocklist", "action": "reject"})

# KEEP_OUT_COUNTRIES, on the pinned port alone. The TLDs need no file; the
# lists join once 'vpnchain get-blocklist' has fetched them, since sing-box will
# not start on a missing local rule-set. Address ranges can only match an
# address, and the browser hands over names, so the name is resolved first -
# through the same DNS the tunnel would use for it a moment later anyway.
# Except .onion and .i2p, which must never reach a resolver at all.
tlds = e.get("KEEP_OUT_TLDS", "").split()
if tlds:
    keep = [{"inbound": ["pinned-in"], "domain_suffix": tlds, "action": "reject"}]
    sets = {"geosite": [], "geoip": []}
    for cc in e.get("KEEP_OUT", "").split():
        for kind in sets:
            path = os.path.join(e["KEEP_OUT_DIR"], "%s-%s.srs" % (kind, cc))
            if os.path.isfile(path) and os.path.getsize(path):
                tag = "keep-out-%s-%s" % (kind, cc)
                cfg["route"].setdefault("rule_set", []).append(
                    {"type": "local", "tag": tag, "format": "binary", "path": path})
                sets[kind].append(tag)
    if sets["geosite"]:
        keep.append({"inbound": ["pinned-in"], "rule_set": sets["geosite"],
                     "action": "reject"})
    if sets["geoip"]:
        keep += [
            {"type": "logical", "mode": "and", "action": "resolve",
             "rules": [{"inbound": ["pinned-in"]},
                       {"domain_suffix": ["onion", "i2p"], "invert": True}]},
            {"inbound": ["pinned-in"], "rule_set": sets["geoip"],
             "action": "reject"},
        ]
    cfg["route"]["rules"][0:0] = keep

# Every lookup of a node's name - its address and, for ECH, its key - goes
# to the node resolver, ahead of every other rule. Without this an ECH key
# lookup takes the DNS default, which in chained mode resolves through the
# tunnel: through a node, which cannot be dialled until the lookup is done.
# Measured: ten seconds and a failed connection, every time.
if nodes:
    cfg["dns"]["rules"].insert(0, {
        "domain": sorted({n["server"] for n in nodes}),
        "server": cfg["route"]["default_domain_resolver"]})

out = e["OUT"]
with open(out, "w") as f:
    json.dump(cfg, f, indent=2)
    f.write("\n")
os.chmod(out, 0o600)   # it holds the private key
PY
}

# true when every value the generator needs is present
have_wg_creds() {
    local v
    for v in WG_PRIVATE_KEY WG_ADDRESS WG_PEER_PUBLIC_KEY WG_PEER_HOST WG_PEER_PORT; do
        [ -z "${!v:-}" ] && return 1
    done
    return 0
}

# The pid of the incognito browser, or nothing.
#
# The profile path is the precise match: only our own launch names it on a
# command line. The binary is a fallback for the case where the bundle re-execs
# and the argv we passed does not survive into the running process - a false
# negative there would report a launch that worked as a failure. It is NOT
# used for the already-running gate, since it would also match an instance
# started from the Dock, which holds no proxy and which -no-remote keeps
# separate from ours anyway.
incognito_pid() {
    local pid
    pid=$(pgrep -f "$INCOGNITO_PROFILE" 2>/dev/null | head -1)
    [ -z "$pid" ] && pid=$(pgrep -f "$INCOGNITO_BIN" 2>/dev/null | head -1)
    printf '%s\n' "$pid"
}

# The incognito browser. Everything this configures lives in the profile it
# is about to be handed, so unlike the pinned launch there is no global state
# to relax, no trap, and nothing to put back afterwards.
launch_incognito() {
    local v pid
    for v in "${RETIRED_VARS[@]}"; do
        [ -n "${!v:-}" ] && warn "$v is set but no longer does anything - see the header"
    done

    if [ -z "$INCOGNITO_BIN" ] || [ ! -x "$INCOGNITO_BIN" ]; then
        if [ "$OS" = mac ]; then
            bad "no browser executable inside $INCOGNITO_APP"
            echo "         install it:  brew install --cask mullvad-browser"
            echo "         or point INCOGNITO_APP at the bundle you want"
        else
            bad "mullvad-browser is not on PATH"
            echo "         install it from https://mullvad.net/download/browser/linux"
            echo "         or point INCOGNITO_BIN at the executable you want"
        fi
        exit 1
    fi

    # A second launch hands off to the running instance and this one's prefs
    # are silently discarded, so report that rather than a launch that did
    # not happen. Wiping the profile under a running instance is also how you
    # corrupt it.
    pid=$(pgrep -f "$INCOGNITO_PROFILE" | head -1)
    if [ -n "$pid" ]; then
        warn "an instance is ALREADY running on this profile (pid $pid)"
        warn "it keeps the proxy it started with - quit it and rerun to change"
        return 0
    fi

    # Wiped rather than reused: the fingerprint has to be the stock one every
    # time, and nothing from the last session should be able to link to this
    # one. The marker is what makes rm -rf safe here - a mistyped path will
    # not have one, so it is refused instead of erased.
    if [ -e "$INCOGNITO_PROFILE" ]; then
        if [ ! -f "$INCOGNITO_PROFILE/$INCOGNITO_MARKER" ]; then
            bad "$INCOGNITO_PROFILE was not created by vpnchain"
            echo "         refusing to wipe it - point INCOGNITO_PROFILE elsewhere"
            exit 1
        fi
        rm -rf "$INCOGNITO_PROFILE"
    fi
    if ! mkdir -p "$INCOGNITO_PROFILE"; then
        bad "could not create $INCOGNITO_PROFILE"
        exit 1
    fi
    local launch_id="$$-$(date +%s)"
    printf '%s\n' "$launch_id" > "$INCOGNITO_PROFILE/$INCOGNITO_MARKER"
    ok "fresh profile: $INCOGNITO_PROFILE"

    # The startup page is the dashboard, since the facts that matter for
    # this instance - the exit it came out at, the clock, whether WebRTC
    # leaks - are measurable only from inside the browser. The SERVED copy
    # rather than the file: same origin as status.json, so the page can read
    # the host-side status, including the measured address of this exit; from
    # a file:// origin that fetch is cross-origin and the page would report a
    # browser behaving exactly as intended as being on the wrong exit.
    #
    # Loopback is exempt from the proxy (and from HTTPS-only), so this is
    # reachable from a browser whose every other request goes to SOCKS.
    # The fragment rather than the server's copy, so the check survives a
    # status server that is down, and so REAL_ADDRESS=auto - which only this
    # launch knows the answer to - reaches the page at all.
    local dash real frag=
    real=$(real_address)
    if [ -n "$real" ]; then
        frag="#real=$real"
        [ "$REAL_ADDRESS" = auto ] &&
            warn "asked the network directly for this machine's own address: $real"
        ok "dashboard will check the exit against $real"
    else
        case "$REAL_ADDRESS" in
            (off|none|no) ok "not measuring this machine's own address (REAL_ADDRESS=$REAL_ADDRESS)" ;;
            (*)           warn "could not determine this machine's own address" ;;
        esac
        warn "the page cannot tell an unproxied browser from an upstream node"
        warn "it has not seen before"
    fi

    if [ -n "$STATUSD_AGENT" ]; then
        dash="http://127.0.0.1:$STATUS_PORT/$frag"
        statusd_running || warn "status server is not running - the startup page will not load"
    else
        # No server configured, so the page cannot be served and cannot read
        # host status either. The expectation has to come from the fragment,
        # and the Chain section will be empty.
        dash="file://$DASHBOARD_PAGE#expect=$EXPECTED_EXIT_IP${frag:+&real=$real}"
        warn "no STATUSD_AGENT - the startup page cannot show host-side status"
    fi

    # user.js is re-read at every startup, so this file is the entire
    # configuration of the instance. Only the proxy and the startup page
    # belong in it - see the header on why anything else is a step backwards.
    cat > "$INCOGNITO_PROFILE/user.js" <<EOF
// Written by vpnchain at every launch - the profile is wiped first, so
// editing this file achieves nothing. Do not add prefs: each one moves this
// instance off the fingerprint it exists to share.
user_pref("network.proxy.type", 1);
user_pref("network.proxy.socks", "$PROXY_HOST");
user_pref("network.proxy.socks_port", $INCOGNITO_PORT);
user_pref("network.proxy.socks_version", 5);
// Hostnames reach the proxy unresolved, so DNS cannot leak locally.
user_pref("network.proxy.socks_remote_dns", true);
// ICE gathers through the proxy alone, so the real address is never offered
// as a candidate. SOCKS carries no UDP, which is also why media needs TURN
// over TCP to connect at all.
user_pref("media.peerconnection.ice.proxy_only", true);
// A proxy that refuses one connection must not become a browser that
// quietly goes direct. Firefox's failover does exactly that - marks the
// proxy dead and uses the network - which here means browsing on the real
// address with every indicator still saying the chain is up. Off, so a dead
// proxy is a dead browser instead of a silent leak.
user_pref("network.proxy.failover_direct", false);
// Two different bars, both guaranteed by a profile that is new every launch.
// This one is the RFP prompt, "do you want English language versions of web
// pages": 2 answers yes, which is also the answer that keeps the shared
// fingerprint, since the alternative publishes the real locale.
user_pref("privacy.spoof_english", 2);
// This one is the "...has set your display language to..." notice, shown
// once per profile and recorded by this pref - which a wiped profile loses,
// so it greeted every launch. Not web-observable either way.
user_pref("intl.language_notification.shown", true);
// Not web-observable, so it costs nothing against the shared fingerprint.
user_pref("browser.startup.page", 1);
user_pref("browser.startup.homepage", "$dash");
EOF
    [ -n "$INCOGNITO_SEARCH" ] && set_search_policy "$INCOGNITO_SEARCH"

    # Reported here because the routing is invisible until something asks for
    # one of these names, and then it just fails.
    local _t
    for _t in "tor .onion $TOR_PORT" "i2pd .i2p $I2P_PORT"; do
        set -- $_t
        [ -z "${3:-}" ] && continue
        if port_listening 127.0.0.1 "$3"; then
            ok "$2 names routed to $1 on $3"
        else
            warn "$2 names are routed to $1 on $3, which is not listening"
        fi
    done

    ok "proxy pinned in the profile: $PROXY_HOST:$INCOGNITO_PORT (remote DNS)"
    ok "webrtc restricted to the proxy - no direct UDP, no host candidate"
    ok "startup page: $dash"

    # -no-remote so this cannot hand off to another Firefox-family process
    # and inherit its proxy; -profile so it uses this profile rather than the
    # bundle's own.
    nohup "$INCOGNITO_BIN" -no-remote -profile "$INCOGNITO_PROFILE" \
        >/dev/null 2>&1 &
    disown 2>/dev/null
    sleep 3

    pid=$(incognito_pid)
    if [ -z "$pid" ]; then
        bad "incognito browser did not come up"
        echo "         run it in the foreground to see why:"
        echo "           '$INCOGNITO_BIN' -no-remote -profile '$INCOGNITO_PROFILE'"
        exit 1
    fi

    # Wiped when it quits as well as before it starts, so between sessions
    # there is nothing on disk to find. The browser is in permanent private
    # browsing, so what lands there is profile scaffolding rather than
    # browsing data - but "not browsing data" is not the same as nothing.
    #
    # The watcher outlives this script. It ignores its own pid, since its
    # command line names the profile too, and it wipes only while the marker
    # still holds this launch's id - so a relaunch that beats it to the
    # directory cannot have the fresh profile deleted underneath it. A
    # machine that goes down with the browser open leaves the profile for
    # the next launch to wipe.
    nohup bash -c '
        prof="$1"; marker="$2"; token="$3"; me=$$
        while pgrep -f "$prof" | grep -qv "^${me}$"; do sleep 5; done
        [ "$(cat "$prof/$marker" 2>/dev/null)" = "$token" ] && rm -rf "$prof"
    ' _ "$INCOGNITO_PROFILE" "$INCOGNITO_MARKER" "$launch_id" >/dev/null 2>&1 &
    disown 2>/dev/null

    echo
    bold "applied at this launch"
    ok "incognito browser running (pid $pid)"
    ok "private browsing throughout, and the profile goes when it quits"
    warn "exit: upstream only - NOT the pinned address"
    warn "that exit is flagged as a proxy by IP databases - expect CAPTCHAs"
    ok "profile: wiped at launch, nothing carried over from last time"
    ok "fingerprint: this browser's defaults, unmodified"
    ok "timezone: fixed by resistFingerprinting - not ours to set"
    echo "         the exit and the clock are measurable only from inside"
    echo "         the browser, which is what the startup page is for"
}

cmd_browser() {
    # Flags name what you opt INTO, so the bare command cannot accidentally
    # mean "expose my real address" or "use the unlinked exit".
    local want=block exit_kind=pinned cookies=block a
    for a in "$@"; do
        case "$a" in
            "")             ;;
            with-webrtc)    want=allow ;;
            with-cookies)   cookies=allow ;;
            # exit_kind names the EXIT, which is the upstream's; the verb
            # names the instance. Chrome's incognito mode is not involved in
            # either any more - see the header.
            incognito|upstream) exit_kind=upstream ;;
            *) echo "usage: vpnchain browser [with-webrtc] [with-cookies]" >&2
               echo "       vpnchain browser incognito" >&2
               exit 1 ;;
        esac
    done

    # Dispatched before anything below touches a preference domain: launching
    # the incognito browser must not change the pinned browser's settings.
    if [ "$exit_kind" = upstream ]; then
        # Not flags on this launch but on a browser that is not involved, so
        # they have nothing to act on here.
        [ "$want" = allow ] && \
            warn "with-webrtc does not apply - webrtc already rides the proxy there"
        [ "$cookies" = allow ] && \
            warn "with-cookies does not apply - that browser keeps its own defaults"
        launch_incognito
        return
    fi

    if [ -z "$BROWSER_BIN" ] || [ ! -x "$BROWSER_BIN" ]; then
        bad "browser binary not found: ${BROWSER_BIN:-google-chrome is not on PATH}"
        exit 1
    fi
    if ! policy_ready; then
        bad "cannot write $BROWSER_POLICY_FILE"
        echo "         create it once with: vpnchain setup"
        exit 1
    fi

    # Whatever happens from here, the browser must not be left with incognito
    # available or WebRTC allowed. Restoring twice on the normal path is
    # harmless.
    trap restore_policies EXIT INT TERM

    set_hardening_policies
    ok "device APIs denied, HTTPS-only on, vendor telemetry reduced"
    ok "font, screen-layout and sensor enumeration denied"
    ok "ad topics, ad auctions and ad measurement off"
    ok "background mode off, downloads prompt for a location"
    if [ -n "$NOTIFY_ALLOW" ]; then
        ok "notifications blocked except $(printf '%s' "$NOTIFY_ALLOW" | wc -w | tr -d ' ') allowed site(s)"
    else
        ok "notifications blocked (no allowlist configured)"
    fi

    local tz="$SPOOF_TZ"
    if browser_running; then
        ok "asking the browser to quit (it will restore your session)"
        browser_quit
        local i=0
        while browser_running && [ "$i" -lt 60 ]; do
            sleep 0.25
            i=$((i + 1))
        done
        if browser_running; then
            bad "browser is still running - it may be holding an unsaved prompt"
            bad "launching now would just hand off to the existing process and"
            bad "change nothing, so stopping here. Quit it manually and retry."
            exit 1
        fi
        ok "browser quit"
    else
        ok "browser was not running"
    fi

    # Policies are read at startup, so they have to be in place before the
    # launch. Both are global to the preference domain, which is why they are
    # set here either way and put back immediately afterwards.
    set_webrtc "$want"
    [ "$want" = block ] && ok "webrtc policy set to block" \
                        || warn "webrtc policy relaxed for this launch"

    if [ "$cookies" = block ]; then
        set_cookie_policy true
        ok "third-party cookies blocked"
    else
        set_cookie_policy false
        warn "third-party cookies allowed for this launch"
    fi

    set_incognito_policy "$INCOGNITO_OFF"
    ok "incognito disabled (it would not change the exit address)"

    # The proxy is pinned to this launch rather than set system-wide, so the
    # scope is exactly this browser and nothing else on the machine is touched.
    # Chrome still hands over hostnames rather than pre-resolving, so remote
    # DNS - and therefore no DNS leak - is preserved.
    local bpid
    local proxy_flag="--proxy-server=socks5://$PROXY_HOST:$PROXY_PORT"
    ok "proxy pinned to this launch: $PROXY_HOST:$PROXY_PORT"
    if [ -n "$tz" ]; then
        ok "launching with TZ=$tz"
        TZ="$tz" nohup "$BROWSER_BIN" "$proxy_flag" >/dev/null 2>&1 &
    else
        warn "no timezone configured - launching with the system timezone"
        nohup "$BROWSER_BIN" "$proxy_flag" >/dev/null 2>&1 &
    fi
    bpid=$!
    disown 2>/dev/null
    sleep 3

    if browser_running; then
        ok "browser started (pid $bpid)"
    else
        bad "browser did not come up"
    fi

    # Put the protective policy back immediately. The running browser already
    # read the relaxed one and keeps it for its lifetime, so the exposure is
    # scoped to this session and the next launch is protected by default -
    # no timer, nothing to remember.
    if [ "$cookies" = allow ]; then
        set_cookie_policy true
        echo
        ok "cookie policy restored to blocking"
        echo "         this browser keeps them until you quit it"
    fi

    if [ "$want" = allow ]; then
        set_webrtc block
        echo
        warn "on-disk policy restored to block"
        warn "THIS browser keeps direct UDP until you quit it - any page in it"
        warn "can read your real address. The next launch is protected again."
        echo "         caveat: if the browser re-reads policy mid-session it"
        echo "         may pick up the restored block and drop WebRTC."
    fi

    echo
    bold "applied at this launch"
    ok "exit: the pinned address"
    ok "incognito: unavailable in this browser"
    [ "$cookies" = block ] && ok "third-party cookies: blocked" \
                           || bad "third-party cookies: ALLOWED - cross-site linking possible"
    if [ "$want" = block ]; then
        ok "webrtc: BLOCKED"
    else
        bad "webrtc: ALLOWED - real address exposed to any page in this browser"
    fi
    if [ -n "$tz" ]; then
        ok "timezone: $tz"
        echo "         confirm with vpnchain-dashboard.html - it measures the"
        echo "         main thread, a Worker and an iframe, which is what"
        echo "         distinguishes a real spoof from a cosmetic one"
    else
        warn "timezone: system default"
    fi
}

# One-time preparation that needs root, kept out of every other verb so that
# nothing else ever asks for sudo. On macOS there is none: the policies live in
# the user's own preference domain.
cmd_setup() {
    if [ "$OS" = mac ]; then
        ok "no policy file on macOS - policies go to the $BROWSER_DOMAIN domain"
        return 0
    fi
    if policy_ready; then
        ok "$BROWSER_POLICY_FILE exists and is writable"
    else
        local dir
        dir=$(dirname "$BROWSER_POLICY_FILE")
        bold "creating $BROWSER_POLICY_FILE (asks for sudo once)"
        sudo install -d -m 755 "$dir" &&
            sudo sh -c 'f="$1"; [ -s "$f" ] || printf "{}\n" > "$f"' _ "$BROWSER_POLICY_FILE" &&
            sudo chown "$(id -un)" "$BROWSER_POLICY_FILE" &&
            sudo chmod 644 "$BROWSER_POLICY_FILE" || {
                bad "could not create it"; exit 1; }
        ok "$BROWSER_POLICY_FILE is yours - launches rewrite it without sudo"
    fi
    # Policies the browser should hold even before the first launch.
    set_hardening_policies
    restore_policies
    ok "hardening policies written"
    if [ -n "$SINGBOX_AGENT" ] && ensure_singbox_agent; then
        ok "sing-box unit: $PLIST"
    fi
    if command -v loginctl >/dev/null && \
       [ "$(loginctl show-user "$(id -un)" -p Linger --value 2>/dev/null)" != yes ]; then
        warn "user units stop when you log out; to keep the chain up, run:"
        echo "           sudo loginctl enable-linger $(id -un)"
    fi
}

# A shell on one of your own nodes, carried by the node's own Reality inbound
# rather than a port of its own, so the node needs nothing open but 443. A
# private sing-box of its own does the carrying - not the agent, which may be
# down, in another mode, or the very thing being repaired.
cmd_ssh_reality() {
    command -v sing-box >/dev/null 2>&1 || {
        bad "sing-box not found - $(install_hint sing-box sing-box)"; exit 1; }
    local dir info tag ip port user key
    dir=$(mktemp -d "${TMPDIR:-/tmp}/vpnchain-ssh.XXXXXX") || exit 1
    # Globals, not locals: the trap runs after this function has returned.
    SSH_DIR=$dir SSH_PID=""
    trap '[ -n "$SSH_PID" ] && kill "$SSH_PID" 2>/dev/null; rm -rf "$SSH_DIR"' EXIT
    # Prints "tag ip port user key" and writes the config. The first argument
    # names the node when it is one's tag; otherwise it belongs to ssh.
    info=$(python3 - "$OWN_NODES_FILE" "$dir/config.json" "${1:-}" <<'PY'
import json, os, socket, sys
own_path, out, want = sys.argv[1:4]
try:
    nodes = json.load(open(own_path))["nodes"]
except (OSError, ValueError, KeyError):
    sys.exit(f"no own nodes in {own_path}")
n = next((n for n in nodes if n["tag"] == want), None) or nodes[0]
with socket.socket() as s:
    s.bind(("127.0.0.1", 0))
    port = s.getsockname()[1]
out_ = {"type": "vless", "tag": "node", "server": n["ip"], "server_port": n.get("port", 443),
        "uuid": n["secret"],
        "tls": {"enabled": True, "server_name": n["sni"],
                "utls": {"enabled": True, "fingerprint": n.get("fp") or "chrome"},
                "reality": {"enabled": True, "public_key": n["pbk"], "short_id": n["sid"]}}}
if n.get("multiplex"):
    out_["multiplex"] = {"enabled": True, "protocol": "h2mux", "max_connections": 1, "padding": True}
elif n.get("flow"):
    out_["flow"] = n["flow"]
# The node dials its own sshd on loopback, which only the owner's user may.
cfg = {"log": {"level": "error"},
       "inbounds": [{"type": "direct", "listen": "127.0.0.1", "listen_port": port,
                     "override_address": "127.0.0.1", "override_port": 22}],
       "outbounds": [out_]}
fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
with os.fdopen(fd, "w") as f:
    json.dump(cfg, f)
key = os.path.expanduser(n["ssh_key"]) if n.get("ssh_key") else "-"
print(n["tag"], n["ip"], port, n.get("ssh_user") or "root", key)
PY
    ) || exit 1
    read -r tag ip port user key <<<"$info"
    [ "$tag" = "${1:-}" ] && shift
    sing-box run -c "$dir/config.json" >"$dir/log" 2>&1 &
    SSH_PID=$!
    local i
    for i in $(seq 50); do
        port_listening 127.0.0.1 "$port" && break
        kill -0 "$SSH_PID" 2>/dev/null || break
        sleep 0.1
    done
    port_listening 127.0.0.1 "$port" || {
        bad "sing-box did not come up for $tag"; cat "$dir/log" >&2; exit 1; }
    # The host key is filed under the node's address, not the loopback end.
    local -a opts=(-p "$port" -o HostKeyAlias="$ip")
    [ "$key" != - ] && opts+=(-i "$key" -o IdentitiesOnly=yes)
    ssh "${opts[@]}" "$user@127.0.0.1" "$@"
}

# Rendering what the env file describes and diffing it is the one check the
# status server deliberately does not do - a second copy of the generator
# there would be two things to hold in sync. So it lives with the command that
# owns the generated file.
cmd_config_check() {
    if ! have_wg_creds; then
        bad "env file lacks the WireGuard values, so there is nothing to compare"
        exit 1
    fi
    if [ ! -f "$SINGBOX_CONFIG" ]; then
        bad "no config at $SINGBOX_CONFIG - generate one with: vpnchain config gen"
        exit 1
    fi
    local mode tmpcfg
    mode=$(singbox_mode)
    [ "$mode" = unknown ] && mode=chained
    tmpcfg=$(temp_file vpnchain-cfg)
    if ! generate_config "$tmpcfg" "$mode" 2>/dev/null; then
        rm -f "$tmpcfg"
        bad "could not render the config implied by the env file"
        exit 1
    fi
    if diff -q "$tmpcfg" "$SINGBOX_CONFIG" >/dev/null 2>&1; then
        ok "live config matches the env file"
    else
        warn "live config differs from what the env file describes"
        echo "         either it was hand-edited, or the env file changed"
        echo "         since it was generated. Regenerate with:"
        echo "           vpnchain config gen   (backs the current one up first)"
    fi
    rm -f "$tmpcfg"
}

case "${1:-status}" in
    start)   maybe_switch_mode "${2:-}"; cmd_start; wait_for_chain ;;
    stop)    cmd_stop ;;
             # switch_mode, not maybe_switch_mode: this verb restarts the agent
             # itself, so reloading inside the switch would do it twice.
    restart) if [ -n "${2:-}" ]; then switch_mode "$2" || true; fi
             # Checked before stopping anything, so a refused start cannot
             # leave the browser with no tunnel at all.
             refuse_if_port_blocked
             cmd_stop; cmd_start; echo; wait_for_chain ;;
    browser) shift; cmd_browser "$@" ;;
    i2p)     cmd_i2p "${2:-}" ;;
             # Both spelled out: a bare 'config' overwriting the live file
             # would be the wrong default for a verb that can lose rules.
    config)  case "${2:-}" in
                 (gen)   cmd_config ;;
                 (check) cmd_config_check ;;
                 (*)     echo "usage: vpnchain config {gen|check}" >&2; exit 1 ;;
             esac ;;
             # The country lists first: they need no BLOCKLIST_URL, and
             # cmd_blocklist exits when that is unset.
    get-blocklist) cmd_keep_out; cmd_blocklist ;;
    subscribe) cmd_subscribe ;;
             # Regenerate and restart sing-box alone, leaving the pilot and
             # the status server running - which is what lets the pilot use
             # it. WireGuard re-handshakes in a second or two.
    reload)  refuse_if_port_blocked
             cmd_config >/dev/null && agent_restart "$SINGBOX_AGENT" "$PLIST" &&
                 ok "sing-box reloaded" ;;
    setup)   cmd_setup ;;
    ssh-reality) shift; cmd_ssh_reality "$@" ;;
    *)
        echo "usage: vpnchain {start|restart} [chained|chained-reality|direct]"
        echo "       vpnchain {stop|reload}"
        echo "       vpnchain browser [with-webrtc] [with-cookies]"
        echo "       vpnchain browser incognito"
        echo "       vpnchain i2p [start|stop|status]"
        echo "       vpnchain config {gen|check}"
        echo "       vpnchain get-blocklist"
        echo "       vpnchain subscribe"
        echo "       vpnchain setup"
        echo "       vpnchain ssh-reality [own-node] [ssh arguments]"
        exit 1
        ;;
esac
