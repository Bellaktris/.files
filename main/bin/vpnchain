#!/bin/bash
# vpnchain - toggle a chained proxy setup on macOS.
#
#   browser, launched by 'vpnchain browser'
#     -> --proxy-server, pinned to that launch only
#        -> sing-box: userspace WireGuard endpoint (no tun, no root)
#           -> detour via an upstream SOCKS proxy
#              -> upstream transport
#                 -> WireGuard peer, which is the visible exit address
#
# Everything site-specific lives in $XDG_CONFIG_HOME/vpnchain/env, which is
# deliberately outside this repo. See the template printed by this script when
# that file is missing.
#
#   start [mode]    load the sing-box agent
#   stop            unload it
#   restart [mode]  reload it
#
# The optional [mode] on start/restart is one of:
#
#   chained  the WireGuard endpoint dials through the upstream SOCKS proxy, so
#            only ordinary TLS leaves the machine and the tunnel survives
#            censorship. Carries UDP over TCP.
#   direct   the endpoint dials its peer itself. Fewer moving parts, but
#            plainly a VPN on the wire and dead where UDP or VPNs are filtered.
#
# Latency is identical between them - same peer, same ocean crossing, both
# measured ~1.8x the bare connection. Throughput measurements were too noisy
# across repeated runs to call a winner, which is why the benchmark that
# produced them was removed rather than kept and distrusted. Choose on
# concealment, not speed.
#
# Omit it to keep whatever the config already has; the dashboard reports the
# active mode, so there is no separate command to query it.
#
#   browser [incognito|with-webrtc] [with-cookies]
#            quit and relaunch the browser from this shell with SPOOF_TZ and
#            the WebRTC policy applied. Both are read only at startup, which
#            is why this is a restart - closing windows is not enough.
#
#            incognito opens a SEPARATE incognito instance pointed at the
#            inbound that bypasses the WireGuard
#            endpoint - so it changes TWO things at once: nothing persists,
#            AND it exits at the upstream instead of the pinned address. It coexists with the main browser; a browser can only
#            hold one proxy, so a second exit means a second instance. That
#            exit is a shared datacenter address flagged as a proxy by IP
#            databases, so expect CAPTCHAs - the trade is that the session is
#            not linked to the pinned address.
#
#            Its timezone is not configured but MEASURED: the upstream selects
#            nodes by latency, so the exit country changes between launches and
#            any fixed value would end up contradicting the address. The zone
#            is read through that exit at launch and applied to it, so the
#            clock agrees with wherever the session actually comes out.
#
#            It also takes INCOGNITO_FLAGS, for capability this instance can
#            afford to lose and the main browser cannot.
#
#            A SOCKS proxy cannot carry UDP, so WebRTC would otherwise reach
#            the network directly and expose the real address regardless of
#            everything else here. The default launch prevents that.
#
#            It also disables incognito in the main browser. An incognito
#            window there clears cookies and history but keeps the pinned exit
#            address - the one thing that actually identifies you - so it
#            looks anonymous while being nothing of the sort. The incognito
#            instance, which does change the exit, forces incognito for itself
#            and the setting is put back immediately after it launches.
#
#            It also applies a set of static hardening policies borrowed from
#            Safari and Firefox: WebUSB, Web Bluetooth, Web Serial and WebHID
#            denied (neither browser ever shipped them), HTTPS-only mode on,
#            and vendor telemetry reduced - URL-keyed collection and metrics
#            off, Safe Browsing at Standard rather than Enhanced so visited
#            URLs are not sent for real-time checking. Notification prompts
#            are blocked except for NOTIFY_ALLOW. Background mode is off so
#            closing the last window really quits - this one is load-bearing,
#            since every policy is read at startup and a browser that will
#            not reliably quit cannot be relaunched to apply them. Downloads
#            prompt for a location rather than landing silently.
#
#            These are never relaxed, so unlike the two below there is
#            nothing to restore.
#
#            Third-party cookies are blocked by default too - they are the
#            cross-site join key, and the browser does not block them on its
#            own since that phase-out was reversed. with-cookies relaxes that
#            for one launch and restores blocking straight afterwards, for the
#            embedded sign-in and payment flows that need them.
#
#            Pass with-webrtc to relax the policy for the launch; block is
#            restored on disk immediately afterwards. The running browser
#            already read the relaxed value and keeps it until it quits, so
#            the exposure is scoped to that session and the next launch is
#            protected again - no timer, nothing to remember. Use it when a
#            call needs to connect.
#
#   config [check]
#            write the sing-box config from the env file, which is the single
#            source of truth for it. start does this automatically when no
#            config exists, since writing a missing file cannot lose anything.
#            Regenerating an existing one can - hand-added routing rules are
#            not carried over - so that stays explicit.
#
#            'config check' compares the live config against what the env file
#            describes without writing anything. It is the one check the status
#            server does not do, since a second copy of the generator there
#            would be two things to hold in sync.
#
#   blocklist
#            fetch the tracker lists named by BLOCKLIST_URL, convert them to a
#            sing-box rule-set and install it at BLOCKLIST_PATH. Rejection then
#            happens INSIDE the chain rather than in the browser, which is the
#            whole point: it sits below the JS layer, so it covers Web Workers,
#            service workers, prefetches and beacons uniformly, applies to both
#            inbounds at once, and adds no extension for a page to detect.
#
#            An extension cannot match that. Content scripts cannot be injected
#            into worker scope at all, so anything they hide on the main thread
#            a worker still sees - which turns the measure into a signal. The
#            network layer has no such split.
#
#            Several URLs may be given, space-separated; AdGuard's DNS filter
#            format is line-based, so they are concatenated before conversion
#            and the result is the union. The default pairing was chosen by
#            measurement, not reputation - see the env file template.
#
#            The converted set is smoke-tested before it is installed: a few
#            known trackers must match and a few domains that must keep working
#            must not. A list that fails is discarded rather than installed,
#            since a rule-set that blocks sign-in would be discovered as
#            mysterious breakage long after the fetch that caused it.
#
#            Blocking is engaged only when the file exists AND BLOCKLIST_URL is
#            set; sing-box refuses to start on a missing local rule-set path, so
#            'vpnchain config' is safe to run before the first fetch.
#
#            Unlike an extension this has no per-site off switch - rejection is
#            all or nothing. Blocked ads do, however, leave their bait elements
#            visible, so the common anti-adblock test of measuring a decoy div's
#            height sees nothing amiss; what a page can observe is that a
#            request failed, which is indistinguishable from a firewall or a
#            dead ad server. Unattributable, not undetectable.
#
# There is no 'status' verb. The dashboard is the status view - it reports the
# chain AND what the browser actually does, which no shell command can see. In
# a terminal, curl the server directly:
#
#     curl -s http://127.0.0.1:$STATUS_PORT/status.json
#
# NOTE: the proxy is pinned per browser launch rather than set system-wide.
# The scope is therefore exactly the browsers this script starts - nothing
# else on the machine is touched, and stopping the agent cannot strand macOS
# pointing at a dead port.
#
# The trade is that this fails OPEN, not safe: a browser started from the Dock
# or Spotlight carries no proxy flag and browses on your real address. Nothing
# prevents that.
#
# Browser-side facts are NOT reported here. The shell cannot see them: macOS
# hides other processes' environments, so the timezone a running browser was
# launched with is unreadable, and no process inspection reveals whether
# WebRTC is actually leaking. vpnchain-dashboard.html, alongside this script,
# measures all of it from inside the browser - open it as a plain file in the
# browser you want to inspect:
#
#     file://<this directory>/vpnchain-dashboard.html#expect=<exit address>
#
# Add &incognito=<prefix> so the incognito instance, which exits elsewhere by
# design, is labelled rather than reported as a wrong address.
#
# Worth setting as the browser's startup page. Then any launch, including one
# from the Dock that carries no proxy flag, shows you immediately whether you
# are on the expected address - which restores passive detection in the only
# place that can actually observe it.

set -uo pipefail

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/vpnchain/env"


if [ ! -r "$CONFIG" ]; then
    cat >&2 <<EOF
vpnchain: missing config at $CONFIG

Create it with your site-local values:

    PROXY_HOST=127.0.0.1
    PROXY_PORT=1080
    UPSTREAM_HOST=127.0.0.1
    UPSTREAM_PORT=<port of the upstream SOCKS proxy>
    UPSTREAM_PROCESS=<process name of the upstream proxy core>
    EXPECTED_EXIT_IP=<the address the chain should present>
    SINGBOX_AGENT=<launchd label of your sing-box agent>

Optional:

    SPOOF_TZ=<tz database zone the browser should report, e.g. America/Denver>
             match it to the exit address's geolocation; applied only by
             'vpnchain browser'
    INCOGNITO_PORT=<sing-box inbound that bypasses the WireGuard endpoint,
             default 1081; must exist in SINGBOX_CONFIG>
    INCOGNITO_TZ=<timezone for that instance, default UTC>
    INCOGNITO_PROFILE=<its throwaway profile dir>
    BROWSER_APP=<path to the browser bundle, defaults to Google Chrome>
    BROWSER_DOMAIN=<its preference domain, for the WebRTC policy>
    NOTIFY_ALLOW=<space-separated origins allowed to show notifications,
             e.g. "https://mail.example.com https://chat.example.com";
             everything else is blocked>
EOF
    exit 1
fi

# shellcheck source=/dev/null
. "$CONFIG"

for var in PROXY_HOST PROXY_PORT UPSTREAM_HOST UPSTREAM_PORT UPSTREAM_PROCESS \
           EXPECTED_EXIT_IP SINGBOX_AGENT; do
    if [ -z "${!var:-}" ]; then
        echo "vpnchain: $var is not set in $CONFIG" >&2
        exit 1
    fi
done

PLIST="$HOME/Library/LaunchAgents/$SINGBOX_AGENT.plist"

# Optional status server, started and stopped with the chain. It serves the
# dashboard together with the host-side facts a page cannot see for itself.
# Leave STATUSD_AGENT unset in the env file to do without it.
STATUSD_AGENT="${STATUSD_AGENT:-}"
STATUSD_PLIST="$HOME/Library/LaunchAgents/$STATUSD_AGENT.plist"
STATUS_PORT="${STATUS_PORT:-8787}"
STATUSD_BIN="$(cd "$(dirname "$0")" && pwd)/vpnchain-statusd"

# Chromium-family preference domain whose WebRTC policy we toggle.
# Override in the env file for Brave, Edge, Chromium, etc.
BROWSER_DOMAIN="${BROWSER_DOMAIN:-com.google.Chrome}"

# Chrome renamed this policy; write and read both so either vintage works.
WEBRTC_KEYS=(WebRtcIPHandlingPolicy WebRtcIPHandling)
WEBRTC_BLOCK_VALUE=disable_non_proxied_udp

# Incognito in the MAIN browser clears cookies and history while leaving the
# exit address untouched - so it looks anonymous while still presenting the
# one address that identifies you. Disabled by default for that reason; the
# incognito instance, which actually changes the exit, turns it on for itself.
#   0 available   1 disabled   2 forced
INCOGNITO_KEY=IncognitoModeAvailability
INCOGNITO_OFF=1
INCOGNITO_FORCED=2

# Third-party cookies are the cross-site join key: the same embedded domain
# appears on thousands of sites and recognises its own cookie each time. The
# browser does not block them by default - that phase-out was reversed - so we
# do it per launch. Breaks some embedded sign-in and payment flows, which is
# what 'with-cookies' is for.
COOKIE_KEY=BlockThirdPartyCookies

# Defaults borrowed from Safari and Firefox. The device APIs are the clearest
# case: neither browser ever shipped WebUSB, Web Bluetooth, Web Serial or
# WebHID, having declined on security and privacy grounds, so denying them
# here just matches their behaviour. They also enumerate hardware, which is
# fingerprinting surface.
#
# The second group is enumeration surface specifically. Every one of them hands
# a page a LIST rather than a single value, which is what makes them worth more
# to a fingerprinter than the hardware facts they sit next to:
#
#   LocalFonts       queryLocalFonts() returns every installed font. The set of
#                    fonts on a machine is close to unique, and it is the single
#                    highest-entropy thing a browser will volunteer in one call.
#   WindowManagement getScreenDetails() returns monitor count, sizes and
#                    arrangement - strictly more identifying than the single
#                    screen size it is usually lumped in with.
#   Sensors          motion and orientation, meaningless on a desktop and free
#                    to refuse there.
#   DirectSockets    raw TCP/UDP from a page; nothing here should want it.
#
# All four are denials, never substitutions. That distinction is the whole
# reason this is worth doing while spoofing is not: a refused API looks exactly
# like a browser that never implemented it, whereas a faked value can be caught
# disagreeing with itself - most cheaply by asking a Web Worker, which no
# extension can reach.
#
# What this does NOT buy: fonts stay detectable by measurement. Rendering text
# in a candidate font and comparing measureText() against the fallback needs no
# API and no permission, and document.fonts.check() is the same story. Firefox's
# resistFingerprinting answers that with a standard font allowlist; Chrome has
# no equivalent and no policy that approximates one. So the gain is that a
# script can no longer ask once and get everything - it has to probe candidates
# it already knows to guess. Lower entropy and far more effort, not zero.
#
# Measured, that residue is small: Cover Your Tracks scored the recovered font
# list at 3.49 bits, one browser in 11, near the BOTTOM of its table - while
# the WebGL rows it sat next to scored 9.29 and 8.87. So this group is worth
# far less than its length suggests, and the honest reading is that fonts were
# the wrong thing to spend a pass on.
#
# Fonts are the only entry here with a fallback channel at all. The other seven
# have no alternative route: refuse getScreenDetails and the monitor layout is
# simply gone, since screen.width only ever describes the current display.
#
# That fallback is weaker than it looks, though, and the 3.49 bits above
# understate what the denial is worth. Measurement RECALL IS BOUNDED BY THE
# PROBE LIST - a script can only detect faces whose names it already thought to
# try, while queryLocalFonts() has perfect recall and returns names nobody
# would guess. Measured on this machine: Cover Your Tracks reported 27 fonts
# while vpnchain-dashboard.html found 37 of its 53 candidates, same machine,
# the whole difference being that one list includes developer faces and the
# other does not.
#
# So the value of this denial scales with how unusual the installed set is. A
# font that is uncommon but POPULAR - Adobe's library, Office fonts, the
# well-known monospace families - appears in somebody's probe list and gets
# measured regardless. A genuinely obscure or licensed face does not, and
# enumeration is the only thing that would ever surface it. Keep this denied,
# and keep it denied harder the more such fonts get installed.
#   2 = deny, 3 = ask
DEVICE_API_KEYS=(DefaultWebUsbGuardSetting DefaultWebBluetoothGuardSetting
                 DefaultSerialGuardSetting DefaultWebHidGuardSetting
                 DefaultLocalFontsSetting DefaultWindowManagementSetting
                 DefaultSensorsSetting DefaultDirectSocketsSetting)

# Plaintext over a shared exit is readable by whoever runs it, which makes
# this worth more here than on an ordinary connection.
HTTPS_ONLY_KEY=HttpsOnlyMode

# What the browser reports back to its vendor. Safe Browsing stays on, just at
# Standard: Enhanced sends visited URLs and downloads for real-time checking,
# Standard matches against lists held locally.
# Notification prompts are blocked by default, as Safari and Firefox both
# heavily restrict them, with an allowlist for the handful of sites where
# notifications are the point. The list is personal, so it lives in the env
# file; empty means block everything.
# Chrome can keep running after its last window closes, which makes "quit"
# non-deterministic - and every policy here is read at startup, so a launch
# that cannot reliably restart the browser cannot apply anything. Neither
# Safari nor Firefox persists this way.
BACKGROUND_MODE_KEY=BackgroundModeEnabled

# Chrome saves to Downloads without asking. Being asked means a drive-by
# download cannot land unnoticed.
DOWNLOAD_PROMPT_KEY=PromptForDownloadLocation

NOTIFY_DEFAULT_KEY=DefaultNotificationsSetting
NOTIFY_ALLOW_KEY=NotificationsAllowedForUrls
NOTIFY_ALLOW="${NOTIFY_ALLOW:-}"

TELEMETRY_OFF_KEYS=(UrlKeyedAnonymizedDataCollectionEnabled MetricsReportingEnabled)
SAFE_BROWSING_KEY=SafeBrowsingProtectionLevel
SAFE_BROWSING_STANDARD=1

# Topics, Protected Audience and Attribution Reporting: the in-browser ad
# targeting and measurement APIs that were meant to replace third-party
# cookies. Blocking the cookies without these would close the old cross-site
# join key and leave its intended replacement wide open.
#
# The Privacy Sandbox programme was retired in October 2025 and third-party
# cookies were kept instead, so this is now the worst of both arrangements -
# the old mechanism survived AND the new one shipped. The policies outlived the
# programme, which is what makes turning them off still possible.
#
# The prompt key is included so disabling the APIs does not leave a consent
# dialog asking about features that are already off.
AD_PRIVACY_OFF_KEYS=(PrivacySandboxAdTopicsEnabled
                     PrivacySandboxSiteEnabledAdsEnabled
                     PrivacySandboxAdMeasurementEnabled
                     PrivacySandboxPromptEnabled)

BROWSER_APP="${BROWSER_APP:-/Applications/Google Chrome.app}"
BROWSER_BIN="$BROWSER_APP/Contents/MacOS/$(basename "${BROWSER_APP%.app}")"

# Timezone the browser should report. The browser has no timezone setting and
# delegates to the OS, but it honours TZ, which takes effect before ICU
# initialises - so main thread, iframes and Web Workers all agree. Only the
# zone interpretation changes; the clock itself stays correct, leaving TLS
# validity, JWT expiry and TOTP alone.
#
# This must be a launch from a shell. Wrapping it in a .app bundle was tried
# and produced a correct spoof but markedly slower page loads; the bundle
# launch context, not TZ, was responsible. `launchctl setenv` does not reach
# LaunchServices-launched apps at all. Both paths are disproven - do not
# reintroduce them.
SPOOF_TZ="${SPOOF_TZ:-}"

# Second sing-box inbound, routed straight to the upstream so it bypasses the
# WireGuard endpoint. Same daemon, no reconfiguration - picking an exit is just
# picking a port, and both can be in use at once.
INCOGNITO_PORT="${INCOGNITO_PORT:-1081}"

# This used to default to UTC, on the theory that reporting what Tor Browser
# and Firefox resistFingerprinting report puts the instance in a large set.
# Measuring it against Cover Your Tracks disproved that: UTC scored 6.78 bits,
# one browser in 110 - worse than a populous real zone, and among a population
# of privacy testers where UTC should have been OVER-represented if the theory
# held. Do not restore it on that reasoning.
#
# Matching the zone to the exit is the right answer, but the upstream node is
# chosen by latency, so this exit's country changes between launches - no
# static value can stay consistent with it. It is therefore DERIVED at launch
# from the exit actually in use (see incognito_tz), and this is only the
# fallback for when that lookup fails.
#
# The fallback is a populous zone rather than UTC because when the exit is
# unknown, consistency is not achievable and the only remaining goal is to
# spend few bits. Deliberately not the pinned instance's zone either: the whole
# purpose of this exit is to be unlinkable from that one, and a shared timezone
# is a signal handed over for nothing.
INCOGNITO_TZ="${INCOGNITO_TZ:-America/New_York}"

# Set to 0 to pin INCOGNITO_TZ verbatim instead of following the exit. Exists
# because the two are not obviously ordered: following the exit scores far
# better on the timezone row itself - a populous real zone measured 3.85 bits
# against UTC's 6.78 on Cover Your Tracks - and it is the only way the
# dashboard's clock-vs-exit check can pass. Against that, a real zone paired
# with an en-US language header is an odd COMBINATION, and joint uniqueness is
# not what per-row bits measure. Tested: pinning UTC left the joint result
# unique either way, so the combination was not the cause and the per-row
# improvement stands unopposed.
INCOGNITO_TZ_FOLLOW_EXIT="${INCOGNITO_TZ_FOLLOW_EXIT:-1}"

# Extra flags for the incognito instance only. The measured case for
# --disable-webgl: on Cover Your Tracks the WebGL hash scored 9.29 bits and the
# vendor/renderer string 8.87, the two largest removable rows by a wide margin,
# and one flag removes both. It is a denial rather than a substitution, and it
# reaches Web Workers too because it disables the implementation rather than
# patching the API - so OffscreenCanvas in a worker gets no context either.
#
# Not applied to the pinned instance: that one is for ordinary browsing, where
# losing WebGL breaks maps and anything 3D, and where the dedicated residential
# address identifies you far more precisely than any fingerprint anyway.
#
# Avoid --force-device-scale-factor=1 here. It was measured and it does change
# devicePixelRatio, but it leaves screen=1512x982 at dpr=1, which is not a
# combination real hardware produces - and an implausible pair is more
# identifying than the honest one it replaced.
INCOGNITO_FLAGS="${INCOGNITO_FLAGS:-}"

# Only needed to force a SEPARATE browser process, which is what lets this
# instance hold a different proxy. The session itself runs --incognito, so no
# browsing data lands here and the directory needs no maintenance.
INCOGNITO_PROFILE="${INCOGNITO_PROFILE:-$HOME/.cache/vpnchain-upstream-profile}"

SINGBOX_CONFIG="${SINGBOX_CONFIG:-$HOME/.config/sing-box/config.json}"

# Tag of the sing-box outbound pointing at the upstream proxy. This is what
# gets written back as the endpoint's "detour" when re-enabling chained mode,
# so it must match the tag actually used in SINGBOX_CONFIG. Override in the
# env file if yours differs.
UPSTREAM_TAG="${UPSTREAM_TAG:-upstream}"

# Tracker rejection, done in the chain rather than the browser. Space-separated
# AdGuard-format DNS filter URLs; empty disables the feature entirely.
BLOCKLIST_URL="${BLOCKLIST_URL:-}"
BLOCKLIST_PATH="${BLOCKLIST_PATH:-$HOME/.config/sing-box/blocklist.srs}"

# Installed only if the converted set still blocks what it should and still
# lets through what it must. A bad list is not a cosmetic problem: it presents
# as sign-in or payment pages mysteriously failing, days after the fetch that
# caused it, with nothing pointing back here. Cheaper to refuse up front.
BLOCKLIST_MUST_BLOCK=(www.google-analytics.com doubleclick.net
                      b.scorecardresearch.com)
BLOCKLIST_MUST_PASS=(github.com accounts.google.com fonts.gstatic.com
                     mail.google.com cdn.jsdelivr.net)


# The only difference between the modes in the config is whether the WireGuard
# endpoint carries a "detour" key.
singbox_mode() {
    python3 - "$SINGBOX_CONFIG" <<'PY' 2>/dev/null || echo unknown
import json, sys
try:
    c = json.load(open(sys.argv[1]))
except Exception:
    print("unknown"); raise SystemExit
eps = c.get("endpoints") or []
wg = next((e for e in eps if e.get("type") == "wireguard"), None)
if wg is None:
    print("unknown")
else:
    print("chained" if wg.get("detour") else "direct")
PY
}

bold() { printf '\033[1m%s\033[0m\n' "$1"; }
ok()   { printf '  \033[32m[ok]\033[0m   %s\n' "$1"; }
warn() { printf '  \033[33m[warn]\033[0m %s\n' "$1"; }
bad()  { printf '  \033[31m[bad]\033[0m  %s\n' "$1"; }


agent_running() { pgrep -f 'sing-box run' >/dev/null 2>&1; }

cmd_start() {
    # Bootstrap only. Writing a config that does not exist cannot discard
    # anything, so it is safe to do implicitly; regenerating one that does
    # exist can, which is why that stays behind an explicit verb.
    if [ ! -f "$SINGBOX_CONFIG" ]; then
        if have_wg_creds; then
            warn "no config at $SINGBOX_CONFIG - generating one"
            cmd_config
        else
            bad "no config at $SINGBOX_CONFIG, and the env file lacks the"
            bad "WireGuard values needed to generate one"
            exit 1
        fi
    fi

    if agent_running; then
        ok "sing-box already running"
        start_statusd
        return
    fi
    launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null \
        || launchctl load -w "$PLIST" 2>/dev/null
    sleep 2
    if agent_running; then
        ok "sing-box started"
    else
        bad "sing-box failed to start - check its stderr log"
    fi
    start_statusd
}

statusd_running() { pgrep -f 'vpnchain-statusd' >/dev/null 2>&1; }

# Written on first use rather than shipped, since it has to carry absolute
# paths for this machine. Writing a file that does not exist cannot lose
# anything, which is the same reasoning as generating a missing config.
ensure_statusd_plist() {
    [ -f "$STATUSD_PLIST" ] && return 0
    cat > "$STATUSD_PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>$STATUSD_AGENT</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>python3</string>
        <string>$STATUSD_BIN</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict><key>STATUS_PORT</key><string>$STATUS_PORT</string></dict>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>$HOME/.config/vpnchain/statusd.log</string>
    <key>StandardErrorPath</key><string>$HOME/.config/vpnchain/statusd.err.log</string>
    <key>ProcessType</key><string>Background</string>
</dict>
</plist>
PLIST
    ok "wrote $STATUSD_PLIST"
}

start_statusd() {
    [ -z "$STATUSD_AGENT" ] && return 0
    if [ ! -x "$STATUSD_BIN" ]; then
        warn "status server not found at $STATUSD_BIN - skipping"
        return 0
    fi
    ensure_statusd_plist
    if statusd_running; then
        ok "status server already running"
    else
        launchctl bootstrap "gui/$(id -u)" "$STATUSD_PLIST" 2>/dev/null \
            || launchctl load -w "$STATUSD_PLIST" 2>/dev/null
        sleep 1
        statusd_running && ok "status server on http://127.0.0.1:$STATUS_PORT/" \
                        || bad "status server did not start - see statusd.err.log"
    fi
}

stop_statusd() {
    [ -z "$STATUSD_AGENT" ] && return 0
    launchctl bootout "gui/$(id -u)/$STATUSD_AGENT" 2>/dev/null \
        || launchctl unload -w "$STATUSD_PLIST" 2>/dev/null
    ok "status server stopped"
}

cmd_stop() {
    stop_statusd
    launchctl bootout "gui/$(id -u)/$SINGBOX_AGENT" 2>/dev/null \
        || launchctl unload -w "$PLIST" 2>/dev/null
    ok "sing-box stopped"
}

# "blocked" if either policy key pins non-proxied UDP off, else "allowed".
webrtc_state() {
    local k v
    for k in "${WEBRTC_KEYS[@]}"; do
        v=$(defaults read "$BROWSER_DOMAIN" "$k" 2>/dev/null)
        [ "$v" = "$WEBRTC_BLOCK_VALUE" ] && { echo blocked; return; }
    done
    echo allowed
}

set_incognito_policy() {
    defaults write "$BROWSER_DOMAIN" "$INCOGNITO_KEY" -int "$1"
}

set_cookie_policy() {
    defaults write "$BROWSER_DOMAIN" "$COOKIE_KEY" -bool "$1"
}

# Static - never relaxed, so unlike the cookie and WebRTC policies there is
# nothing to restore afterwards. Applied before the quit attempt so an aborted
# launch still leaves them in place.
set_hardening_policies() {
    local k
    for k in "${DEVICE_API_KEYS[@]}"; do
        defaults write "$BROWSER_DOMAIN" "$k" -int 2
    done
    defaults write "$BROWSER_DOMAIN" "$HTTPS_ONLY_KEY" -string force_enabled
    for k in "${TELEMETRY_OFF_KEYS[@]}"; do
        defaults write "$BROWSER_DOMAIN" "$k" -bool false
    done
    defaults write "$BROWSER_DOMAIN" "$SAFE_BROWSING_KEY" -int "$SAFE_BROWSING_STANDARD"
    for k in "${AD_PRIVACY_OFF_KEYS[@]}"; do
        defaults write "$BROWSER_DOMAIN" "$k" -bool false
    done

    # 2 = block. The allowlist is rewritten wholesale each launch so removing
    # an entry from the env file actually removes it, rather than leaving a
    # stale permission behind.
    defaults write "$BROWSER_DOMAIN" "$BACKGROUND_MODE_KEY" -bool false
    defaults write "$BROWSER_DOMAIN" "$DOWNLOAD_PROMPT_KEY" -bool true

    defaults write "$BROWSER_DOMAIN" "$NOTIFY_DEFAULT_KEY" -int 2
    defaults delete "$BROWSER_DOMAIN" "$NOTIFY_ALLOW_KEY" 2>/dev/null
    if [ -n "$NOTIFY_ALLOW" ]; then
        # shellcheck disable=SC2086
        defaults write "$BROWSER_DOMAIN" "$NOTIFY_ALLOW_KEY" -array $NOTIFY_ALLOW
    fi
}

# The resting state both policies should be left in. Called on the normal path
# and from a trap, so an interrupted launch cannot strand the browser with
# incognito forced or WebRTC allowed.
restore_policies() {
    set_webrtc block
    set_incognito_policy "$INCOGNITO_OFF"
    set_cookie_policy true
}

set_webrtc() {
    local k
    if [ "$1" = block ]; then
        for k in "${WEBRTC_KEYS[@]}"; do
            defaults write "$BROWSER_DOMAIN" "$k" -string "$WEBRTC_BLOCK_VALUE"
        done
    else
        # Delete rather than writing "default": a mandatory policy also
        # overrides extension-set privacy settings, so leaving one in place
        # would silently defeat any extension-based control later.
        for k in "${WEBRTC_KEYS[@]}"; do
            defaults delete "$BROWSER_DOMAIN" "$k" 2>/dev/null
        done
    fi
}

# Match the binary path specifically. A looser pattern also matches the
# osascript quit command and this script's own arguments, which would make the
# quit-wait loop below never finish.
browser_running() { pgrep -f "$BROWSER_BIN" >/dev/null 2>&1; }

# The tunnel needs time to hand shake after the agent restarts, and until it
# does, everything through the proxy fails. A fixed sleep either wastes time or
# lies, so poll until traffic actually flows.
wait_for_chain() {
    local i=0
    while [ "$i" -lt 12 ]; do
        if curl -s -m 4 --socks5-hostname "$PROXY_HOST:$PROXY_PORT" \
                -o /dev/null https://api.ipify.org 2>/dev/null; then
            ok "tunnel is carrying traffic"
            return 0
        fi
        sleep 2
        i=$((i + 1))
    done
    bad "tunnel is up but not carrying traffic after ~25s"
    echo "         check: tail ~/.config/sing-box/sing-box.err.log"
    return 1
}

# The zone the incognito exit sits in, read through that exit itself so the
# answer describes the node actually in use. The upstream picks nodes by
# latency, so this changes between launches and no configured value could keep
# up; deriving it is what makes the clock agree with the address instead of
# contradicting it.
#
# Prints nothing when it cannot be determined, leaving the caller to fall back.
incognito_tz() {
    local body tz
    body=$(curl -s -m 10 --socks5-hostname "$PROXY_HOST:$INCOGNITO_PORT" \
           https://ipinfo.io/json 2>/dev/null)
    [ -z "$body" ] && return 0
    tz=$(printf '%s' "$body" | python3 -c '
import json, sys
try:
    print(json.load(sys.stdin).get("timezone") or "")
except Exception:
    print("")
' 2>/dev/null)
    # Two checks, because a malformed TZ fails SILENTLY: the C library falls
    # back to UTC rather than erroring, so a bad value would present as a
    # working spoof that reports the wrong zone - the failure mode hardest to
    # notice. Shape first, then confirm the zone actually exists on this host.
    case "$tz" in
        */*) [ -f "/usr/share/zoneinfo/$tz" ] && printf '%s\n' "$tz" ;;
    esac
}

# Switch the config between chained and direct. Returns 0 if it changed.
# Does not restart on its own; callers that already restart handle that.
switch_mode() {
    local want="$1" cur
    cur=$(singbox_mode)

    case "$want" in
        chained|direct) ;;
        *) echo "vpnchain: unknown mode '$want' (expected chained or direct)" >&2
           exit 1 ;;
    esac
    if [ "$cur" = unknown ]; then
        bad "could not read a wireguard endpoint from $SINGBOX_CONFIG"
        exit 1
    fi
    if [ "$cur" = "$want" ]; then
        ok "already in $want mode"
        return 1
    fi

    # Edit in place rather than keeping two config files, so the keys and the
    # peer cannot drift apart between them.
    python3 - "$SINGBOX_CONFIG" "$want" "$UPSTREAM_TAG" <<'PY' || exit 1
import json, shutil, sys
path, want, tag = sys.argv[1], sys.argv[2], sys.argv[3]
c = json.load(open(path))
wg = next(e for e in c["endpoints"] if e.get("type") == "wireguard")
if want == "chained":
    wg["detour"] = tag
else:
    wg.pop("detour", None)
shutil.copy2(path, path + ".bak")
with open(path, "w") as f:
    json.dump(c, f, indent=2)
    f.write("\n")
PY

    if ! sing-box check -c "$SINGBOX_CONFIG" 2>/dev/null; then
        bad "edited config failed validation - restoring"
        mv "$SINGBOX_CONFIG.bak" "$SINGBOX_CONFIG"
        exit 1
    fi
    rm -f "$SINGBOX_CONFIG.bak"
    ok "config switched to $want mode"

    if [ "$want" = direct ]; then
        warn "the tunnel is now plainly a VPN on the wire: UDP straight to the"
        warn "peer address, with none of the upstream's cover traffic"
        warn "it will also fail outright on networks that block UDP or VPNs"
    fi
    return 0
}

# Optional [chained|direct] argument on the lifecycle verbs. A mode change
# needs the agent reloaded, so if it is already running, restart it here -
# otherwise cmd_start would see a live agent and leave the old config loaded.
maybe_switch_mode() {
    [ -z "${1:-}" ] && return 0
    if switch_mode "$1" && agent_running; then
        launchctl kickstart -k "gui/$(id -u)/$SINGBOX_AGENT" 2>/dev/null \
            || { cmd_stop >/dev/null 2>&1; cmd_start >/dev/null 2>&1; }
        ok "sing-box reloaded for the new mode"
    fi
}




# Blocking is engaged only when a list is configured AND the converted set is
# actually on disk. sing-box refuses to start if a local rule-set path is
# missing, so conditioning on the file is what keeps 'vpnchain config' safe to
# run before the first fetch - and what makes deleting the file a complete
# off switch after the next regenerate.
blocklist_active() { [ -n "$BLOCKLIST_URL" ] && [ -s "$BLOCKLIST_PATH" ]; }

# sing-box prints the matching rule on STDERR and exits 0 whether or not
# anything matched, so neither the exit status nor stdout distinguishes a hit
# from a miss. The log line is the only signal.
blocklist_blocks() {
    case "$(sing-box rule-set match -f binary "$1" "$2" 2>&1)" in
        *"match rules"*) return 0 ;;
        *)               return 1 ;;
    esac
}

# Fetch, convert, verify, install - in that order, and nothing is installed
# until the verify passes.
cmd_blocklist() {
    if [ -z "$BLOCKLIST_URL" ]; then
        bad "BLOCKLIST_URL is not set in $CONFIG - nothing to fetch"
        echo "         set it to one or more space-separated AdGuard-format DNS"
        echo "         filter URLs. That format is line-based, so several are"
        echo "         concatenated and the rule-set is their union."
        exit 1
    fi
    if ! command -v sing-box >/dev/null 2>&1; then
        bad "sing-box not found - it does the conversion"
        exit 1
    fi

    local tmp src srs u parsed d n=0 fail=0
    tmp=$(mktemp -d -t vpnchain-blocklist) || exit 1
    src="$tmp/source.txt"
    srs="$tmp/blocklist.srs"
    : > "$src"

    # Deliberately unquoted: the value is a list of URLs, not one URL.
    # shellcheck disable=SC2086
    for u in $BLOCKLIST_URL; do
        if ! curl -fsSL -m 180 "$u" >> "$src"; then
            bad "could not fetch $u"
            bad "the installed list is untouched"
            rm -rf "$tmp"
            exit 1
        fi
        # Lists do not reliably end in a newline. Without this the last rule of
        # one would be glued to the first rule of the next and both would be
        # silently lost - a failure that would only show as two missing entries
        # out of two hundred thousand.
        printf '\n' >> "$src"
        n=$((n + 1))
        ok "fetched $u"
    done
    ok "$(wc -l <"$src" | tr -d ' ') lines from $n list(s)"

    parsed=$(sing-box rule-set convert -t adguard -o "$srs" "$src" 2>&1 \
             | sed -n 's/.*parsed rules: \([0-9]*\).*/\1/p' | tail -1)
    if [ ! -s "$srs" ]; then
        bad "conversion produced no rule-set"
        rm -rf "$tmp"
        exit 1
    fi
    ok "converted ${parsed:-?} rules"

    for d in "${BLOCKLIST_MUST_BLOCK[@]}"; do
        blocklist_blocks "$srs" "$d" || { bad "smoke test: $d is NOT blocked"; fail=1; }
    done
    for d in "${BLOCKLIST_MUST_PASS[@]}"; do
        if blocklist_blocks "$srs" "$d"; then
            bad "smoke test: $d WOULD be blocked"
            fail=1
        fi
    done
    if [ "$fail" = 1 ]; then
        bad "discarding this rule-set; the installed one is untouched"
        rm -rf "$tmp"
        exit 1
    fi
    ok "smoke test passed: ${#BLOCKLIST_MUST_BLOCK[@]} blocked, ${#BLOCKLIST_MUST_PASS[@]} reachable"

    mkdir -p "$(dirname "$BLOCKLIST_PATH")"
    if ! mv "$srs" "$BLOCKLIST_PATH"; then
        bad "could not install $BLOCKLIST_PATH"
        rm -rf "$tmp"
        exit 1
    fi
    rm -rf "$tmp"
    ok "installed $BLOCKLIST_PATH ($(wc -c <"$BLOCKLIST_PATH" | tr -d ' ') bytes)"

    if ! grep -q 'blocklist' "$SINGBOX_CONFIG" 2>/dev/null; then
        warn "the live config does not reference it yet - regenerate and reload:"
        echo "           vpnchain config && vpnchain restart"
    elif agent_running; then
        echo "         load the updated list with: vpnchain restart"
    fi
}

# Any failure after the backup is taken must put the old config back, or a
# half-written one is left in place for the next start to trip over.
restore_config_backup() {
    if [ -f "$SINGBOX_CONFIG.bak" ]; then
        mv "$SINGBOX_CONFIG.bak" "$SINGBOX_CONFIG"
        warn "previous config restored"
    fi
}

# Writes a known-good config from the env file. Deliberately a separate verb
# rather than something start does implicitly: regenerating wholesale discards
# any routing rules added by hand, which should be a decision rather than a
# surprise. Runtime toggles stay surgical for the same reason.
cmd_config() {
    local v missing=()
    for v in WG_PRIVATE_KEY WG_ADDRESS WG_PEER_PUBLIC_KEY WG_PEER_HOST WG_PEER_PORT; do
        [ -z "${!v:-}" ] && missing+=("$v")
    done
    if [ "${#missing[@]}" -gt 0 ]; then
        bad "cannot generate - missing in $CONFIG:"
        printf '         %s\n' "${missing[@]}"
        exit 1
    fi

    # Preserve whichever mode is already in effect; generating should not
    # silently move you between concealment postures.
    local mode
    mode=$(singbox_mode)
    [ "$mode" = unknown ] && mode=chained
    ok "generating a $mode config"

    mkdir -p "$(dirname "$SINGBOX_CONFIG")"
    if [ -f "$SINGBOX_CONFIG" ]; then
        cp -p "$SINGBOX_CONFIG" "$SINGBOX_CONFIG.bak"
        ok "previous config saved as $(basename "$SINGBOX_CONFIG").bak"
        warn "hand-added routing rules are NOT carried over; merge them back"
        warn "from the backup if you had any"
    fi

    generate_config "$SINGBOX_CONFIG" "$mode" || {
        restore_config_backup; bad "generation failed"; exit 1; }

    if ! sing-box check -c "$SINGBOX_CONFIG" 2>&1; then
        bad "generated config failed validation"
        restore_config_backup
        exit 1
    fi
    ok "config written and valid: $SINGBOX_CONFIG"
    # Only worth saying when something is already running the old one; during
    # bootstrap the caller starts the agent immediately after this.
    agent_running && echo "         apply it with: vpnchain restart"
}

# Renders the config implied by the env file to $1. Kept separate from
# cmd_config so status can render to a temp file and compare, which is how
# drift between the env file and the live config gets noticed.
generate_config() {
    local out="$1" mode="$2"
    MODE="$mode" P_HOST="$PROXY_HOST" P_PORT="$PROXY_PORT" \
    U_PORT="$INCOGNITO_PORT" UP_HOST="$UPSTREAM_HOST" \
    UP_PORT="$UPSTREAM_PORT" UP_TAG="$UPSTREAM_TAG" \
    WG_MTU="${WG_MTU:-1390}" WG_DNS="${WG_DNS:-8.8.8.8}" \
    WG_PRIVATE_KEY="$WG_PRIVATE_KEY" WG_ADDRESS="$WG_ADDRESS" \
    WG_PEER_PUBLIC_KEY="$WG_PEER_PUBLIC_KEY" \
    WG_PEER_HOST="$WG_PEER_HOST" WG_PEER_PORT="$WG_PEER_PORT" \
    BL="$(blocklist_active && echo "$BLOCKLIST_PATH")" \
    OUT="$out" \
    python3 - <<'PY' || { restore_config_backup; bad "generation failed"; exit 1; }
import json, os
e = os.environ

wg = {
    "type": "wireguard", "tag": "tunnel", "system": False,
    "mtu": int(e["WG_MTU"]),
    "address": [e["WG_ADDRESS"]],
    "private_key": e["WG_PRIVATE_KEY"],
    "peers": [{
        "address": e["WG_PEER_HOST"],
        "port": int(e["WG_PEER_PORT"]),
        "public_key": e["WG_PEER_PUBLIC_KEY"],
        "allowed_ips": ["0.0.0.0/0"],
        "persistent_keepalive_interval": 25,
    }],
}
if e["MODE"] == "chained":
    wg["detour"] = e["UP_TAG"]

cfg = {
    "log": {"level": "info", "timestamp": True},
    # Names for the incognito inbound resolve through the upstream too.
    # Resolving them through the tunnel would have the site see one origin
    # while its authoritative DNS saw another.
    "dns": {
        "servers": [
            {"type": "udp", "tag": "tunnel-dns",
             "server": e["WG_DNS"], "detour": "tunnel"},
            {"type": "udp", "tag": "upstream-dns",
             "server": e["WG_DNS"], "detour": e["UP_TAG"]},
        ],
        "rules": [{"inbound": ["upstream-in"], "server": "upstream-dns"}],
        "final": "tunnel-dns",
        "strategy": "ipv4_only",
    },
    "inbounds": [
        {"type": "mixed", "tag": "pinned-in",
         "listen": e["P_HOST"], "listen_port": int(e["P_PORT"])},
        {"type": "mixed", "tag": "upstream-in",
         "listen": e["P_HOST"], "listen_port": int(e["U_PORT"])},
    ],
    "endpoints": [wg],
    "outbounds": [
        {"type": "socks", "tag": e["UP_TAG"], "server": e["UP_HOST"],
         "server_port": int(e["UP_PORT"]), "version": "5"},
    ],
    "route": {
        "rules": [{"inbound": ["upstream-in"], "action": "route",
                   "outbound": e["UP_TAG"]}],
        "final": "tunnel",
    },
}

# Tracker rejection, when a converted list is installed. Both rules go FIRST:
# the DNS rules that follow pick a server per inbound, and the route rules that
# follow pick an outbound per inbound, so a reject placed after either would
# only cover one of the two exits. Placed first, it covers both.
#
# Rejecting in DNS alone would be enough almost always, since a name that does
# not resolve is never dialled. The route rule covers what DNS cannot: a
# cached answer, a literal address, or an HTTP/3 alt-svc target the browser
# already holds. Two cheap rules, no ordering subtlety between them.
bl = e.get("BL") or ""
if bl:
    cfg["dns"]["rules"].insert(0, {"rule_set": "blocklist", "action": "reject"})
    cfg["route"]["rule_set"] = [{"type": "local", "tag": "blocklist",
                                 "format": "binary", "path": bl}]
    cfg["route"]["rules"].insert(0, {"rule_set": "blocklist", "action": "reject"})

out = e["OUT"]
with open(out, "w") as f:
    json.dump(cfg, f, indent=2)
    f.write("\n")
os.chmod(out, 0o600)   # it holds the private key
PY
}

# true when every value the generator needs is present
have_wg_creds() {
    local v
    for v in WG_PRIVATE_KEY WG_ADDRESS WG_PEER_PUBLIC_KEY WG_PEER_HOST WG_PEER_PORT; do
        [ -z "${!v:-}" ] && return 1
    done
    return 0
}

cmd_browser() {
    # Flags name what you opt INTO, so the bare command cannot accidentally
    # mean "expose my real address" or "use the unlinked exit".
    local want=block exit_kind=pinned cookies=block already_up=0 a
    for a in "$@"; do
        case "$a" in
            "")             ;;
            with-webrtc)    want=allow ;;
            with-cookies)   cookies=allow ;;
            incognito)  exit_kind=upstream ;;
            *) echo "usage: vpnchain browser [incognito|with-webrtc] [with-cookies]" >&2
               exit 1 ;;
        esac
    done

    # Refused rather than merely warned about: an unlinked session that is
    # allowed to use non-proxied UDP leaks the real address into exactly the
    # session whose whole purpose is not carrying it.
    if [ "$exit_kind" = upstream ] && [ "$want" = allow ]; then
        bad "incognito and with-webrtc are mutually exclusive"
        echo "         WebRTC would expose your real address inside the"
        echo "         session that exists specifically to avoid that"
        exit 1
    fi

    if [ ! -x "$BROWSER_BIN" ]; then
        bad "browser binary not found: $BROWSER_BIN"
        exit 1
    fi

    # Whatever happens from here, the browser must not be left with incognito
    # forced or WebRTC allowed. Restoring twice on the normal path is harmless.
    trap restore_policies EXIT INT TERM

    set_hardening_policies
    ok "device APIs denied, HTTPS-only on, vendor telemetry reduced"
    ok "font, screen-layout and sensor enumeration denied"
    ok "ad topics, ad auctions and ad measurement off"
    ok "background mode off, downloads prompt for a location"
    if [ -n "$NOTIFY_ALLOW" ]; then
        ok "notifications blocked except $(printf '%s' "$NOTIFY_ALLOW" | wc -w | tr -d ' ') allowed site(s)"
    else
        ok "notifications blocked (no allowlist configured)"
    fi

    # NOTE: expanded as ${profile_args[@]+"${profile_args[@]}"} below, not
    # "${profile_args[@]}" - bash 3.2, which is /bin/bash on macOS, errors on
    # an empty array under set -u.
    local port tz profile_args=()
    if [ "$exit_kind" = upstream ]; then
        # Bypasses the WireGuard endpoint entirely, so this exits at the
        # upstream rather than the pinned address. A browser can only hold one
        # proxy, so this has to be a SEPARATE instance with its own profile -
        # it coexists with the main one rather than replacing it.
        port="$INCOGNITO_PORT"
        # Derived from the exit rather than configured - see incognito_tz.
        if [ "$INCOGNITO_TZ_FOLLOW_EXIT" = 1 ]; then
            tz="$(incognito_tz)"
            if [ -n "$tz" ]; then
                ok "timezone matched to this exit: $tz"
            else
                tz="$INCOGNITO_TZ"
                warn "could not read the exit's zone - using fallback $tz"
                warn "the clock will not match the address this session"
            fi
        else
            tz="$INCOGNITO_TZ"
            ok "timezone pinned to $tz (not following the exit)"
            warn "the clock will not match the exit address"
        fi
        # --incognito does the cleanup for us: nothing is persisted, so the
        # profile dir needs no wiping. --user-data-dir is still required -
        # without it --incognito just opens a window in the EXISTING browser,
        # which carries the main instance's proxy rather than this one.
        profile_args=(--user-data-dir="$INCOGNITO_PROFILE" --incognito
                      --no-first-run --no-default-browser-check)
        # Deliberately unquoted: the value is a list of flags, not one flag.
        # shellcheck disable=SC2206
        [ -n "$INCOGNITO_FLAGS" ] && profile_args+=($INCOGNITO_FLAGS)
        # Remember whether one was already up: a second launch hands off to
        # it and this invocation's flags are silently discarded.
        pgrep -f "$INCOGNITO_PROFILE" >/dev/null 2>&1 && already_up=1
        ok "separate incognito instance (nothing persisted)"
        [ -n "$INCOGNITO_FLAGS" ] && ok "extra flags: $INCOGNITO_FLAGS"
        warn "this exit is flagged as a proxy by IP databases - expect CAPTCHAs"
    else
        port="$PROXY_PORT"
        tz="$SPOOF_TZ"
        if browser_running; then
            ok "asking the browser to quit (it will restore your session)"
            osascript -e "quit app \"$(basename "${BROWSER_APP%.app}")\"" >/dev/null 2>&1
            local i=0
            while browser_running && [ "$i" -lt 60 ]; do
                sleep 0.25
                i=$((i + 1))
            done
            if browser_running; then
                bad "browser is still running - it may be holding an unsaved prompt"
                bad "launching now would just hand off to the existing process and"
                bad "change nothing, so stopping here. Quit it manually and retry."
                exit 1
            fi
            ok "browser quit"
        else
            ok "browser was not running"
        fi
    fi

    # Policies are read at startup, so they have to be in place before the
    # launch. Both are global to the preference domain, which is why they are
    # set here either way and put back immediately afterwards.
    set_webrtc "$want"
    [ "$want" = block ] && ok "webrtc policy set to block" \
                        || warn "webrtc policy relaxed for this launch"

    if [ "$cookies" = block ]; then
        set_cookie_policy true
        ok "third-party cookies blocked"
    else
        set_cookie_policy false
        warn "third-party cookies allowed for this launch"
    fi

    if [ "$exit_kind" = upstream ]; then
        set_incognito_policy "$INCOGNITO_FORCED"
        ok "incognito forced for this launch"
    else
        set_incognito_policy "$INCOGNITO_OFF"
        ok "incognito disabled (it would not change the exit address)"
    fi

    # The proxy is pinned to this launch rather than set system-wide, so the
    # scope is exactly this browser and nothing else on the machine is touched.
    # Chrome still hands over hostnames rather than pre-resolving, so remote
    # DNS - and therefore no DNS leak - is preserved.
    local bpid
    local proxy_flag="--proxy-server=socks5://$PROXY_HOST:$port"
    ok "proxy pinned to this launch: $PROXY_HOST:$port"
    if [ -n "$tz" ]; then
        ok "launching with TZ=$tz"
        TZ="$tz" nohup "$BROWSER_BIN" "$proxy_flag" \
            ${profile_args[@]+"${profile_args[@]}"} >/dev/null 2>&1 &
    else
        warn "no timezone configured - launching with the system timezone"
        nohup "$BROWSER_BIN" "$proxy_flag" \
            ${profile_args[@]+"${profile_args[@]}"} >/dev/null 2>&1 &
    fi
    bpid=$!
    disown 2>/dev/null
    sleep 3

    if [ "$exit_kind" = upstream ]; then
        # Not the launcher pid: if an instance with this profile is already
        # running, the launch hands off to it and the launcher exits at once,
        # which would read as a failure. Ask whether the instance exists.
        if ! pgrep -f "$INCOGNITO_PROFILE" >/dev/null 2>&1; then
            bad "incognito instance did not come up"
        elif [ "$already_up" = 1 ]; then
            warn "an instance was ALREADY running - this launch handed off to it"
            warn "and its flags were discarded. The proxy and timezone in effect"
            warn "are whatever that instance started with, not what is printed"
            warn "above. Quit it first if you changed INCOGNITO_PORT or _TZ."
        else
            ok "incognito instance running (pid $(pgrep -f "$INCOGNITO_PROFILE" | head -1))"
        fi
    elif browser_running; then
        ok "browser started (pid $bpid)"
    else
        bad "browser did not come up"
    fi

    # Put the protective policy back immediately. The running browser already
    # read the relaxed one and keeps it for its lifetime, so the exposure is
    # scoped to this session and the next launch is protected by default -
    # no timer, nothing to remember.
    if [ "$exit_kind" = upstream ]; then
        set_incognito_policy "$INCOGNITO_OFF"
        echo
        ok "incognito policy restored to disabled"
        echo "         this instance stays incognito for its lifetime"
    fi

    if [ "$cookies" = allow ]; then
        set_cookie_policy true
        echo
        ok "cookie policy restored to blocking"
        echo "         this browser keeps them until you quit it"
    fi

    if [ "$want" = allow ]; then
        set_webrtc block
        echo
        warn "on-disk policy restored to block"
        warn "THIS browser keeps direct UDP until you quit it - any page in it"
        warn "can read your real address. The next launch is protected again."
        echo "         caveat: if the browser re-reads policy mid-session it"
        echo "         may pick up the restored block and drop WebRTC."
    fi

    echo
    bold "applied at this launch"
    [ "$exit_kind" = upstream ] && warn "exit: upstream only - NOT the pinned address" \
                                || ok "exit: the pinned address"
    [ "$exit_kind" = upstream ] && ok "incognito: forced" \
                                || ok "incognito: unavailable in this browser"
    [ "$cookies" = block ] && ok "third-party cookies: blocked" \
                           || bad "third-party cookies: ALLOWED - cross-site linking possible"
    if [ "$want" = block ]; then
        ok "webrtc: BLOCKED"
    else
        bad "webrtc: ALLOWED - real address exposed to any page in this browser"
    fi
    if [ -n "$tz" ]; then
        ok "timezone: $tz"
        echo "         confirm with vpnchain-dashboard.html - it measures the"
        echo "         main thread, a Worker and an iframe, which is what"
        echo "         distinguishes a real spoof from a cosmetic one"
    else
        warn "timezone: system default"
    fi
}


# Rendering what the env file describes and diffing it is the one check the
# status server deliberately does not do - a second copy of the generator
# there would be two things to hold in sync. So it lives with the command that
# owns the generated file.
cmd_config_check() {
    if ! have_wg_creds; then
        bad "env file lacks the WireGuard values, so there is nothing to compare"
        exit 1
    fi
    if [ ! -f "$SINGBOX_CONFIG" ]; then
        bad "no config at $SINGBOX_CONFIG - generate one with: vpnchain config"
        exit 1
    fi
    local mode tmpcfg
    mode=$(singbox_mode)
    [ "$mode" = unknown ] && mode=chained
    tmpcfg=$(mktemp -t vpnchain-cfg)
    if ! generate_config "$tmpcfg" "$mode" 2>/dev/null; then
        rm -f "$tmpcfg"
        bad "could not render the config implied by the env file"
        exit 1
    fi
    if diff -q "$tmpcfg" "$SINGBOX_CONFIG" >/dev/null 2>&1; then
        ok "live config matches the env file"
    else
        warn "live config differs from what the env file describes"
        echo "         either it was hand-edited, or the env file changed"
        echo "         since it was generated. Regenerate with:"
        echo "           vpnchain config   (backs the current one up first)"
    fi
    rm -f "$tmpcfg"
}

case "${1:-status}" in
    start)   maybe_switch_mode "${2:-}"; cmd_start; wait_for_chain ;;
    stop)    cmd_stop ;;
             # switch_mode, not maybe_switch_mode: this verb restarts the agent
             # itself, so reloading inside the switch would do it twice.
    restart) if [ -n "${2:-}" ]; then switch_mode "$2" || true; fi
             cmd_stop; cmd_start; echo; wait_for_chain ;;
    browser) shift; cmd_browser "$@" ;;
    config)  [ "${2:-}" = check ] && cmd_config_check || cmd_config ;;
    blocklist) cmd_blocklist ;;
    *)
        echo "usage: vpnchain {start|restart} [chained|direct]"
        echo "       vpnchain stop"
        echo "       vpnchain browser [incognito|with-webrtc] [with-cookies]"
        echo "       vpnchain config [check]"
        echo "       vpnchain blocklist"
        exit 1
        ;;
esac
