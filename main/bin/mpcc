#!/usr/bin/env zsh
# mpcc - mpd client built on mpc, fzf and the zsh completion system.
#
# Scheduling (the "up next" block)
#
#   mpd's queue is one flat list with a cursor in it, so there is no up-next.
#   mpcc makes one out of two things mpd does have: scheduled songs sit
#   immediately after the current song, and they carry a non-zero priority.
#
#     position  gives the order when playing in sequence
#     priority  gives the order when random mode is on
#     and mpd clears the priority as soon as a song starts playing, so the
#     block drains itself as you listen - nothing to clean up
#
#   next and prev honour it in both modes, because the block is what comes next
#   by either measure.
#
# Naming a song: zsh completion and fzf, and they compose.
#
#   mpcc then Birds<TAB>     complete from the database, inline
#   mpcc then                browse and multi-select in fzf
#   mpcc then zaz            hand "zaz" to fzf as its initial filter, so a
#                            single match is taken without prompting
#
# Commands
#
#   (none) | status | list [n]   status, the up-next block and the queue
#   sched                        just the up-next block
#
#   then   [artist|all] [query]  schedule after everything already scheduled
#   next   [artist|all] <query>  schedule to play next, ahead of the block
#   next                         skip to the next song
#   next - [artist|all] [query]  browse in fzf, then schedule to play next
#   push   [query]               schedule a song already in the queue
#   add    [artist|all] [query]  append to the far end, not scheduled
#
#   play   [n|query]             resume, play position n, or pick from queue
#   prev | toggle | pause | stop | shuffle | clear
#   remove [query]               drop songs from the queue
#   <anything else>              passed straight to mpc
#
# MPCC_SLICE sets how many queue lines the status view shows.  See _mpcc for
# the completions.

emulate -L zsh
setopt extended_glob pipe_fail

local -r GREEN=$'\e[32m' RED=$'\e[31m' CYAN=$'\e[36m' DIM=$'\e[2m' RESET=$'\e[0m'
local -ri SLICE=${MPCC_SLICE:-20}
local -r TAB=$'\t'
# mpd takes priorities 0-255, 0 meaning "not scheduled".  Counting down from
# the top keeps priority order and position order pointing the same way.
local -ri PRIO_TOP=255

die () { print -u2 -- "mpcc: $*"; exit 1 }

(( $+commands[mpc] )) || die "mpc not found"
(( $+commands[fzf] )) || die "fzf not found"
mpc version &>/dev/null || die "cannot reach mpd on ${MPD_HOST:-localhost}:${MPD_PORT:-6600}"

# --- plumbing ---

# $COLUMNS is unset in a script, and the old mpcc asked tmux, which made it die
# outside tmux.
width () {
	local -i w=${COLUMNS:-0}
	(( w )) || w=$(tput cols 2>/dev/null) || w=80
	print -- $(( w > 20 ? w : 80 ))
}

clip () {
	local -i w=$(width)
	local line
	for line in "$@"; do
		if (( ${(m)#line} > w )); then
			print -r -- "${line[1,w-3]} .."
		else
			print -r -- "$line"
		fi
	done
}

# Pick from a "key<TAB>label" list on stdin, print the keys chosen.  Honours
# FZF_DEFAULT_OPTS (which already sets -m -1 --ansi --tiebreak=...) and splits
# the pane inside tmux, like the old mpcc did.
pick () {
	local prompt="$1" query="$2"
	local -a fzf
	if [[ -n ${TMUX-} ]] && (( $+commands[fzf-tmux] )); then
		fzf=(fzf-tmux -d 80%)
	else
		fzf=(fzf)
	fi
	# --with-nth hides the key and is also what fzf searches; adding --nth on
	# top would index the *transformed* line and match nothing.
	"${fzf[@]}" --exit-0 --bind=ctrl-a:toggle-all \
		--prompt="${prompt} " --delimiter='\t' --with-nth=2.. \
		${query:+--query=$query} | cut -d"$TAB" -f1
}

# Every song in the database as "uri<TAB>artist - title".  `mpc listall` prints
# bare URIs and ignores --format, hence the match-everything search.
library () {
	mpc -f "%file%${TAB}%artist% — %title%" search filename ''
}

queue () {
	mpc -f "%position%${TAB}%artist% — %title%" playlist
}

queue_len () {
	mpc -f '%position%' playlist | tail -1
}

# Position of the current song, 0 when stopped.
current_pos () {
	local p; p=$(mpc -f '%position%' current 2>/dev/null)
	print -- ${p:-0}
}

# --- the up-next block ---

# Positions of scheduled songs, in queue order.
sched_positions () {
	mpc --with-prio -f '%position%' playlist 2>/dev/null
}

# Where the block ends: the last scheduled position after the current song, or
# the current song itself when nothing is scheduled.
sched_end () {
	local -i cur=$(current_pos) last=0 p
	for p in $(sched_positions); do
		(( p > cur && p > last )) && last=$p
	done
	(( last )) || last=$cur
	print -- $last
}

# Renumber the block so priority order matches position order again.
reprioritise () {
	local -a pos
	pos=( ${(f)"$(sched_positions)"} )
	local -i i prio
	for (( i = 1; i <= $#pos; i++ )); do
		prio=$(( PRIO_TOP - i ))
		(( prio < 1 )) && prio=1
		mpc prio $prio $pos[i] >/dev/null
	done
}

# Move the queue entry at $1 to position $2 and mark it scheduled.
schedule_at () {
	local -i from="$1" to="$2"
	(( to < 1 )) && to=1
	(( from == to )) || mpc move $from $to >/dev/null
	mpc prio $(( PRIO_TOP - 1 )) $to >/dev/null
}

# --- views ---

# mpc status prints the song, a transport line and an options line, and adds an
# ERROR line when something is wrong - which of those are present depends on
# the state, so pick them out by shape rather than by position.
status_tail () {
	local -a kinds=( "$@" )
	local -a st
	st=( ${(f)"$(mpc status 2>/dev/null)"} )
	local line
	for line in $st; do
		case $line in
			(\[*)      (( $kinds[(I)transport] )) && print -- "$line" ;;
			(volume:*) (( $kinds[(I)options] ))   && print -- "${DIM}${line}${RESET}" ;;
			(ERROR:*)  (( $kinds[(I)error] ))     && print -- "${RED}${line}${RESET}" ;;
		esac
	done
	return 0
}

now () {
	local song
	song=$(mpc -f "%artist% — %title%" current 2>/dev/null)
	if [[ -n $song ]]; then
		clip "${GREEN}${song}${RESET}"
	else
		print -- "${DIM}stopped${RESET}"
	fi
	status_tail transport error
}

# Status with the queue around the current song.  Upcoming songs are printed
# above the current one, so what is playing stays next to the prompt; scheduled
# songs are marked in the gutter.
#
# $1 is how many queue entries to show (default $SLICE).  The window keeps a
# quarter of itself on songs already played - those end up at the bottom,
# nearest the prompt - and slides rather than shrinks at either end of the
# queue, so the view is the same height wherever the cursor happens to be.
show () {
	local -i rows=${1:-$SLICE}
	local -a lines
	lines=( ${(f)"$(mpc -f "%position%${TAB}%prio%${TAB}%artist% — %title%" playlist)"} )
	(( $#lines )) || {
		print -- "${DIM}queue is empty${RESET}"
		status_tail options error
		return 0
	}

	local -i total=$#lines
	(( rows > total )) && rows=$total
	(( rows < 1 )) && rows=1

	local -i cur=$(current_pos)
	local -i back=$(( rows / 4 ))
	local -i from to
	if (( cur )); then
		from=$(( cur - back ))
	else
		from=1
	fi
	to=$(( from + rows - 1 ))
	(( to > total )) && { to=total; from=$(( to - rows + 1 )) }
	(( from < 1 )) && { from=1; to=$(( from + rows - 1 )) }

	local -i i
	local pos prio label gutter
	for (( i = to; i >= from; i-- )); do
		pos=${lines[i]%%$TAB*}
		prio=${${lines[i]#*$TAB}%%$TAB*}
		label=${lines[i]##*$TAB}
		(( prio )) && gutter="${CYAN}»${RESET}" || gutter=' '
		if (( i == cur )); then
			clip "${GREEN}${(l:3:)pos} ▸ ${label}${RESET}"
		else
			clip "${(l:3:)pos} ${gutter} ${label}"
		fi
	done

	# Separate the queue from the status block below it.
	print
	status_tail transport options error
}

sched () {
	local -a lines
	lines=( ${(f)"$(mpc --with-prio -f "%position%${TAB}%artist% — %title%" playlist)"} )
	(( $#lines )) || { print -- "${DIM}nothing scheduled${RESET}"; return 0 }
	local line
	for line in $lines; do
		clip "${(l:3:)${line%%$TAB*}} ${CYAN}»${RESET} ${line#*$TAB}"
	done
}

# --- choosing songs ---

# "artist <query>" picks from the artist list and takes everything they have,
# "all" takes the whole library, anything else picks songs.  Prints URIs.
choose () {
	local prompt="$1"; shift
	local mode=song
	case "${1-}" in
		(artist) mode=artist; shift ;;
		(all)    mode=all;    shift ;;
	esac
	local query="$*"

	case $mode in
		(all)
			library | cut -d"$TAB" -f1
			;;
		(artist)
			local -a artists picked
			artists=( ${(f)"$(mpc list artist | awk -v t="$TAB" '{ print $0 t $0 }')"} )
			picked=( ${(f)"$(print -rl -- $artists | pick "artist>" "$query")"} )
			local a
			for a in $picked; do
				mpc -f '%file%' find artist "$a"
			done
			;;
		(song)
			library | pick "$prompt" "$query"
			;;
	esac
}

# --- commands ---

# where: front (play next) | back (after what is scheduled) | end (unscheduled)
put () {
	local where="$1"; shift
	local prompt="$1"; shift
	local -a uris
	uris=( ${(f)"$(choose "$prompt" "$@")"} )
	(( $#uris )) || return 0

	if [[ $where == end ]]; then
		print -rl -- $uris | mpc add >/dev/null
		print -- "added $#uris song(s) to the end of the queue"
		show
		return 0
	fi

	local -i cur=$(current_pos)
	local -i target
	if [[ $where == front ]]; then
		target=$(( cur + 1 ))
	else
		target=$(( $(sched_end) + 1 ))
	fi

	# Append, then move into place: mpc insert can only land right after the
	# current song, which is not where the back of the block is.
	local uri
	local -i len
	for uri in $uris; do
		len=$(queue_len)
		print -r -- "$uri" | mpc add >/dev/null
		schedule_at $(( len + 1 )) $target
		(( target++ ))
	done
	reprioritise

	print -- "scheduled $#uris song(s) ${where:s/front/to play next/:s/back/after the block/}"
	show
}

# Schedule songs that are already in the queue.
push () {
	local -a picked
	picked=( ${(f)"$(queue | pick "push>" "$*")"} )
	(( $#picked )) || return 0

	# Positions shift with every move, so remember the songs by uri.
	local -a uris
	local p
	for p in $picked; do
		uris+=( "$(mpc -f '%file%' playlist | sed -n "${p}p")" )
	done

	local -i target=$(( $(sched_end) + 1 )) pos cur
	local uri
	for uri in $uris; do
		cur=$(current_pos)
		pos=$(mpc -f '%file%' playlist | grep -n -x -F -- "$uri" | head -1 | cut -d: -f1)
		(( pos )) || continue
		# Removing a song from before the current one shifts everything after
		# it left by one, and mpd applies <to> to the queue after the removal.
		(( pos < target )) && (( target-- ))
		schedule_at $pos $target
		(( target++ ))
	done
	reprioritise
	print -- "scheduled $#uris song(s) already in the queue"
	show
}

remove () {
	local -a picked
	picked=( ${(f)"$(queue | pick "remove>" "$*")"} )
	(( $#picked )) || return 0
	# Delete from the back so earlier positions stay valid.
	local p
	for p in ${(On)picked}; do
		mpc del $p >/dev/null
	done
	print -- "removed $#picked song(s)"
	show
}

play () {
	if (( ! $# )); then
		mpc play >/dev/null
	elif [[ $1 == <-> ]]; then
		mpc play $1 >/dev/null
	else
		local pos
		pos=$(queue | pick "play>" "$*" | head -1)
		[[ -n $pos ]] || return 0
		mpc play $pos >/dev/null
	fi
	now
}

# --- dispatch ---

local cmd="${1-}"
(( $# )) && shift

case $cmd in
	(''|status)      show ;;
	(list)           show "$@" ;;
	(sched|scheduled) sched ;;

	(then)           put back  'then>' "$@" ;;
	(insert)         put front 'next>' "$@" ;;
	(add)            put end   'add>'  "$@" ;;
	(next)
		if (( ! $# )); then
			mpc next >/dev/null; now
		elif [[ $1 == - ]]; then
			shift; put front 'next>' "$@"
		else
			put front 'next>' "$@"
		fi ;;

	(push)           push "$@" ;;
	(remove|rm)      remove "$@" ;;
	(play)           play "$@" ;;
	(prev)           mpc prev >/dev/null; now ;;
	(toggle|pause)   mpc $cmd >/dev/null; now ;;
	(stop)           mpc stop >/dev/null; now ;;
	(shuffle)        mpc shuffle >/dev/null; show ;;
	(clear)          mpc clear >/dev/null; print -- "queue cleared" ;;

	(help|-h|--help)
		# The header comment above is the help text.
		local -a doc
		doc=( ${(f)"$(<${0:A})"} )
		local -i i
		for (( i = 2; i <= $#doc; i++ )); do
			[[ $doc[i] == \#* ]] || break
			print -r -- "${${doc[i]#\#}# }"
		done ;;

	(*)              exec mpc $cmd "$@" ;;
esac
