#!/usr/bin/env python3
"""Serve the vpnchain dashboard together with the host-side status it cannot
measure for itself.

The page running in a browser can only observe what that browser's own traffic
reveals. Process state, listening ports, the active mode and the OTHER exit are
all out of its reach. This serves both halves from one origin.

SECURITY - the three properties that make this safe, in order of importance:

  1. Strictly read-only. No endpoint performs an action. An endpoint that
     launched browsers or restarted agents would be a genuine local privilege
     escalation surface, because CORS prevents a malicious page from READING a
     response but not from SENDING the request. Nothing here acts, so a request
     forged by another page accomplishes nothing.

  2. No CORS headers, ever. The dashboard is served from this same origin, so
     it needs none. Adding "Access-Control-Allow-Origin: *" would let any site
     you visit read your exit address and chain state.

  3. Bound to loopback, and the real address is deliberately NOT reported.
     Nothing here needs it, and not collecting it means it cannot leak.

Config drift against the env file stays a CLI concern: checking it means
rendering the generated config, and keeping a second copy of the generator
here would be two things to hold in sync.
"""

import datetime
import json
import os
import platform
import plistlib
import shlex
import re
import socket
import subprocess
import sys
import threading
import time
from concurrent.futures import ThreadPoolExecutor
from http.server import BaseHTTPRequestHandler, HTTPServer

HERE = os.path.dirname(os.path.abspath(__file__))
PAGE = os.path.join(HERE, "vpnchain-dashboard.html")
CONFIG = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
    "vpnchain", "env")

CACHE_TTL = 15          # exits need a request each; do not re-measure per reload
PROBE_URL = "https://api.ipify.org"

# The few facts read differently on Linux: agents are systemd user units, the
# browser's policies a JSON file rather than a preference domain, and the
# system proxy GNOME's rather than the network configuration's.
LINUX = platform.system() == "Linux"


def read_env(path):
    """Shell-style KEY=VALUE, which is what the env file is."""
    out = {}
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, _, v = line.partition("=")
                v = v.strip().strip('"').strip("'")
                # The env file is SOURCED by the shell script, so writing a
                # path as $HOME/... is correct there and arrives here as a
                # literal. Expanding both forms keeps the two readers agreeing;
                # without it a perfectly good path silently reads as absent,
                # which the dashboard would report as "no list installed".
                out[k.strip()] = os.path.expanduser(os.path.expandvars(v))
    except OSError:
        pass
    return out


# Re-read per measurement rather than once at import. Read at import, a change
# to the env file - a new expected address, a different port - would be
# invisible until the daemon was restarted, and the dashboard would go on
# confidently comparing against a stale expectation. The file is small and a
# measurement already costs two network round trips.
ENV = {}


def refresh_env():
    global ENV
    ENV = read_env(CONFIG)


def env(name, default=None):
    return ENV.get(name, default)


def port_open(host, port, timeout=1.0):
    try:
        with socket.create_connection((host, int(port)), timeout):
            return True
    except OSError:
        return False


def run(cmd, timeout=20):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.stdout.strip()
    except Exception:
        return ""


def process_info(pattern):
    pid = run(["pgrep", "-f", pattern]).split("\n")[0].strip()
    if not pid:
        return {"running": False}
    started = run(["ps", "-o", "lstart=", "-p", pid])
    return {"running": True, "pid": int(pid),
            "since": re.sub(r"\s+", " ", started) or None}


def exit_through(port):
    """The address a request leaving by this inbound presents."""
    out = run(["curl", "-s", "-m", "12", "--socks5-hostname",
               "%s:%s" % (env("PROXY_HOST", "127.0.0.1"), port), PROBE_URL])
    return out if re.match(r"^[0-9a-fA-F:.]+$", out or "") else None


def singbox_config_path():
    return env("SINGBOX_CONFIG",
               os.path.expanduser("~/.config/sing-box/config.json"))


def hidden_services():
    """Whether .onion and .i2p can actually go anywhere.

    Three things fail here and all three look identical from a browser - the
    request simply does not complete. The port can be missing from the env
    file, in which case the generated config has no rule for the suffix and
    the name was never going anywhere. The rule can be absent from the LIVE
    config even though the port is set, which is the state between editing
    the env file and running 'vpnchain config && vpnchain restart'. Or the
    daemon can be down, which for i2pd is the normal resting state since it
    is started on demand.

    Reported as three fields rather than one verdict, because the fix is
    different in each case."""
    try:
        with open(singbox_config_path()) as f:
            live = f.read()
    except OSError:
        live = ""

    out = {}
    for name, var, suffix in (("tor", "TOR_PORT", ".onion"),
                              ("i2p", "I2P_PORT", ".i2p")):
        port = env(var)
        out[name] = {
            "suffix": suffix,
            # The daemons are local to this machine, never on PROXY_HOST:
            # they are what the chain hands these names off to.
            "port": int(port) if port else None,
            "listening": port_open("127.0.0.1", port) if port else False,
            "routed": ('"%s"' % suffix) in live,
        }
    return out


def blocklist():
    """Tracker rejection happens in the chain, so this is one of the few facts
    the dashboard genuinely cannot measure for itself: a blocked request looks
    to a page exactly like a network failure, which is the property that makes
    the approach unattributable in the first place.

    'referenced' is the one that matters. A list can be installed and current
    while the live config still predates it, in which case nothing is being
    blocked - and from inside the browser that is indistinguishable from a list
    that simply does not match much."""
    path = env("BLOCKLIST_PATH",
               os.path.expanduser("~/.config/sing-box/blocklist.srs"))
    configured = bool(env("BLOCKLIST_URL"))
    try:
        st = os.stat(path)
    except OSError:
        return {"configured": configured, "present": False, "referenced": False}
    referenced = False
    try:
        with open(singbox_config_path()) as f:
            referenced = path in f.read()
    except OSError:
        pass
    return {"configured": configured, "present": True,
            "bytes": st.st_size, "updatedAt": int(st.st_mtime),
            "referenced": referenced, "active": referenced and configured}


# How much of the sing-box log to read back. It logs every connection at info
# level, so this is roughly the last hour or two of browsing; the log itself is
# only trimmed when the chain stops.
BLOCKED_TAIL = 4 * 1024 * 1024
BLOCKED_SHOWN = 50

_ANSI = re.compile(r"\x1b\[[0-9;]*m")
_LOG_LINE = re.compile(
    r"^(?P<ts>[+-]\d{4} \d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}) (?P<level>[A-Z]+) "
    r"\[(?P<id>\d+) [^\]]*\] (?P<who>\S+): (?P<msg>.*)$")
_INBOUND_TO = re.compile(r"^inbound connection to (?P<host>.+):\d+$")
_INBOUND_TAG = re.compile(r"\[(?P<tag>[^\]]+)\]$")
# Friendlier names for the two inbounds the generated config defines.
_INBOUND_NAMES = {"pinned-in": "pinned", "upstream-in": "incognito"}

# host -> matched, valid for one version of the blocklist file.
_match_cache = {"key": None, "hosts": {}}


def singbox_agent():
    """The sing-box agent: its binary and its log. Read from the plist or the
    unit, as the CLI's log trimming does, so both follow the agent if it moves
    - an agent's PATH would not find a Homebrew sing-box by name anyway."""
    label = env("SINGBOX_AGENT")
    if not label:
        return None, None
    if LINUX:
        return _unit_agent(label)
    try:
        with open(os.path.expanduser(
                "~/Library/LaunchAgents/%s.plist" % label), "rb") as f:
            pl = plistlib.load(f)
    except Exception:
        return None, None
    args = pl.get("ProgramArguments") or []
    return (args[0] if args else None,
            pl.get("StandardErrorPath") or pl.get("StandardOutPath"))


def _unit_agent(label):
    unit = os.path.join(os.environ.get("XDG_CONFIG_HOME",
                                       os.path.expanduser("~/.config")),
                        "systemd", "user", label + ".service")
    binary = log = out = None
    try:
        with open(unit) as f:
            for line in f:
                key, _, value = line.strip().partition("=")
                if key == "ExecStart" and value:
                    binary = shlex.split(value)[0]
                elif key in ("StandardError", "StandardOutput") \
                        and value.startswith("append:"):
                    if key == "StandardError":
                        log = value[len("append:"):]
                    else:
                        out = value[len("append:"):]
    except (OSError, ValueError):
        return None, None
    return binary, log or out


def blocked_recent():
    """Hosts the tracker list rejected recently.

    A rejected request looks to the page exactly like a network failure - the
    browser shows ERR_SOCKS_CONNECTION_FAILED or the like - which is what makes
    blocking unattributable, and also what makes a blocked LINK puzzling. This
    is the place to look it up, out of reach of any site: same origin and Host
    checks as everything else here. It does say which trackers were contacted,
    which hints at what was browsed - one more reason those checks matter.

    sing-box logs no rejection at info level. A rejected connection is one that
    was accepted and never went anywhere: an "inbound connection to" line with
    no "outbound connection to" or error after it. A connection still being set
    up looks the same for a moment, so every candidate is confirmed against the
    list itself with 'sing-box rule-set match'.

    Hosts only: the proxy sees the name the browser asked for, never the path,
    so the target hidden in a click-tracking link is not recoverable here."""
    binary, log = singbox_agent()
    path = env("BLOCKLIST_PATH",
               os.path.expanduser("~/.config/sing-box/blocklist.srs"))
    if not binary or not log or not os.path.exists(path):
        return {"available": False}
    try:
        with open(log, "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - BLOCKED_TAIL))
            text = f.read().decode("utf-8", "replace")
    except OSError:
        return {"available": False}

    pending = {}            # id -> (time, host, inbound)
    since = None
    for line in text.splitlines():
        m = _LOG_LINE.match(_ANSI.sub("", line))
        if not m:
            continue
        if since is None:
            since = m.group("ts")
        cid, msg = m.group("id"), m.group("msg")
        to = _INBOUND_TO.match(msg)
        if to:
            tag = _INBOUND_TAG.search(m.group("who"))
            tag = tag.group("tag") if tag else ""
            pending[cid] = (m.group("ts"), to.group("host"),
                            _INBOUND_NAMES.get(tag, tag))
        elif msg.startswith("outbound connection to") or m.group("level") == "ERROR":
            pending.pop(cid, None)

    st = os.stat(path)
    key = (path, st.st_mtime, st.st_size)
    if _match_cache["key"] != key:
        _match_cache.update(key=key, hosts={})
    known = _match_cache["hosts"]

    def matches(host):
        # Exit status is 0 either way; a match is reported as text on stderr.
        try:
            p = subprocess.run([binary, "rule-set", "match", "-f", "binary",
                                path, host], capture_output=True, text=True,
                               timeout=10)
        except Exception:
            return None
        return bool((p.stdout + p.stderr).strip())

    fresh = sorted({h for _, h, _ in pending.values()} - set(known))
    with ThreadPoolExecutor(8) as pool:
        for host, hit in zip(fresh, pool.map(matches, fresh)):
            if hit is not None:
                known[host] = hit

    hosts = {}
    for ts, host, inbound in pending.values():
        if not known.get(host):
            continue
        h = hosts.setdefault(host, {"host": host, "count": 0, "last": None,
                                    "inbounds": []})
        h["count"] += 1
        when = _epoch(ts)
        if when and (h["last"] is None or when > h["last"]):
            h["last"] = when
        if inbound and inbound not in h["inbounds"]:
            h["inbounds"].append(inbound)
    shown = sorted(hosts.values(), key=lambda h: h["last"] or 0, reverse=True)
    return {"available": True, "since": _epoch(since) if since else None,
            "hostsTotal": len(shown),
            "requestsTotal": sum(h["count"] for h in shown),
            "hosts": shown[:BLOCKED_SHOWN]}


def _epoch(ts):
    try:
        return int(datetime.datetime.strptime(
            ts, "%z %Y-%m-%d %H:%M:%S").timestamp())
    except ValueError:
        return None


def singbox_mode():
    try:
        with open(singbox_config_path()) as f:
            cfg = json.load(f)
    except Exception:
        return None
    wg = next((e for e in cfg.get("endpoints", [])
               if e.get("type") == "wireguard"), None)
    if wg is None:
        return None
    return "chained" if wg.get("detour") else "direct"


def system_proxy():
    if LINUX:
        # GNOME's, which is what most applications on a desktop follow. Its
        # absence (no gsettings, another desktop) reads as "not set".
        mode = run(["gsettings", "get", "org.gnome.system.proxy", "mode"], timeout=5)
        if mode.strip("'") != "manual":
            return {"set": False}
        host = run(["gsettings", "get", "org.gnome.system.proxy.socks", "host"],
                   timeout=5).strip("'")
        port = run(["gsettings", "get", "org.gnome.system.proxy.socks", "port"],
                   timeout=5)
        if not host:
            return {"set": False}
        return {"set": True, "host": host,
                "port": int(port) if port.isdigit() else None}
    out = run(["scutil", "--proxy"])
    enabled = re.search(r"SOCKSEnable\s*:\s*(\d+)", out)
    if not enabled or enabled.group(1) != "1":
        return {"set": False}
    host = re.search(r"SOCKSProxy\s*:\s*(\S+)", out)
    port = re.search(r"SOCKSPort\s*:\s*(\d+)", out)
    return {"set": True,
            "host": host.group(1) if host else None,
            "port": int(port.group(1)) if port else None}


def browser_policy():
    """Configured, not measured. Policies are read at browser startup, so this
    says what the NEXT launch gets - the dashboard measures what the current
    one actually does, which is a different question."""
    dom = env("BROWSER_DOMAIN", "com.google.Chrome")
    policies = None
    if LINUX:
        try:
            with open(env("BROWSER_POLICY_FILE",
                          "/etc/opt/chrome/policies/managed/vpnchain.json")) as f:
                policies = json.load(f)
        except (OSError, ValueError):
            policies = {}

    def read(key):
        """As defaults prints it: bools as 1/0, arrays one entry per line."""
        if policies is not None:
            v = policies.get(key)
            if v is None:
                return None
            if isinstance(v, bool):
                return "1" if v else "0"
            if isinstance(v, list):
                return "\n".join('"%s"' % x for x in v)
            return str(v)
        out = run(["defaults", "read", dom, key], timeout=5)
        return out if out else None

    webrtc = read("WebRtcIPHandling") or read("WebRtcIPHandlingPolicy")
    incog = read("IncognitoModeAvailability")
    cookies = read("BlockThirdPartyCookies")

    device_keys = ["DefaultWebUsbGuardSetting", "DefaultWebBluetoothGuardSetting",
                   "DefaultSerialGuardSetting", "DefaultWebHidGuardSetting",
                   "DefaultLocalFontsSetting", "DefaultWindowManagementSetting",
                   "DefaultSensorsSetting", "DefaultDirectSocketsSetting"]
    denied = sum(1 for k in device_keys if read(k) == "2")
    telemetry_off = (read("UrlKeyedAnonymizedDataCollectionEnabled") == "0"
                     and read("MetricsReportingEnabled") == "0")

    # Reported separately from the count above because the dashboard can
    # actually CHECK these two from inside the browser - queryLocalFonts and
    # getScreenDetails either exist and throw or do not exist. For the rest
    # the configured value is all anyone has.
    fonts_denied = read("DefaultLocalFontsSetting") == "2"
    screens_denied = read("DefaultWindowManagementSetting") == "2"

    ad_keys = ["PrivacySandboxAdTopicsEnabled",
               "PrivacySandboxSiteEnabledAdsEnabled",
               "PrivacySandboxAdMeasurementEnabled"]
    ad_off = sum(1 for k in ad_keys if read(k) == "0")
    return {
        "deviceApisDenied": denied,
        "deviceApisTotal": len(device_keys),
        "localFontsDenied": fonts_denied,
        "windowManagementDenied": screens_denied,
        "adPrivacyOff": ad_off,
        "adPrivacyTotal": len(ad_keys),
        "httpsOnly": read("HttpsOnlyMode"),
        "telemetryReduced": telemetry_off,
        "safeBrowsing": read("SafeBrowsingProtectionLevel"),
        "backgroundMode": read("BackgroundModeEnabled"),
        "downloadPrompt": read("PromptForDownloadLocation"),
        "notificationsBlocked": read("DefaultNotificationsSetting") == "2",
        # The value is a plist array; counting quoted entries is enough for a
        # summary and avoids dragging in a plist parser for one number.
        "notificationsAllowed": len(re.findall(
            r'"[^"]+"', read("NotificationsAllowedForUrls") or "")),
        "webrtc": webrtc,
        "webrtcBlocked": webrtc == "disable_non_proxied_udp",
        "incognito": incog,
        "incognitoDisabled": incog in ("1", "2"),
        "thirdPartyCookies": cookies,
        "thirdPartyCookiesBlocked": cookies == "1",
    }


def collect():
    refresh_env()
    host = env("PROXY_HOST", "127.0.0.1")
    pinned = env("PROXY_PORT", "1080")
    incog = env("INCOGNITO_PORT", "1081")
    up_host = env("UPSTREAM_HOST", "127.0.0.1")
    # No default, for the same reason UPSTREAM_PROCESS has none below: a port
    # identifies the upstream stack as surely as its process name does, and
    # this file is in a public repository. The env file always supplies it.
    up_port = env("UPSTREAM_PORT")

    pinned_up = port_open(host, pinned)
    incog_up = port_open(host, incog)

    real_address = env("REAL_ADDRESS")
    if real_address == "auto":
        real_address = None

    return {
        "mode": singbox_mode(),
        # No default: naming a particular upstream here would disclose the
        # stack in a public repo, and the env file always supplies it.
        "upstream": dict(process_info(env("UPSTREAM_PROCESS", "")) if env("UPSTREAM_PROCESS")
                         else {"running": None},
                         port=int(up_port) if up_port else None,
                         listening=port_open(up_host, up_port) if up_port else False),
        "singbox": dict(process_info("sing-box run"),
                        pinnedPort=int(pinned), pinnedListening=pinned_up,
                        incognitoPort=int(incog), incognitoListening=incog_up),
        "systemProxy": system_proxy(),
        "browserPolicy": browser_policy(),
        "blocklist": blocklist(),
        "blocked": blocked_recent(),
        "hidden": hidden_services(),
        "exits": {
            "expected": env("EXPECTED_EXIT_IP"),
            # Measured, not pattern-matched: the upstream exit rotates with the
            # node, so a prefix would go stale.
            "pinned": exit_through(pinned) if pinned_up else None,
            "incognito": exit_through(incog) if incog_up else None,
            # Configured, never measured. Learning it would mean making an
            # UNPROXIED request from this daemon, which is the one thing the
            # whole arrangement exists to avoid doing by accident. It is here
            # so the dashboard can recognise the failure that matters - a
            # browser launched without the proxy, browsing on the real
            # address - which it otherwise has nothing to compare against.
            #
            # "auto" means 'vpnchain browser' measures it per launch and
            # passes it in the page's fragment; it is a word, not an address,
            # and reporting it as one would have the page compare the exit
            # against the string "auto".
            "real": real_address,
        },
        "measuredAt": int(time.time()),
    }


_cache = {"at": 0, "data": None}
_lock = threading.Lock()


def cached():
    with _lock:
        if _cache["data"] and time.time() - _cache["at"] < CACHE_TTL:
            return _cache["data"]
    data = collect()
    with _lock:
        _cache.update(at=time.time(), data=data)
    return data


class Handler(BaseHTTPRequestHandler):
    server_version = "vpnchain-statusd"

    def log_message(self, *a):
        pass

    def _send(self, code, body, ctype):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        # Deliberately no Access-Control-Allow-Origin. The dashboard is served
        # from here, so it is same-origin; anything else must not read this.
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    # Any page can issue requests to 127.0.0.1 - the browsers here bypass the
    # proxy for loopback, which is how the dashboard reaches this server at
    # all - and DNS rebinding turns that from "can send" into "can read": the
    # attacker's own name is made to resolve here, so the reply is same-origin
    # to their page and its body is theirs. What this file hands out is the
    # pinned exit, the measured real address, ports, process names and the
    # browser policy.
    #
    # The Host header separates the two cases, because the browser sends the
    # name the page asked for rather than the address it resolved to. A
    # rebound request therefore arrives carrying the attacker's hostname.
    #
    # Both loopback names are allowed deliberately: the cookie probe is framed
    # from whichever of them the dashboard was NOT served from, which is what
    # makes that frame genuinely third-party and is the whole point of it.
    def _host_allowed(self):
        host = (self.headers.get("Host") or "").strip().lower()
        if not host:
            return False
        port = self.server.server_address[1]
        for name in ("127.0.0.1", "localhost", "[::1]"):
            if host == name or host == "%s:%d" % (name, port):
                return True
        return False

    def do_GET(self):
        if not self._host_allowed():
            # Named rather than silently dropped: the one person who will
            # ever see this is whoever reaches the server by a name nobody
            # anticipated, and they need to know what refused them.
            return self._send(403, b"vpnchain-statusd: this server answers "
                                   b"only to 127.0.0.1 and localhost\n",
                              "text/plain")
        path = self.path.split("?", 1)[0]
        if path in ("/", "/index.html"):
            try:
                with open(PAGE, "rb") as f:
                    return self._send(200, f.read(), "text/html; charset=utf-8")
            except OSError as e:
                return self._send(500, str(e).encode(), "text/plain")
        if path == "/cookie-probe":
            # Served so the dashboard can embed it from the OTHER loopback
            # name - 127.0.0.1 and localhost are different sites to the
            # browser, so this frame is genuinely third-party and can measure
            # whether unpartitioned cookie access is granted. Reading the
            # policy would only say what was configured.
            body = (b"<!doctype html><meta charset=utf-8><script>\n"
                    b"document.cookie='probe=1;SameSite=None;Secure;path=/';\n"
                    b"var readBack = document.cookie.indexOf('probe=1') !== -1;\n"
                    b"function send(granted){parent.postMessage(\n"
                    b"  {vpnchainCookieProbe:true,granted:granted,readBack:readBack},'*');}\n"
                    b"if (document.hasStorageAccess) {\n"
                    b"  document.hasStorageAccess().then(send).catch(function(){send(null);});\n"
                    b"} else { send(null); }\n</script>")
            return self._send(200, body, "text/html; charset=utf-8")
        if path == "/status.json":
            body = json.dumps(cached(), indent=2).encode()
            return self._send(200, body, "application/json")
        self._send(404, b"not found", "text/plain")


def main():
    refresh_env()
    host = "127.0.0.1"
    # The port is the one value a reload cannot pick up, since the socket is
    # already bound; changing it needs a restart either way.
    port = int(env("STATUS_PORT", "8787"))
    try:
        srv = HTTPServer((host, port), Handler)
    except OSError as e:
        print("vpnchain-statusd: cannot bind %s:%s - %s" % (host, port, e),
              file=sys.stderr)
        return 1
    print("vpnchain-statusd: http://%s:%s/" % (host, port), flush=True)
    srv.serve_forever()
    return 0


if __name__ == "__main__":
    sys.exit(main())
