#!/usr/bin/env python3
"""Serve the vpnchain dashboard together with the host-side status it cannot
measure for itself.

The page running in a browser can only observe what that browser's own traffic
reveals. Process state, listening ports, the active mode and the OTHER exit are
all out of its reach. This serves both halves from one origin.

SECURITY - the three properties that make this safe, in order of importance:

  1. Strictly read-only. No endpoint performs an action. An endpoint that
     launched browsers or restarted agents would be a genuine local privilege
     escalation surface, because CORS prevents a malicious page from READING a
     response but not from SENDING the request. Nothing here acts, so a request
     forged by another page accomplishes nothing.

  2. No CORS headers, ever. The dashboard is served from this same origin, so
     it needs none. Adding "Access-Control-Allow-Origin: *" would let any site
     you visit read your exit address and chain state.

  3. Bound to loopback, and the real address is deliberately NOT reported.
     Nothing here needs it, and not collecting it means it cannot leak.

Config drift against the env file stays a CLI concern: checking it means
rendering the generated config, and keeping a second copy of the generator
here would be two things to hold in sync.
"""

import json
import os
import re
import socket
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, HTTPServer

HERE = os.path.dirname(os.path.abspath(__file__))
PAGE = os.path.join(HERE, "vpnchain-dashboard.html")
CONFIG = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
    "vpnchain", "env")

CACHE_TTL = 15          # exits need a request each; do not re-measure per reload
PROBE_URL = "https://api.ipify.org"


def read_env(path):
    """Shell-style KEY=VALUE, which is what the env file is."""
    out = {}
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, _, v = line.partition("=")
                v = v.strip().strip('"').strip("'")
                # The env file is SOURCED by the shell script, so writing a
                # path as $HOME/... is correct there and arrives here as a
                # literal. Expanding both forms keeps the two readers agreeing;
                # without it a perfectly good path silently reads as absent,
                # which the dashboard would report as "no list installed".
                out[k.strip()] = os.path.expanduser(os.path.expandvars(v))
    except OSError:
        pass
    return out


# Re-read per measurement rather than once at import. Read at import, a change
# to the env file - a new expected address, a different port - would be
# invisible until the daemon was restarted, and the dashboard would go on
# confidently comparing against a stale expectation. The file is small and a
# measurement already costs two network round trips.
ENV = {}


def refresh_env():
    global ENV
    ENV = read_env(CONFIG)


def env(name, default=None):
    return ENV.get(name, default)


def port_open(host, port, timeout=1.0):
    try:
        with socket.create_connection((host, int(port)), timeout):
            return True
    except OSError:
        return False


def run(cmd, timeout=20):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.stdout.strip()
    except Exception:
        return ""


def process_info(pattern):
    pid = run(["pgrep", "-f", pattern]).split("\n")[0].strip()
    if not pid:
        return {"running": False}
    started = run(["ps", "-o", "lstart=", "-p", pid])
    return {"running": True, "pid": int(pid),
            "since": re.sub(r"\s+", " ", started) or None}


def exit_through(port):
    """The address a request leaving by this inbound presents."""
    out = run(["curl", "-s", "-m", "12", "--socks5-hostname",
               "%s:%s" % (env("PROXY_HOST", "127.0.0.1"), port), PROBE_URL])
    return out if re.match(r"^[0-9a-fA-F:.]+$", out or "") else None


def singbox_config_path():
    return env("SINGBOX_CONFIG",
               os.path.expanduser("~/.config/sing-box/config.json"))


def blocklist():
    """Tracker rejection happens in the chain, so this is one of the few facts
    the dashboard genuinely cannot measure for itself: a blocked request looks
    to a page exactly like a network failure, which is the property that makes
    the approach unattributable in the first place.

    'referenced' is the one that matters. A list can be installed and current
    while the live config still predates it, in which case nothing is being
    blocked - and from inside the browser that is indistinguishable from a list
    that simply does not match much."""
    path = env("BLOCKLIST_PATH",
               os.path.expanduser("~/.config/sing-box/blocklist.srs"))
    configured = bool(env("BLOCKLIST_URL"))
    try:
        st = os.stat(path)
    except OSError:
        return {"configured": configured, "present": False, "referenced": False}
    referenced = False
    try:
        with open(singbox_config_path()) as f:
            referenced = path in f.read()
    except OSError:
        pass
    return {"configured": configured, "present": True,
            "bytes": st.st_size, "updatedAt": int(st.st_mtime),
            "referenced": referenced, "active": referenced and configured}


def singbox_mode():
    try:
        with open(singbox_config_path()) as f:
            cfg = json.load(f)
    except Exception:
        return None
    wg = next((e for e in cfg.get("endpoints", [])
               if e.get("type") == "wireguard"), None)
    if wg is None:
        return None
    return "chained" if wg.get("detour") else "direct"


def system_proxy():
    out = run(["scutil", "--proxy"])
    enabled = re.search(r"SOCKSEnable\s*:\s*(\d+)", out)
    if not enabled or enabled.group(1) != "1":
        return {"set": False}
    host = re.search(r"SOCKSProxy\s*:\s*(\S+)", out)
    port = re.search(r"SOCKSPort\s*:\s*(\d+)", out)
    return {"set": True,
            "host": host.group(1) if host else None,
            "port": int(port.group(1)) if port else None}


def browser_policy():
    """Configured, not measured. Policies are read at browser startup, so this
    says what the NEXT launch gets - the dashboard measures what the current
    one actually does, which is a different question."""
    dom = env("BROWSER_DOMAIN", "com.google.Chrome")

    def read(key):
        out = run(["defaults", "read", dom, key], timeout=5)
        return out if out else None

    webrtc = read("WebRtcIPHandling") or read("WebRtcIPHandlingPolicy")
    incog = read("IncognitoModeAvailability")
    cookies = read("BlockThirdPartyCookies")

    device_keys = ["DefaultWebUsbGuardSetting", "DefaultWebBluetoothGuardSetting",
                   "DefaultSerialGuardSetting", "DefaultWebHidGuardSetting",
                   "DefaultLocalFontsSetting", "DefaultWindowManagementSetting",
                   "DefaultSensorsSetting", "DefaultDirectSocketsSetting"]
    denied = sum(1 for k in device_keys if read(k) == "2")
    telemetry_off = (read("UrlKeyedAnonymizedDataCollectionEnabled") == "0"
                     and read("MetricsReportingEnabled") == "0")

    # Reported separately from the count above because the dashboard can
    # actually CHECK these two from inside the browser - queryLocalFonts and
    # getScreenDetails either exist and throw or do not exist. For the rest
    # the configured value is all anyone has.
    fonts_denied = read("DefaultLocalFontsSetting") == "2"
    screens_denied = read("DefaultWindowManagementSetting") == "2"

    ad_keys = ["PrivacySandboxAdTopicsEnabled",
               "PrivacySandboxSiteEnabledAdsEnabled",
               "PrivacySandboxAdMeasurementEnabled"]
    ad_off = sum(1 for k in ad_keys if read(k) == "0")
    return {
        "deviceApisDenied": denied,
        "deviceApisTotal": len(device_keys),
        "localFontsDenied": fonts_denied,
        "windowManagementDenied": screens_denied,
        "adPrivacyOff": ad_off,
        "adPrivacyTotal": len(ad_keys),
        "httpsOnly": read("HttpsOnlyMode"),
        "telemetryReduced": telemetry_off,
        "safeBrowsing": read("SafeBrowsingProtectionLevel"),
        "backgroundMode": read("BackgroundModeEnabled"),
        "downloadPrompt": read("PromptForDownloadLocation"),
        "notificationsBlocked": read("DefaultNotificationsSetting") == "2",
        # The value is a plist array; counting quoted entries is enough for a
        # summary and avoids dragging in a plist parser for one number.
        "notificationsAllowed": len(re.findall(
            r'"[^"]+"', run(["defaults", "read", dom,
                             "NotificationsAllowedForUrls"], timeout=5) or "")),
        "webrtc": webrtc,
        "webrtcBlocked": webrtc == "disable_non_proxied_udp",
        "incognito": incog,
        "incognitoDisabled": incog in ("1", "2"),
        "thirdPartyCookies": cookies,
        "thirdPartyCookiesBlocked": cookies == "1",
    }


def collect():
    refresh_env()
    host = env("PROXY_HOST", "127.0.0.1")
    pinned = env("PROXY_PORT", "1080")
    incog = env("INCOGNITO_PORT", "1081")
    up_host = env("UPSTREAM_HOST", "127.0.0.1")
    # No default, for the same reason UPSTREAM_PROCESS has none below: a port
    # identifies the upstream stack as surely as its process name does, and
    # this file is in a public repository. The env file always supplies it.
    up_port = env("UPSTREAM_PORT")

    pinned_up = port_open(host, pinned)
    incog_up = port_open(host, incog)

    return {
        "mode": singbox_mode(),
        # No default: naming a particular upstream here would disclose the
        # stack in a public repo, and the env file always supplies it.
        "upstream": dict(process_info(env("UPSTREAM_PROCESS", "")) if env("UPSTREAM_PROCESS")
                         else {"running": None},
                         port=int(up_port) if up_port else None,
                         listening=port_open(up_host, up_port) if up_port else False),
        "singbox": dict(process_info("sing-box run"),
                        pinnedPort=int(pinned), pinnedListening=pinned_up,
                        incognitoPort=int(incog), incognitoListening=incog_up),
        "systemProxy": system_proxy(),
        "browserPolicy": browser_policy(),
        "blocklist": blocklist(),
        "exits": {
            "expected": env("EXPECTED_EXIT_IP"),
            # Measured, not pattern-matched: the upstream exit rotates with the
            # node, so a prefix would go stale.
            "pinned": exit_through(pinned) if pinned_up else None,
            "incognito": exit_through(incog) if incog_up else None,
        },
        "measuredAt": int(time.time()),
    }


_cache = {"at": 0, "data": None}
_lock = threading.Lock()


def cached():
    with _lock:
        if _cache["data"] and time.time() - _cache["at"] < CACHE_TTL:
            return _cache["data"]
    data = collect()
    with _lock:
        _cache.update(at=time.time(), data=data)
    return data


class Handler(BaseHTTPRequestHandler):
    server_version = "vpnchain-statusd"

    def log_message(self, *a):
        pass

    def _send(self, code, body, ctype):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        # Deliberately no Access-Control-Allow-Origin. The dashboard is served
        # from here, so it is same-origin; anything else must not read this.
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        path = self.path.split("?", 1)[0]
        if path in ("/", "/index.html"):
            try:
                with open(PAGE, "rb") as f:
                    return self._send(200, f.read(), "text/html; charset=utf-8")
            except OSError as e:
                return self._send(500, str(e).encode(), "text/plain")
        if path == "/cookie-probe":
            # Served so the dashboard can embed it from the OTHER loopback
            # name - 127.0.0.1 and localhost are different sites to the
            # browser, so this frame is genuinely third-party and can measure
            # whether unpartitioned cookie access is granted. Reading the
            # policy would only say what was configured.
            body = (b"<!doctype html><meta charset=utf-8><script>\n"
                    b"document.cookie='probe=1;SameSite=None;Secure;path=/';\n"
                    b"var readBack = document.cookie.indexOf('probe=1') !== -1;\n"
                    b"function send(granted){parent.postMessage(\n"
                    b"  {vpnchainCookieProbe:true,granted:granted,readBack:readBack},'*');}\n"
                    b"if (document.hasStorageAccess) {\n"
                    b"  document.hasStorageAccess().then(send).catch(function(){send(null);});\n"
                    b"} else { send(null); }\n</script>")
            return self._send(200, body, "text/html; charset=utf-8")
        if path == "/status.json":
            body = json.dumps(cached(), indent=2).encode()
            return self._send(200, body, "application/json")
        self._send(404, b"not found", "text/plain")


def main():
    refresh_env()
    host = "127.0.0.1"
    # The port is the one value a reload cannot pick up, since the socket is
    # already bound; changing it needs a restart either way.
    port = int(env("STATUS_PORT", "8787"))
    try:
        srv = HTTPServer((host, port), Handler)
    except OSError as e:
        print("vpnchain-statusd: cannot bind %s:%s - %s" % (host, port, e),
              file=sys.stderr)
        return 1
    print("vpnchain-statusd: http://%s:%s/" % (host, port), flush=True)
    srv.serve_forever()
    return 0


if __name__ == "__main__":
    sys.exit(main())
