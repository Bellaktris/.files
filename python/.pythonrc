# -*- coding: utf-8 -*-
# vim:filetype=python

"""Startup file for interactive python, loaded through PYTHONSTARTUP.

Hands the session to ptpython - vi mode, .ptpython/config.py, Ctrl-R through
fzf - when THIS interpreter can import it, and otherwise leaves the stock REPL
as it is. Either way pwd and clear() exist.

Nothing here touches sys.path for longer than the import of ptpython itself,
and nothing has a side effect in its repr: printing vars() or globals() must
never clear the screen or end the session.
"""

import os as _os
import sys as _sys


_CONFIG = _os.path.expanduser('~/.files/python/.ptpython/config.py')
_HISTORY = _os.path.join(
  _os.environ.get('XDG_STATE_HOME') or _os.path.expanduser('~/.local/state'),
  'ptpython', 'history')


class _Pwd(object):
  """Typing pwd shows the working directory, like the shell."""

  def __repr__(self):
    return _os.getcwd()

  def __call__(self):
    return _os.getcwd()


def clear():
  """Clear the screen (Ctrl-L does the same in ptpython)."""
  print('\033[2J\033[H', end='')


pwd = _Pwd()


def _ptpython_dirs():
  """site-packages of ptpython installs, this interpreter's version first.

  Another version's directory is still worth trying, since ptpython and its
  dependencies are pure Python - Homebrew builds its ptpython against one
  version while python3 may already be the next. It is only ever appended,
  so it cannot put its packages ahead of a venv's own.
  """
  import glob
  ver = 'python%d.%d' % _sys.version_info[:2]
  home = _os.path.expanduser('~')
  roots = [
    # Homebrew formula, on Apple silicon, Intel and Linux.
    '/opt/homebrew/opt/ptpython/libexec',
    '/usr/local/opt/ptpython/libexec',
    '/home/linuxbrew/.linuxbrew/opt/ptpython/libexec',
    # pipx and uv tool installs.
    home + '/.local/pipx/venvs/ptpython',
    home + '/.local/share/pipx/venvs/ptpython',
    home + '/.local/share/uv/tools/ptpython',
  ]
  found = []
  for root in roots:
    found += glob.glob(_os.path.join(root, 'lib', 'python3.*', 'site-packages'))
  found.sort(key=lambda d: _os.path.basename(_os.path.dirname(d)) != ver)
  return found


def _import_embed():
  try:
    from ptpython.repl import embed
    return embed
  except ImportError:
    pass
  for site in _ptpython_dirs():
    _sys.path.append(site)
    try:
      from ptpython.repl import embed
      return embed
    except Exception:
      # Built for an interpreter this one cannot run (newer syntax, a
      # compiled dependency): forget it, including half-imported modules.
      _sys.path.remove(site)
      for name in [m for m in _sys.modules
                   if m.split('.')[0] in ('ptpython', 'prompt_toolkit',
                                          'jedi', 'parso', 'pygments')]:
        del _sys.modules[name]
  return None


def _load_configure():
  """configure() from the config file, loaded by path rather than by putting
  its directory on sys.path, where it would shadow any project's config.py."""
  import importlib.util
  spec = importlib.util.spec_from_file_location('_ptpython_config', _CONFIG)
  module = importlib.util.module_from_spec(spec)
  # No __pycache__ inside the dotfiles.
  _sys.dont_write_bytecode, saved = True, _sys.dont_write_bytecode
  try:
    spec.loader.exec_module(module)
  finally:
    _sys.dont_write_bytecode = saved
  return module.configure


def _start():
  if not (_sys.stdin.isatty() and _sys.stdout.isatty()):
    return
  if 'IPython' in _sys.modules:
    return
  embed = _import_embed()
  if embed is None:
    print('\033[2mptpython is not installed for python%d.%d - '
          'pipx install ptpython\033[0m' % _sys.version_info[:2],
          file=_sys.stderr)
    return
  try:
    configure = _load_configure()
    _os.makedirs(_os.path.dirname(_HISTORY), exist_ok=True)
  except Exception as e:
    print('\033[33mptpython config failed (%s: %s), using the plain REPL'
          '\033[0m' % (type(e).__name__, e), file=_sys.stderr)
    return
  _sys.exit(embed(globals={'pwd': pwd, 'clear': clear},
                  configure=configure, history_filename=_HISTORY))


_start()
