[MESSAGES CONTROL]
# Pointless whinging
#   W0212 = Accessing protected attribute of client class
#   W0613 = Unused argument
#   R0903 = Too few public methods
#   C0301 = Line too long
#   R0913 = Too many arguments
#   C0103 = Invalid name
#   R0914 = Too many local variables
#   C0114/C0115/C0116 = Missing docstring (replaces old C0111)

# PyLint's module importation is unreliable
#   W0402 = Uses of a deprecated module

# Already an error when wildcard imports are used
#   W0611 = Unused import
#   W0614 = Unused import from wildcard

# Disable the message(s) with the mentioned id's.
disable=W0212,W0613,R0903,W0614,W0611,C0114,C0115,C0116,C0301,R0913,C0103,W0402,R0914


[TYPECHECK]
ignored-classes = numpy
ignored-modules = numpy,vapoursynth


[REPORTS]
# Set the output format. Available formats are
# text, parseable, colorized, msvs (visual studio) and html
output-format=text

# Tells whether to display a full report or only the messages
reports=no


[FORMAT]
# Two-space indentation throughout, as in the rest of these dotfiles.
indent-string='  '
